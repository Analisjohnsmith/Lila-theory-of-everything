\begin{equation}
U^\dagger U = I.
\end{equation}
\end{theorem}

\begin{proof}
Since $H$ is self-adjoint, $H^\dagger = H$. Then


\[
U^\dagger(t) = e^{+iHt},
\]


and


\[
U^\dagger U = e^{+iHt} e^{-iHt} = I.
\]


Thus evolution is unitary.
\end{proof}

