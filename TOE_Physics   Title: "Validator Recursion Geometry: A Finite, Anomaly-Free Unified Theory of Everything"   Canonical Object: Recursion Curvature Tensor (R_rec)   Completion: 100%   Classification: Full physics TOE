\sum_{\text{colors}} Y(Q_L) + Y(u_R) + Y(d_R) = 0.
\]


Similarly for $[SU(2)]^2 U(1)$ and $[U(1)]^3$. The recursion-stable
representation set is exactly the Standard Model one, known to be
anomaly-free. Gravitational anomalies cancel by the same hypercharge
sum. Thus all anomalies vanish.
\end{proof}

\section{Hamiltonian Boundedness}

\begin{theorem}[Bounded Hamiltonian]
The total Hamiltonian


\[
H = \int d^3x\,
(\mathcal{H}_{\text{matter}}
+ \mathcal{H}_{\text{gauge}}
+ \mathcal{H}_{\text{grav}}
+ \mathcal{H}_{\text{rec}})
\]


is bounded below:
\begin{equation}
H \ge 0.
\end{equation}
\end{theorem}

\begin{proof}
Matter: $V(\Psi)\ge 0$ and kinetic terms are quadratic and positive.
