\subsection{Matter Field Equation}

Varying with respect to $\Psi$ gives
\begin{equation}
\delta S_\Psi
=
\int d^4x\,\sqrt{-g}\left[
g^{\mu\nu}(D_\mu\delta\Psi)(D_\nu\Psi)
- V'(\Psi)\delta\Psi
\right].
\end{equation}

Integrating by parts yields the Euler--Lagrange equation:
\begin{equation}
D_\mu\left( g^{\mu\nu} D_\nu\Psi \right)
+ V'(\Psi)
= 0.
\end{equation}

Thus the unified matter field satisfies
\begin{equation}
\boxed{
D_\mu D^\mu \Psi + V'(\Psi) = 0.
}
\end{equation}

\subsection{Gauge Field Equations}

Varying with respect to $A_\mu^a$ gives
\begin{equation}
\delta S_A
=
\int d^4x\,\sqrt{-g}\left[
- \frac{1}{2} \mathrm{Tr}(F^{\mu\nu}\delta F_{\mu\nu})
+ J^{\mu}_a \delta A_\mu^a
\right],
\end{equation}
where
\begin{equation}
J^\mu_a = \frac{\partial \mathcal{L}}{\partial A_\mu^a}
\end{equation}
is the unified matter current.

Using
\begin{equation}
\delta F_{\mu\nu}^a = D_\mu \delta A_\nu^a - D_\nu \delta A_\mu^a,
\end{equation}
we obtain the Yang--Mills equation:
\begin{equation}
\boxed{
D_\mu F^{\mu\nu\,a} = J^{\nu\,a}.
}
\end{equation}

\subsection{Einstein Equation with Recursion Coupling}

Varying with respect to the spacetime metric $g_{\mu\nu}$ gives
\begin{equation}
\delta S
=
\int d^4x\,\sqrt{-g}\left[
\frac{1}{2} T^{\mu\nu} \delta g_{\mu\nu}
+ \alpha \left(
R_{\mathrm{rec}} \delta R_{\mathrm{geom}}
+ R_{\mathrm{geom}} \delta R_{\mathrm{rec}}
