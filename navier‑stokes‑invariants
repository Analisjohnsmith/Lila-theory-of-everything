# 2. ANALYSIS  (from zhaived_analysis.py -- streaming, conservative op)
# =====================================================================


def kinetic_energy(u):
    return np.sum(np.abs(u)**2)


def sobolev_Hs_norm(u_hat, s, N):
    L = 2 * np.pi
    k = np.fft.fftfreq(N, d=L/N) * 2*np.pi
    KX, KY, KZ = np.meshgrid(k, k, k, indexing="ij")
    k2 = KX**2 + KY**2 + KZ**2
    return np.sum((1 + k2)**s * np.abs(u_hat)**2)


def normalized(hs, N):
    return hs / ((N ** 3) * (2*np.pi)**3)


def power_law(t, E0, alpha):
    return E0 * t**(-alpha)


def Lp_norm(u, p, N):
    L = 2 * np.pi
    vol = (L / N) ** 3
    if p == np.inf:
        return max(np.max(np.abs(u[i])) for i in range(3))
    return (np.sum(np.abs(u)**p) * vol) ** (1.0 / p)


def spectral_nonlinear(u_hat, N):
    """Projected, dealiased N(u) = P[(u.grad)u], conservative form (what the
    solver steps), so the PDE residual measures the actual discretization."""
    k = np.fft.fftfreq(N, d=2*np.pi/N) * 2*np.pi
    KX, KY, KZ = np.meshgrid(k, k, k, indexing="ij")
    k2z = KX**2 + KY**2 + KZ**2
    k2z[0, 0, 0] = 1.0
    cutoff = N // 3
    deal = (np.abs(KX) > cutoff) | (np.abs(KY) > cutoff) | (np.abs(KZ) > cutoff)
    u = np.fft.ifftn(u_hat, axes=(1, 2, 3))
    F00 = np.fft.fftn(u[0]*u[0], axes=(0, 1, 2))
    F01 = np.fft.fftn(u[0]*u[1], axes=(0, 1, 2))
    F02 = np.fft.fftn(u[0]*u[2], axes=(0, 1, 2))
    F11 = np.fft.fftn(u[1]*u[1], axes=(0, 1, 2))
    F12 = np.fft.fftn(u[1]*u[2], axes=(0, 1, 2))
    F22 = np.fft.fftn(u[2]*u[2], axes=(0, 1, 2))
    Nm = np.zeros_like(u_hat)
    Nm[0] = 1j*KX*F00 + 1j*KY*F01 + 1j*KZ*F02
    Nm[1] = 1j*KX*F01 + 1j*KY*F11 + 1j*KZ*F12
    Nm[2] = 1j*KX*F02 + 1j*KY*F12 + 1j*KZ*F22
    Nm[:, deal] = 0.0
    dot = (KX*Nm[0] + KY*Nm[1] + KZ*Nm[2]) / k2z
    Nm[0] -= KX*dot
    Nm[1] -= KY*dot
    Nm[2] -= KZ*dot
    return Nm


def analyze_snapshots(snaps, N, nu, dt):
    """Streaming diagnostic extraction (one FFT/snapshot, memory-light).

    Returns the computed residuals -- never hardcoded:
      discrete_identity_rel_err : exact CN law (E_{n+1}-E_n)/dt = -2 nu G2eff/N^3
      continuous_identity_rel_err: dE/dt vs -2 nu G2/N^3
      spectral_pde_residual      : R = du/dt + P[N(u) + nu L u], normalized
    """
    t = np.arange(len(snaps)) * dt
    k = np.fft.fftfreq(N, d=2*np.pi/N) * 2*np.pi
    KX, KY, KZ = np.meshgrid(k, k, k, indexing="ij")
    k2g = KX**2 + KY**2 + KZ**2
    a = 0.5 * dt * nu * k2g

    res_idx = set()
    for n in range(0, len(snaps) - 1, 10):
        res_idx.add(n)
        res_idx.add(n + 1)
    E = np.empty(len(snaps))
    G2 = np.empty(len(snaps))
    G2eff = np.empty(len(snaps))
    H2 = -1.0
    H25 = -1.0
    u_at = {}
    for n, u in enumerate(snaps):
        uh = np.fft.fftn(u, axes=(1, 2, 3))
        ah = np.abs(uh)**2
        E[n] = ah.sum() / N**3
        G2[n] = (ah * k2g).sum()
        G2eff[n] = (ah * k2g / (1.0 + a)**2).sum()
        h2 = ((1 + k2g)**2 * ah).sum()
        h25 = ((1 + k2g)**2.5 * ah).sum()
        if h2 > H2:
            H2 = h2
        if h25 > H25:
            H25 = h25
        if n in res_idx:
            u_at[n] = uh

    t_fit, E_fit = t[5:], E[5:]
    try:
        popt, _ = curve_fit(power_law, t_fit, E_fit, p0=[E[0], 1.0], maxfev=20000)
        E0_fit, alpha = float(popt[0]), float(popt[1])
        pred = power_law(t_fit, E0_fit, alpha)
        ss_res = np.sum((E_fit - pred)**2)
        ss_tot = np.sum((E_fit - E_fit.mean())**2)
        r2 = float(1 - ss_res / ss_tot) if ss_tot > 0 else float("nan")
    except Exception:
        E0_fit = alpha = r2 = float("nan")

    dE_forward = np.diff(E) / dt
    diss_eff = -2.0 * nu * G2eff[:-1] / N**3
    disc_err = float(np.mean(np.abs(dE_forward - diss_eff) / (np.abs(diss_eff) + 1e-12)))

    dEdt = np.gradient(E, dt)
    diss_cont = -2.0 * nu * G2 / N**3
    mask = E > 0.05 * E[0]
    cont_err = float(np.mean(np.abs(dEdt - diss_cont)[mask] / (np.abs(diss_cont)[mask] + 1e-12))) \
        if mask.sum() > 1 else float("nan")

    res = []
    for n in sorted(u_at):
        if n >= len(snaps) - 1:
            continue
        u_p = u_at.get(n + 1)
        if u_p is None:
            continue
        Nn = spectral_nonlinear(u_at[n], N)
        R = (u_p - u_at[n]) / dt + Nn + nu * k2g * u_at[n]
        num = np.sum(np.abs(R)**2)
        den = np.sum(np.abs(Nn)**2 + np.abs(nu * k2g * u_at[n])**2) + 1e-12
        res.append(np.sqrt(num / den))
    spectral_res = float(np.mean(res))

    return {
        "N": N, "nu": nu, "T": len(snaps) * dt, "seed": None,
        "E0": float(E[0]), "ET": float(E[-1]),
        "alpha": alpha, "E0_fit": E0_fit, "powerlaw_r2": r2,
        "H2_norm_max": float(normalized(H2, N)),
        "H2_5_norm_max": float(normalized(H25, N)),
        "discrete_identity_rel_err": disc_err,
        "continuous_identity_rel_err": cont_err,
        "spectral_pde_residual": spectral_res,
    }


