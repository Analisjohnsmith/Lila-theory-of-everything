def plot_campaign(runs=None, filename=None):
    """Compiled figures straight from the registry (no re-solving)."""
    runs = runs if runs is not None else load_registry(REG_CAMPAIGN)
    Ncolors = {32: "tab:blue", 64: "tab:orange", 128: "tab:green"}

    # (a) Energy decay reconstructed from the power-law fit E(t)=E0_fit t^-alpha
    fig, ax = plt.subplots(figsize=(9, 6))
    t = np.logspace(np.log10(0.004), np.log10(2.0), 300)
    for r in runs:
        s = r["scope"]
        a = r["analysis"]["powerlaw_fit"]
        if not np.isfinite(a["R2"]) or a["R2"] <= 0:
            continue
        E0f, alpha = a["E0_fit"], r["analysis"]["energy_decay_exponent_alpha"]
        ax.loglog(t, E0f * t ** (-alpha),
                  color=Ncolors.get(s["resolution"], "tab:gray"), alpha=0.55)
    for N, c in Ncolors.items():
        ax.plot([], [], color=c, label=f"N={N}")
    ax.set_xlabel("t")
    ax.set_ylabel("E(t) ~ E0·t^(-α)")
    ax.set_title("Compiled energy decay tails (power-law fits, all runs)")
    ax.legend()
    ax.grid(True, alpha=0.3)
    fig.tight_layout()
    out = Path(VIZ_DIR) / "compiled_energy_decay.png"
    fig.savefig(out, dpi=150)
    plt.close(fig)
    print(f"saved {out}")

    # (b) dt-convergence of spectral PDE residual + resolution trend of disc_err
    from collections import defaultdict
    agg = defaultdict(list)
    for r in runs:
        s = r["scope"]
        agg[(s["resolution"], s["viscosity"], s["dt"])].append(r["analysis"])
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))
    for (N, nu, dt), aa in sorted(agg.items()):
        mean = np.mean([a["spectral_pde_residual"] for a in aa])
        ax1.loglog(dt, mean, "o", color=Ncolors[N], alpha=0.7)
    dt_ref = np.array([0.002, 0.008])
    ax1.loglog(dt_ref, 0.005 * dt_ref / 0.002, "k--", lw=1,
               label="linear (slope 1)")
    ax1.set_xlabel("dt")
    ax1.set_ylabel("spectral PDE residual (mean)")
    ax1.set_title("Spectral residual vs dt (linear convergence)")
    ax1.legend()
    ax1.grid(True, alpha=0.3)

    for (N, nu, dt), aa in sorted(agg.items()):
        mean = np.mean([a["discrete_identity_rel_err"] for a in aa])
        ax2.loglog(N, mean, "o", color=Ncolors[N], alpha=0.7)
    ax2.set_xlabel("N")
    ax2.set_ylabel("discrete identity rel. error (mean)")
    ax2.set_title("Identity error vs resolution")
    ax2.grid(True, alpha=0.3)
    fig.tight_layout()
    out = Path(VIZ_DIR) / "compiled_convergence.png"
    fig.savefig(out, dpi=150)
    plt.close(fig)
    print(f"saved {out}")


