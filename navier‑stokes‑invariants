def encode_ns_invariants(m, author="Darrell Lee (Līlā) Stiltner",
                         location="Signal Mountain, TN"):
    """Build the human/agent-readable NS-invariant module from one run's data."""
    energy_status = "PASS" if (m["ET"] <= m["E0"] and m["monotone_decay"]) else "FAIL"
    return {
        "NS_Invariants_001": {
            "energy_bound": {
                "definition": "∫ |u(x,t)|^2 dx < ∞ for all t ≥ 0",
                "kernel_status": energy_status,
                "measured": {"E(0)": m["E0"], "E(T)": m["ET"],
                             "monotone_decay": m["monotone_decay"]},
                "mapping": "Kinetic energy finite → Leray class invariant",
                "scope": f"single trajectory, N={m['N']}, nu={m['nu']}, "
                         f"T={m['T']} (empirical, not a proof)",
            },
            "sobolev_norm": {
                "definition": "‖u(·,t)‖_H^s < ∞ for some s > 3/2",
                "kernel_status": "PASS" if (np.isfinite(m["H2_norm_max"])
                                            and np.isfinite(m["H2_5_norm_max"])) else "FAIL",
                "measured": {"H^2_max": m["H2_norm_max"],
                             "H^2.5_max": m["H2_5_norm_max"]},
                "mapping": "Higher-order derivatives bounded → smoothness analogue",
                "scope": f"single trajectory, N={m['N']}, nu={m['nu']}, "
                         f"T={m['T']} (empirical, not a proof)",
            },
            "decay_exponent": {
                "definition": "E(t) ~ E0 t^(-alpha) on the tail (power-law fit)",
                "kernel_status": "PASS" if m.get("powerlaw_r2", 0) > 0.9 else "FAIL",
                "measured": {"alpha": m.get("alpha"), "R2": m.get("powerlaw_r2")},
                "mapping": "Empirical decay rate vs Stokes (alpha=1) / Kolmogorov (4/3) analogues",
                "scope": "tail fit on finite trajectory (empirical)",
            },
            "residual_checks": {
                "discrete_identity_rel_err": m.get("discrete_identity_rel_err"),
                "continuous_identity_rel_err": m.get("continuous_identity_rel_err"),
