def run_one(N=32, T=2.0, dt=0.002, nu=0.1, seed=42, filename=REG_CAMPAIGN,
            progress_every=None):
    """One corrected run: solve -> analyze -> meowwow verdict -> registry append."""
    scope = {"resolution": N, "viscosity": nu, "time_horizon": T, "seed": seed, "dt": dt}
    if _scope_present(filename, scope):
        return None
    snaps = solve(N=N, T=T, dt=dt, nu=nu, seed=seed, progress_every=progress_every)
    a = analyze_snapshots(snaps, N, nu, dt)
    verdict = meowwow_verdict_for(seed)
    E = np.array([np.sum(u**2) for u in snaps])
    run_entry = {
        "timestamp": datetime.now().astimezone().isoformat(),
        "scope": scope,
        "energy_bound": {"E0": a["E0"], "ET": a["ET"],
                         "monotone_decay": bool(np.all(np.diff(E) <= 0))},
        "sobolev_norm": {"H2": a["H2_norm_max"], "H2.5": a["H2_5_norm_max"]},
        "analysis": {
            "energy_decay_exponent_alpha": a["alpha"],
            "powerlaw_fit": {"E0_fit": a["E0_fit"], "R2": a["powerlaw_r2"]},
            "discrete_identity_rel_err": a["discrete_identity_rel_err"],
            "continuous_identity_rel_err": a["continuous_identity_rel_err"],
            "spectral_pde_residual": a["spectral_pde_residual"],
        },
        "meowwow_verdict": f"heavy_hit_suite {verdict} (seed={seed})",
    }
    if filename:
        append_run_to_yaml(filename, run_entry)
    return run_entry


def batch_runs(filename=REG_CAMPAIGN):
    """Feasible 16-run cross-resolution / viscosity / seed ensemble (~35 min)."""
    grid = []
    for N, nu_list, T in ((32, (0.10, 0.05, 0.02), 2.0),
                          (64, (0.10, 0.05), 1.0),
                          (128, (0.10,), 0.1)):
        for nu in nu_list:
            for seed in (42, 99, 123):
                if N == 128 and seed != 42:
                    continue
                grid.append(dict(N=N, nu=nu, T=T, seed=seed, dt=0.002))
    print(f"batch_runs: {len(grid)} runs -> {filename}")
    for i, g in enumerate(grid, 1):
        entry = run_one(filename=filename, progress_every=10, **g)
        if entry is None:
            print(f"[{i}/{len(grid)}] SKIP (already logged) {g}")
            continue
        a = entry["analysis"]
        print(f"[{i}/{len(grid)}] N={g['N']} nu={g['nu']:.2f} T={g['T']:.1f} "
              f"seed={g['seed']:3d}  alpha={a['energy_decay_exponent_alpha']:.3f} "
              f"R2={a['powerlaw_fit']['R2']:.3f} "
              f"disc={a['discrete_identity_rel_err']:.2e} "
              f"spec={a['spectral_pde_residual']:.2e} "
              f"{entry['meowwow_verdict']}")
    return grid


def ultimate_ns_campaign(filename=REG_CAMPAIGN):
    """Feasible dt-convergence campaign (budget-capped; N=256 is impractical)."""
    grid = []
    for N, dt_list, nu_list, T in ((32, (0.008, 0.004, 0.002), (0.10, 0.05), 2.0),
                                   (64, (0.004, 0.002), (0.10,), 1.0)):
        for dt in dt_list:
            for nu in nu_list:
                for seed in (42, 99):
                    grid.append(dict(N=N, nu=nu, T=T, seed=seed, dt=dt))
    print(f"ultimate_ns_campaign: {len(grid)} runs -> {filename}")
    for i, g in enumerate(grid, 1):
        entry = run_one(filename=filename, progress_every=10, **g)
        if entry is None:
            print(f"[{i}/{len(grid)}] SKIP (already logged) {g}")
            continue
        a = entry["analysis"]
        print(f"[{i}/{len(grid)}] N={g['N']} dt={g['dt']:.4f} nu={g['nu']:.2f} "
              f"seed={g['seed']}  alpha={a['energy_decay_exponent_alpha']:.3f} "
              f"disc={a['discrete_identity_rel_err']:.2e} "
              f"cont={a['continuous_identity_rel_err']:.2e} "
              f"spec={a['spectral_pde_residual']:.2e}")
    return grid


def reanalyze(filename=REG_CAMPAIGN, only_N=None):
    """Recompute every run's analysis with the current pipeline (one operator)."""
    with open(filename) as f:
        reg = yaml.safe_load(f) or {}
    runs = reg.setdefault("NS_Campaign_registry", {}).setdefault("runs", [])
    if only_N is not None:
        runs = [r for r in runs if r["scope"]["resolution"] == only_N]
    print(f"reanalyze: {len(runs)} runs ({only_N if only_N else 'all'}) in {filename}")
    for i, run in enumerate(runs, 1):
        s = run["scope"]
        N, nu, T, dt, seed = (s["resolution"], s["viscosity"],
                              s["time_horizon"], s["dt"], s["seed"])
        snaps = solve(N=N, T=T, dt=dt, nu=nu, seed=seed, progress_every=10)
        a = analyze_snapshots(snaps, N, nu, dt)
        E = np.array([np.sum(u**2) for u in snaps])
        run["energy_bound"] = {"E0": a["E0"], "ET": a["ET"],
                               "monotone_decay": bool(np.all(np.diff(E) <= 0))}
        run["sobolev_norm"] = {"H2": a["H2_norm_max"], "H2.5": a["H2_5_norm_max"]}
        run["analysis"] = {
            "energy_decay_exponent_alpha": a["alpha"],
            "powerlaw_fit": {"E0_fit": a["E0_fit"], "R2": a["powerlaw_r2"]},
            "discrete_identity_rel_err": a["discrete_identity_rel_err"],
            "continuous_identity_rel_err": a["continuous_identity_rel_err"],
            "spectral_pde_residual": a["spectral_pde_residual"],
        }
        with open(filename, "w") as f:
            yaml.safe_dump(reg, f, sort_keys=False)
        print(f"[{i}/{len(runs)}] N={N} nu={nu:.2f} T={T} dt={dt} seed={seed}  "
              f"alpha={a['alpha']:.3f} disc={a['discrete_identity_rel_err']:.2e} "
              f"spec={a['spectral_pde_residual']:.2e}")
    return runs


