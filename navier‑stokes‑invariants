# 1. SOLVER  (from ns_solver.py -- conservative form, validated)
# =====================================================================


def solve(N=32, T=1.0, dt=0.01, nu=0.1, seed=None, progress_every=None):
    """Pseudo-spectral Navier-Stokes toy solver, 2nd-order in time.

    - derivatives via i*k in Fourier space
    - 2/3 dealiasing + Helmholtz projection (discrete pressure solve)
    - real (Hermitian-symmetric) divergence-free initial field
    - Adams-Bashforth 2 for the nonlinear term, Crank-Nicolson for viscosity
    - conservative-form nonlinearity: N_j = sum_q d/dx_q (u_q u_j)
    """
    if seed is not None:
        np.random.seed(seed)
    k = np.fft.fftfreq(N, d=2*np.pi/N) * 2*np.pi
    KX, KY, KZ = np.meshgrid(k, k, k, indexing='ij')
    k2 = KX**2 + KY**2 + KZ**2
    k2_zero = k2.copy()
    k2_zero[0, 0, 0] = 1.0

    cutoff = N // 3
    deal = (np.abs(KX) > cutoff) | (np.abs(KY) > cutoff) | (np.abs(KZ) > cutoff)

    def project(u_hat):
        dot = (KX*u_hat[0] + KY*u_hat[1] + KZ*u_hat[2]) / k2_zero
        u_hat[0] -= KX*dot
        u_hat[1] -= KY*dot
        u_hat[2] -= KZ*dot
        return u_hat

    def nonlinear_at(m):
        u = ifftn(m, axes=(1, 2, 3))
        F00 = fftn(u[0]*u[0], axes=(0, 1, 2))
        F01 = fftn(u[0]*u[1], axes=(0, 1, 2))
        F02 = fftn(u[0]*u[2], axes=(0, 1, 2))
        F11 = fftn(u[1]*u[1], axes=(0, 1, 2))
        F12 = fftn(u[1]*u[2], axes=(0, 1, 2))
        F22 = fftn(u[2]*u[2], axes=(0, 1, 2))
        Nm = np.zeros_like(m)
        Nm[0] = 1j*KX*F00 + 1j*KY*F01 + 1j*KZ*F02
        Nm[1] = 1j*KX*F01 + 1j*KY*F11 + 1j*KZ*F12
        Nm[2] = 1j*KX*F02 + 1j*KY*F12 + 1j*KZ*F22
        Nm[:, deal] = 0.0
        return project(Nm)

    u_hat = project(fftn(np.random.randn(3, N, N, N), axes=(1, 2, 3)))

    snapshots = []
    prev_nl = None
    cn = (1.0 - 0.5*dt*nu*k2) / (1.0 + 0.5*dt*nu*k2)
    total_steps = int(T/dt)
    for i in range(total_steps):
        Nn = nonlinear_at(u_hat)
        rhs = Nn if prev_nl is None else 1.5*Nn - 0.5*prev_nl
        u_hat = (u_hat - dt*rhs) * cn
        prev_nl = Nn
        snapshots.append(np.real(ifftn(u_hat, axes=(1, 2, 3))))
        if progress_every and (i + 1) % progress_every == 0:
            print(f"  [solve step {i+1}/{total_steps}]", flush=True)
    return snapshots


