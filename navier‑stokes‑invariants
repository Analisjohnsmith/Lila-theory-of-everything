                "kernel_status": "PASS" if m.get("discrete_identity_rel_err", 1) < 1e-2 else "FAIL",
                "mapping": "Discretization self-consistency (CN law, dE/dt vs G2, PDE residual)",
            },
            "pde_mapping": {
