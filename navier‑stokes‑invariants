def collect_images(root="."):
    imgs = []
    for sub in ("", "zhaived_modules", "toe_outputs"):
        p = Path(root) / sub
        if not p.exists():
            continue
        for f in sorted(p.glob("*.png")):
            imgs.append(str(f))
    return imgs


def build_gallery(outfile="zhaived_modules/gallery.html"):
    """Write one self-contained HTML gallery embedding every project PNG."""
    imgs = collect_images()
    Path(outfile).parent.mkdir(parents=True, exist_ok=True)

    cards = []
    for path in imgs:
        name = os.path.basename(path)
        try:
            with open(path, "rb") as f:
                b64 = base64.b64encode(f.read()).decode("ascii")
        except OSError as e:
            print(f"skip {path}: {e}")
            continue
        kb = os.path.getsize(path) // 1024
        title = GALLERY_TITLES.get(name, name.replace("_", " ").replace(".png", ""))
        cards.append(f"""
        <figure class="card">
          <img src="data:image/png;base64,{b64}" alt="{title}" loading="lazy" />
          <figcaption>
            <b>{title}</b><br/>
            <span class="meta">{path} · {kb} KB</span>
          </figcaption>
        </figure>""")

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>ZhaivedOS — Project Photo Gallery</title>
<style>
  body {{ font-family: system-ui, sans-serif; background: #0f1115; color: #e8e8e8;
         margin: 0; padding: 24px; }}
  h1 {{ font-weight: 500; }}
  .gallery {{ display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
             gap: 18px; }}
  .card {{ background: #1a1d24; border-radius: 10px; padding: 10px; margin: 0; }}
  .card img {{ width: 100%; height: auto; border-radius: 6px; background: #000; }}
  .card figcaption {{ margin-top: 8px; font-size: 0.9rem; line-height: 1.4; }}
  .meta {{ color: #8a93a6; font-size: 0.78rem; font-family: ui-monospace, monospace; }}
</style>
</head>
<body>
<h1>ZhaivedOS — Project Photo Gallery</h1>
<p>{len(cards)} images embedded into one file · generated {datetime.now().astimezone().isoformat()}</p>
<div class="gallery">
{''.join(cards)}
</div>
</body>
</html>"""
    with open(outfile, "w") as f:
        f.write(html)
    print(f"saved {outfile} ({len(imgs)} images, {os.path.getsize(outfile)//1024} KB)")


