def compile_project():
    """Full compile: sanity, viz, gallery, and the consolidated manifest."""
    print("== zhaived compile ==")

    print("\n-- sanity run (N=32, T=0.2) --")
    snaps = solve(N=32, T=0.2, dt=0.002, nu=0.1, seed=42)
    a = analyze_snapshots(snaps, 32, 0.1, 0.002)
    print(f"  E0={a['E0']:.4e} ET={a['ET']:.4e} alpha={a['alpha']:.3f} "
          f"disc={a['discrete_identity_rel_err']:.2e} "
          f"spec={a['spectral_pde_residual']:.2e}")

    print("\n-- viz --")
    plot_campaign()

    print("\n-- gallery --")
    build_gallery()

    print("\n-- consolidated manifest --")
    campaign = load_registry(REG_CAMPAIGN)
    invariants = load_registry(REG_INVARIANTS)
    from collections import defaultdict
    conv = defaultdict(list)
    for r in campaign:
        s = r["scope"]
        conv[(s["resolution"], s["viscosity"], s["dt"])].append(r["analysis"])
    conv_table = []
    for key, aa in sorted(conv.items()):
        conv_table.append({
            "N": key[0], "nu": key[1], "dt": key[2],
            "mean_alpha": float(np.mean([a["energy_decay_exponent_alpha"] for a in aa])),
            "mean_R2": float(np.mean([a["powerlaw_fit"]["R2"] for a in aa])),
            "mean_disc_err": float(np.mean([a["discrete_identity_rel_err"] for a in aa])),
            "mean_cont_err": float(np.mean([a["continuous_identity_rel_err"] for a in aa])),
            "mean_spec_res": float(np.mean([a["spectral_pde_residual"] for a in aa])),
        })
    manifest = {
        "zhaived_compiled": {
            "description": "One-file compilation of the NS-invariants project "
                           "(solver, analysis, registry, campaign, module, viz, gallery).",
            "timestamp": datetime.now().astimezone().isoformat(),
            "folded_modules": [
                "ns_solver.py", "zhaived_analysis.py", "zhaived_registry.py",
                "spectral_ns_solver.py", "zhaived_ns_module.py", "zhaived_viz.py",
                "valari_meowwow_toe.py (verdict plumbing)",
            ],
            "invariant_registry": REG_INVARIANTS,
            "invariant_runs": len(invariants),
            "campaign_registry": REG_CAMPAIGN,
            "campaign_runs": len(campaign),
            "all_pass": all(r.get("meowwow_verdict", "").startswith("heavy_hit_suite PASS")
                            for r in campaign),
            "all_monotone_decay": all(r.get("energy_bound", {}).get("monotone_decay")
                                      for r in campaign),
            "convergence_table": conv_table,
            "gallery": "zhaived_modules/gallery.html",
            "figures": {
                "registry_viz": "zhaived_modules/registry_viz.png",
                "energy_decay": "zhaived_modules/compiled_energy_decay.png",
                "convergence": "zhaived_modules/compiled_convergence.png",
            },
        }
    }
    out = "zhaived_modules/zhaived_compiled.yaml"
    with open(out, "w") as f:
        yaml.safe_dump(manifest, f, sort_keys=False)
    print(f"saved {out}")
    print(f"\ncompile complete: {len(campaign)} campaign runs, "
          f"{len(invariants)} invariant runs, gallery embedded.")


