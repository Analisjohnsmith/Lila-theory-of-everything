REG_CAMPAIGN = "zhaived_modules/NS_Campaign_registry.yaml"
REG_INVARIANTS = "zhaived_modules/NS_Invariants_registry.yaml"
TOE_OUT = "toe_outputs"

_verdict_cache = {}


def meowwow_verdict_for(seed, params=None):
    """heavy_hit_suite verdict for a seed (cached; the suite is expensive)."""
    if seed in _verdict_cache:
        return _verdict_cache[seed]
    if params is None:
        params = {"m2": -8000.0, "lambda_H": 0.1, "y": 0.2, "g": 0.4, "mu": 1.0}
    _random.seed(seed)
    buf = io.StringIO()
    with redirect_stdout(buf):
        import valari_meowwow_toe as mmw
        res = mmw.heavy_hit_suite(TOE_OUT, params)
    verdict = res["overall_verdict"]
    _verdict_cache[seed] = verdict
    return verdict


def load_registry(path=REG_CAMPAIGN):
    with open(path) as f:
        reg = yaml.safe_load(f) or {}
    return reg.get("NS_Campaign_registry", {}).get("runs", []) if path == REG_CAMPAIGN \
        else reg.get("NS_Invariants_registry", {}).get("runs", [])


def append_run_to_yaml(filename, run_entry):
    Path(filename).parent.mkdir(parents=True, exist_ok=True)
    if Path(filename).exists():
        with open(filename) as f:
            reg = yaml.safe_load(f) or {}
    else:
        reg = {"NS_Campaign_registry": {"runs": []}}
    root = reg.setdefault("NS_Campaign_registry", {})
    root.setdefault("runs", []).append(run_entry)
    with open(filename, "w") as f:
        yaml.safe_dump(reg, f, sort_keys=False)


def _scope_present(filename, scope):
    if not (filename and Path(filename).exists()):
        return False
    with open(filename) as f:
        reg = yaml.safe_load(f) or {}
    for run in reg.get("NS_Campaign_registry", {}).get("runs", []):
        if run.get("scope") == scope:
            return True
    return False


