\section{Foundational Structure}

Let $\phi : \mathbb{R}^4 \to \mathbb{R}^k$ be a differentiable field. 
Coordinates in $\mathbb{R}^4$ are denoted


\[
x = (x_1, x_2, x_3, x_4), \qquad 
r = \sqrt{x_1^2 + x_2^2 + x_3^2 + x_4^2}, \qquad 
\hat{x} = \frac{x}{r}.
\]



A universe in this framework is defined as a pair


\[
(\mathcal{X}, \phi), \qquad \mathcal{X} = \mathbb{R}^4,
\]


where $\phi$ satisfies the canonical stability conditions defined below.

\section{Canonical Stability Operator}

The canonical stability functional is defined as


\[
\mathcal{C}[\phi] 
= w_{\mathrm{sym}} \, \mathcal{C}_{\mathrm{sym}}[\phi]
+ w_{\mathrm{coh}} \, \mathcal{C}_{\mathrm{coh}}[\phi]
+ w_{\mathrm{rec}} \, \mathcal{C}_{\mathrm{rec}}[\phi]
+ w_{\mathrm{bal}} \, \mathcal{C}_{\mathrm{bal}}[\phi],
\]


where each term measures a distinct structural property of the field.

\subsection{Symmetry Term}

Let $G = SO(4)$ act on $\mathbb{R}^4$. Define


\[
\mathcal{C}_{\mathrm{sym}}[\phi]
= 1 - \frac{1}{|G|}
\int_G 
\frac{\|\phi(gx) - \phi(x)\|}
     {\|\phi(x)\| + \varepsilon} \, dg.
\]



\subsection{Coherence Term}

Let $\phi$ admit a harmonic decomposition


\[
\phi(x) = \sum_{n} A_n e^{i k_n \cdot x}.
\]


Define coherence as


\[
\mathcal{C}_{\mathrm{coh}}[\phi]
= 1 - \frac{1}{N^2}
\sum_{m,n}
\left| \arg(A_m) - \arg(A_n) \right|.
\]



\subsection{Recursion Term}

Define the scaling operator


\[
S_\lambda \phi(x) = \phi(\lambda x).
\]


Then


\[
\mathcal{C}_{\mathrm{rec}}[\phi]
= \exp\!\left(
- \int_{\lambda_{\min}}^{\lambda_{\max}}
\| S_\lambda \phi - \phi \|^2 \, d\lambda
\right).
\]



\subsection{Balance Term}

Let $p_n = \frac{|A_n|^2}{\sum_m |A_m|^2}$. Define


\[
\mathcal{C}_{\mathrm{bal}}[\phi]
= 1 - \left| 
-\sum_n p_n \log p_n - C_0
\right|.
\]



A field is canonically stable if


\[
\mathcal{C}[\phi] \ge \tau.
\]



\section{Variational Principle}

Define the action


\[
\mathcal{A}[\phi] = \int_{\mathbb{R}^4} \mathcal{L}(\phi, \nabla \phi) \, d^4x,
\]


where


\[
\mathcal{L} = \mathcal{C}[\phi] - V(\phi).
\]



Canonical universes satisfy the Euler--Lagrange equation


\[
\frac{\partial \mathcal{L}}{\partial \phi}
- \nabla \cdot \left(
\frac{\partial \mathcal{L}}{\partial (\nabla \phi)}
\right)
= 0.
\]



This yields the canonical stability PDE


\[
\frac{\partial \phi}{\partial t}
= F_{\mathrm{canon}}(\phi, \nabla \phi).
\]



A canonical attractor satisfies


\[
F_{\mathrm{canon}}(\phi_\ast, \nabla \phi_\ast) = 0.
\]



