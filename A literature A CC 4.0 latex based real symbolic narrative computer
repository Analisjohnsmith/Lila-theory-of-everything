#[derive(Debug, Clone)]
struct Config {
    version: String,
    runtime: String,
    entrypoint: String,
    machine_source: String,
    machine_format: String,
    seed_source: String,
    seed_format: String,
    engine_mode: String,
    output_file: String,
    scene: String,
}

fn extract_quoted(line: &str, key: &str) -> Option<String> {
    let pos = line.find(key)?;
    let rest = &line[pos + key.len()..];
    let start = rest.find('"')?;
    let rest = &rest[start + 1..];
    let end = rest.find('"')?;
    Some(rest[..end].to_string())
}

fn load_hson(path: &str) -> Config {
    let content = fs::read_to_string(path).unwrap_or_default();
    let mut sources = Vec::new();

    let mut version = "1.0".to_string();
    let mut runtime = "SYMBOLIC_OS".to_string();
    let mut entrypoint = "RUN_MACHINE".to_string();
    let mut engine_mode = "MACHINE_APPLIED_SEED".to_string();
    let mut scene = "CHAPTER_1".to_string();

    for line in content.lines() {
        if let Some(s) = extract_quoted(line, "source") {
            sources.push(s);
        }

        if line.contains("version") {
            if let Some(v) = extract_quoted(line, "version") {
                version = v;
            } else if let Some(eq) = line.find('=') {
                version = line[eq + 1..].trim().trim_matches('"').to_string();
            }
        }

        if line.contains("runtime") {
            if let Some(eq) = line.find('=') {
                runtime = line[eq + 1..].trim().trim_matches('"').to_string();
            }
        }

        if line.contains("entrypoint") {
            if let Some(eq) = line.find('=') {
                entrypoint = line[eq + 1..].trim().trim_matches('"').to_string();
            }
        }

        if line.contains("mode") {
            if let Some(eq) = line.find('=') {
                engine_mode = line[eq + 1..].trim().trim_matches('"').to_string();
            }
        }

        if line.contains("scene RUN_MACHINE") {
            scene = "CHAPTER_1".to_string();
        }
    }

    let machine_source = sources
        .get(0)
        .cloned()
        .unwrap_or_else(|| "machine.tex".to_string());

    let seed_source = sources
        .get(1)
        .cloned()
        .unwrap_or_else(|| "seed.txt".to_string());

    Config {
        version,
        runtime,
        entrypoint,
        machine_source,
        machine_format: "LATEX".to_string(),
        seed_source,
        seed_format: "TEXT".to_string(),
        engine_mode,
        output_file: "story_output.tex".to_string(),
        scene,
    }
}

struct MachineA {
    config: Config,
    seed: String,
    template: String,
}

impl MachineA {
    fn new(hson_path: &str) -> Self {
        let config = load_hson(hson_path);

        let seed = fs::read_to_string(&config.seed_source)
            .unwrap_or_else(|_| SEED_TXT.to_string())
            .trim()
            .to_string();

        let template = fs::read_to_string(&config.machine_source)
            .unwrap_or_else(|_| MACHINE_TEX.to_string());

        Self {
            config,
            seed,
            template,
        }
    }

    fn display_system_info(&self) -> String {
        format!(
            "=============================================================================\n\
             MACHINE A: SYSTEM DEFINITION\n\
             =============================================================================\n\
             Version:     {}\n\
             Runtime:     {}\n\
             Entrypoint:  {}\n\
             Engine Mode: {}\n\
             Machine:     {}\n\
             Seed:        {}\n\
             Output:      {}\n\
             Scene:       {}\n\
             =============================================================================\n",
            self.config.version,
            self.config.runtime,
            self.config.entrypoint,
            self.config.engine_mode,
            self.config.machine_source,
            self.config.seed_source,
            self.config.output_file,
            self.config.scene
        )
    }
}

struct StoryState {
    seed: String,
    chapter: u32,
    events: Vec<String>,
    characters: Vec<String>,
    location: Option<String>,
    phase: String,
    word_count: usize,
}

struct MachineB {
    machine_a: MachineA,
    state: Option<StoryState>,
    output: Vec<String>,
    total_words: usize,
}

impl MachineB {
    fn new(machine_a: MachineA) -> Self {
        Self {
            machine_a,
            state: None,
            output: Vec::new(),
            total_words: 0,
        }
    }

    fn initialize_state(&mut self, seed: &str) {
        self.state = Some(StoryState {
            seed: seed.to_string(),
            chapter: 1,
            events: Vec::new(),
            characters: Vec::new(),
            location: None,
            phase: "BEGINNING".to_string(),
            word_count: 0,
        });
    }

    fn deterministic_rules(&mut self) -> String {
        let state = self.state.as_mut().expect("State not initialized");
        let mut text = String::new();

        if state.chapter == 1 {
            writeln!(text, "% narrative_seed: {}", state.seed).unwrap();
            writeln!(text).unwrap();
            writeln!(text, "\\chapter{{Once Upon a Time}}").unwrap();
            writeln!(text).unwrap();
            writeln!(
                text,
                "In a quiet corner of existence, where the {},",
                state.seed
            )
            .unwrap();
            writeln!(text, "something began to stir.").unwrap();
            writeln!(text).unwrap();

            state.events.push("seed introduced".to_string());
            state.phase = "AWAKENING".to_string();
        }

        if state.location.is_none() {
            let lower = state.seed.to_lowercase();

            let loc = if lower.contains("duck") || lower.contains("pond") {
                "a quiet pond in an ancient park"
            } else if lower.contains("star") || lower.contains("universe") {
                "the edge of a spiral galaxy"
            } else if lower.contains("mountain") || lower.contains("valley") {
                "a hidden valley between two peaks"
            } else {
                "a quiet valley"
            };

            state.location = Some(loc.to_string());

            writeln!(text, "The story unfolds in {}.", loc).unwrap();
            writeln!(text).unwrap();

            state.events.push("location set".to_string());
            state.phase = "SETTLING".to_string();
        }

        if state.characters.is_empty() {
            let lower = state.seed.to_lowercase();

            if lower.contains("duck") {
                state.characters = vec!["Duck A".to_string(), "Duck B".to_string()];
                writeln!(
                    text,
                    "Two figures emerged from the stillness: Duck A and Duck B."
                )
                .unwrap();
                writeln!(
                    text,
                    "One traced patterns in the water. The other watched the sky."
                )
                .unwrap();
                writeln!(text).unwrap();
            } else if lower.contains("star") {
                state.characters = vec!["Sirius".to_string(), "Vega".to_string()];
                writeln!(text, "Two stars in the constellation: Sirius and Vega.").unwrap();
                writeln!(text, "Their light traveled across the void to meet.").unwrap();
                writeln!(text).unwrap();
            } else {
                state.characters = vec!["The Seeker".to_string(), "The Guide".to_string()];
                writeln!(text, "Two figures appeared: The Seeker and The Guide.").unwrap();
                writeln!(text, "One asked questions. The other held the answers.").unwrap();
                writeln!(text).unwrap();
            }

            state.events.push("characters introduced".to_string());
            state.phase = "ENCOUNTER".to_string();
        }

        let chars = state.characters.join(", ");

        if chars.contains("Duck") {
            writeln!(
                text,
                "Duck A spoke first: \\textit{{``The water remembers everything.''}}"
            )
            .unwrap();
            writeln!(
                text,
                "Duck B tilted its head: \\textit{{``Then why does it keep changing?''}}"
            )
            .unwrap();
            writeln!(text).unwrap();
            writeln!(
                text,
                "Duck A said: \\textit{{``We are shadows on the water.''}}"
            )
            .unwrap();
            writeln!(
                text,
                "Duck B replied: \\textit{{``No -- the water is a shadow of us.''}}"
            )
            .unwrap();
            writeln!(text).unwrap();
        } else if chars.contains("Sirius") {
            writeln!(
                text,
                "Sirius pulsed: \\textit{{``Light is the only truth we know.''}}"
            )
            .unwrap();
            writeln!(
                text,
                "Vega flickered: \\textit{{``And yet, darkness is what gives it shape.''}}"
            )
            .unwrap();
            writeln!(text).unwrap();
        } else {
            writeln!(
                text,
                "The Seeker asked: \\textit{{``What lies beyond this moment?''}}"
            )
            .unwrap();
            writeln!(
                text,
                "The Guide answered: \\textit{{``Everything and nothing, in equal measure.''}}"
            )
            .unwrap();
            writeln!(text).unwrap();
        }

        state.events.push("dialogue occurred".to_string());
        state.phase = "REFLECTION".to_string();

        writeln!(
            text,
            "A leaf fell, touching the surface with a soft voice."
        )
        .unwrap();
        writeln!(text, "The ripples spread outward in perfect circles.").unwrap();
        writeln!(
            text,
            "\\textit{{``That,'' said Duck A, ``is a story.''}}"
        )
        .unwrap();
        writeln!(
            text,
            "\\textit{{``Every story is a ripple,'' said Duck B.}}"
        )
        .unwrap();
        writeln!(
            text,
            "\\textit{{``It begins somewhere, spreads everywhere, and never truly ends.''}}"
        )
        .unwrap();
        writeln!(text).unwrap();

        state.events.push("wisdom shared".to_string());
        state.phase = "WISDOM".to_string();

        writeln!(text, "Chapter {} ends.", state.chapter).unwrap();
        writeln!(text, "The story continues, as all stories do.").unwrap();

        state.events.push("chapter ended".to_string());
        state.phase = "RESTING".to_string();

        state.word_count += text.split_whitespace().count();
        state.chapter += 1;

        text
    }

    fn generate_chapter(&mut self) -> String {
        let chapter_text = self.deterministic_rules();
        self.output.push(chapter_text.clone());

        if let Some(state) = &self.state {
            self.total_words += state.word_count;
        }

        chapter_text
    }

    fn generate_story(&mut self, num_chapters: u32) -> String {
        self.output.clear();

        for _ in 0..num_chapters {
            self.generate_chapter();
        }

        self.output.join("\n\n")
    }

    fn format_output(&self) -> String {
        let seed = self
            .state
            .as_ref()
            .map(|s| s.seed.as_str())
            .unwrap_or("unknown");

        let machine_source = &self.machine_a.config.machine_source;
        let first_chapter = self.output.first().map(|s| s.as_str()).unwrap_or("No content");

        format!(
            r#"
HSON_STORY_OUTPUT {{
  meta {{
    version    = 1.0
    runtime    = SYMBOLIC_OS
    entrypoint = RUN_MACHINE
    engine     = MACHINE_APPLIED_SEED
    type       = DETERMINISTIC
    generator  = MachineB
  }}
  input {{
    narrative_seed = "{seed}"
    machine_source = "{machine_source}"
  }}
  output {{
    format  = LATEX
    words   = {words}
  }}
  chapter_1 {{
{chapter}
  }}
  scene RUN_MACHINE {{
    id   = CHAPTER_1
    text = STORY_ENGINE.RUN
  }}
}}
"#,
            seed = seed,
            machine_source = machine_source,
            words = self.total_words,
            chapter = first_chapter
        )
    }

    fn save_output(&self, filename: &str) {
        let output_text = self.format_output();
        fs::write(filename, output_text).expect("Failed to write output");
        println!("Story generated deterministically -> {}", filename);
    }

    fn display_status(&self) -> String {
        if let Some(state) = &self.state {
            format!(
                "=============================================================================\n\
                 MACHINE B: GENERATION STATUS\n\
                 =============================================================================\n\
                 Seed:        {}\n\
                 Chapter:     {}\n\
                 Location:    {}\n\
                 Phase:       {}\n\
                 Characters:  {}\n\
                 Events:      {}\n\
                 Word Count:  {}\n\
                 Total Words: {}\n\
                 =============================================================================\n",
                state.seed,
                state.chapter,
                state.location.as_deref().unwrap_or("None"),
                state.phase,
                if state.characters.is_empty() {
                    "None".to_string()
                } else {
                    state.characters.join(", ")
                },
                state.events.len(),
                state.word_count,
                self.total_words
            )
        } else {
            "Machine B: Not initialized".to_string()
        }
    }
}

fn create_default_files() {
    if !Path::new("seed.txt").exists() {
        fs::write("seed.txt", SEED_TXT).expect("write seed.txt");
        println!("Created seed.txt");
    }

    if !Path::new("machine.tex").exists() {
        fs::write("machine.tex", MACHINE_TEX).expect("write machine.tex");
        println!("Created machine.tex");
    }

    if !Path::new("universe_machine.hson").exists() {
        fs::write("universe_machine.hson", UNIVERSE_MACHINE_HSON)
            .expect("write universe_machine.hson");
        println!("Created universe_machine.hson");
    }
}

