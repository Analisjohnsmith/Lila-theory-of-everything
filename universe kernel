# 👽 Ω‑Alien Universe Kernel — Visualizable Structural Model
# Universe as a geometric object: stars, systems, clusters, filaments.

import hashlib
import random
import math

def Ω_hash(x):
    return hashlib.sha256(str(x).encode()).hexdigest()

def Ω_rand():
    return random.random()

def Ω_vec3(scale=1.0):
    # 3D position with non-uniform distribution
    return (
        scale * math.sin(Ω_rand() * 2 * math.pi),
        scale * math.cos(Ω_rand() * 2 * math.pi),
        scale * math.sin(Ω_rand() * 4 * math.pi)
    )

class ΩStar:
    def __init__(self, seed, radius=1.0):
        self.id = Ω_hash("STAR" + seed)
        self.position = Ω_vec3(radius)
        self.luminosity = Ω_hash(seed + "LUM")
        self.spectrum = Ω_hash(seed + "SPEC")

class ΩSystem:
    def __init__(self, seed, star_count=5, radius=2.0):
        self.id = Ω_hash("SYS" + seed)
        self.stars = []
        self.center = Ω_vec3(radius)

        for i in range(star_count):
            s_seed = Ω_hash(seed + str(i))
            star = ΩStar(s_seed, radius=radius * 0.3)
            # offset star around system center
            sx, sy, sz = star.position
            cx, cy, cz = self.center
            star.position = (cx + sx, cy + sy, cz + sz)
            self.stars.append(star)

class ΩCluster:
    def __init__(self, seed, system_count=4, radius=6.0):
        self.id = Ω_hash("CLUST" + seed)
        self.systems = []
        self.center = Ω_vec3(radius)

        for i in range(system_count):
            sys_seed = Ω_hash(seed + "SYS" + str(i))
            system = ΩSystem(sys_seed, star_count=5, radius=radius * 0.4)
            # offset system around cluster center
            sx, sy, sz = system.center
            cx, cy, cz = self.center
            system.center = (cx + sx, cy + sy, cz + sz)
            # also offset stars accordingly
            for star in system.stars:
                x, y, z = star.position
                star.position = (x + cx, y + cy, z + cz)
            self.systems.append(system)

class ΩCosmicWeb:
    def __init__(self, cluster_count=6, radius=12.0):
        self.clusters = []
        self.filaments = []  # connections between cluster centers

        for i in range(cluster_count):
            c_seed = Ω_hash("C" + str(i) + str(Ω_rand()))
            cluster = ΩCluster(c_seed, system_count=4, radius=radius)
            self.clusters.append(cluster)

        # build filaments between cluster centers
        for i in range(len(self.clusters)):
            for j in range(i + 1, len(self.clusters)):
                a = self.clusters[i].center
                b = self.clusters[j].center
                fid = Ω_hash(str(a) + str(b))
                self.filaments.append((a, b, fid))

    def export(self):
        stars = []
        systems = []
        clusters = []
        filaments = []

        for cl in self.clusters:
            clusters.append({
                "id": cl.id,
                "center": cl.center
            })
            for sys in cl.systems:
                systems.append({
                    "id": sys.id,
                    "center": sys.center
                })
                for star in sys.stars:
                    stars.append({
                        "id": star.id,
                        "position": star.position,
                        "luminosity": star.luminosity,
                        "spectrum": star.spectrum
                    })

        for (a, b, fid) in self.filaments:
            filaments.append({
                "a": a,
                "b": b,
                "id": fid
            })

        return {
            "stars": stars,
            "systems": systems,
            "clusters": clusters,
            "filaments": filaments
        }

if __name__ == "__main__":
    universe = ΩCosmicWeb(cluster_count=8, radius=15.0)
