            angs.append(dp[1])
    if any(np.isnan(rads)):
        pass3 = pass4 = False
        spr, spa = np.nan, np.nan
    else:
        spr = (max(rads) - min(rads)) / np.mean(rads)
        spa = np.rad2deg(max(angs) - min(angs))
        pass3 = spr < RAD_SPREAD_MAX
        pass4 = spa < ANG_SPREAD_MAX

    print(f"  P1: M1 real={M1_real:.2f}x  null={M1_null.mean():.2f}+/-{M1_null.std():.2f}"
          f" (99th {t1:.2f}) p={p1:.4f} -> {'PASS' if pass1 else 'FAIL'}")
    print(f"  P2: M2 real={M2_real}  null={M2_null.mean():.2f}+/-{M2_null.std():.2f}"
          f" (99th {t2:.0f}) p={p2:.4f} -> {'PASS' if pass2 else 'FAIL'}")
    print(f"  P3: radii={[f'{x:.1f}' for x in rads]} spread={spr:.3f} "
          f"(<{RAD_SPREAD_MAX}) -> {'PASS' if pass3 else 'FAIL'}")
    print(f"  P4: angles={[f'{np.rad2deg(x):.1f}' for x in angs]} deg "
          f"spread={spa:.1f} (<{ANG_SPREAD_MAX}) -> {'PASS' if pass4 else 'FAIL'}")
    ok = pass1 and pass2 and pass3 and pass4
    print(f"  OVERALL: {'PASS' if ok else 'FAIL'}")
    return ok

def main():
    rng = np.random.default_rng(RNG_SEED)
    print("=" * 66)
    print("LoF-008: Geometric directional-operator test")
    print("=" * 66)
    lat = ideal_lattice()
