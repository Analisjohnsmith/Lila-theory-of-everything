    th = np.arctan2(yy[mask], xx[mask]) % (2.0 * np.pi)
    sec = np.floor(th / (2.0 * np.pi / nang)).astype(int) % nang
    tot = np.bincount(sec, weights=P[mask], minlength=nang)
    frac = tot / tot.sum()
    return float(frac.max() * nang), frac

