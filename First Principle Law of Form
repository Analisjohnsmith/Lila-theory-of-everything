import numpy as np
from scipy.io import wavfile
from scipy.signal import welch

RNG_SEED = 42
SURROGATES = 200
EXCERPT_SEC = 10.0
ALPHA = 0.01
FIT_BAND_HZ = (30.0, 3900.0)

def load_excerpt(path, seconds=EXCERPT_SEC):
    rate, data = wavfile.read(path)
    if data.ndim > 1:
        data = data[:, 0]
    data = data.astype(np.float64)
    n = int(seconds * rate)
    data = data[:n]
    data -= data.mean()
    return rate, data

def hurst_rs(x):
    x = x - x.mean()
    n = len(x)
    lags = np.unique(np.geomspace(8, n // 2, 24).astype(int))
    rs = np.zeros(len(lags))
    for i, lag in enumerate(lags):
        chunks = x[: (n // lag) * lag].reshape(-1, lag)
        mean = chunks.mean(axis=1, keepdims=True)
        dev = np.cumsum(chunks - mean, axis=1)
        R = dev.max(axis=1) - dev.min(axis=1)
        S = chunks.std(axis=1)
        with np.errstate(divide="ignore", invalid="ignore"):
            rs[i] = np.nanmean(np.where(S > 0, R / S, np.nan))
    valid = np.isfinite(rs) & (rs > 0)
    return np.polyfit(np.log(lags[valid]), np.log(rs[valid]), 1)[0]

def spectral_slope(x, rate):
    f, P = welch(x, fs=rate, nperseg=1024)
    mask = (f >= FIT_BAND_HZ[0]) & (f <= FIT_BAND_HZ[1])
    f, P = f[mask], P[mask]
    P = P[P > 0]
    f = f[P > 0] if len(P) else f
    return np.polyfit(np.log(f), np.log(P), 1)[0]

def make_surrogate(x, rng):
    F = np.fft.rfft(x)
    phase = rng.uniform(0.0, 2.0 * np.pi, size=len(F))
    Fs = np.abs(F) * np.exp(1j * phase)
    return np.fft.irfft(Fs, n=len(x))

def main():
    rng = np.random.default_rng(RNG_SEED)
    rate, x = load_excerpt("akhumphi1x.wav")

    print("=" * 66)
    print("LoF-001: Surrogate null-model test on real whale song")
    print("=" * 66)
    print(f"file: akhumphi1x.wav  ({len(x)/rate:.1f} s @ {rate} Hz)")
    print(f"excerpt: {EXCERPT_SEC} s | surrogates: {SURROGATES} | alpha: {ALPHA}")
    print()

    H_real = hurst_rs(x)
    H_surr = np.array([hurst_rs(make_surrogate(x, rng)) for _ in range(SURROGATES)])
    p1 = np.mean(H_surr >= H_real)
    thresh = np.quantile(H_surr, 1.0 - ALPHA)

    print(f"P1: Hurst exponent")
    print(f"  H_real      = {H_real:.4f}")
    print(f"  surrogates  = {H_surr.mean():.4f} +/- {H_surr.std():.4f} "
          f"(99th pct {thresh:.4f})")
    print(f"  empirical p = {p1:.4f}  (H_real > 99th pct of null? {H_real > thresh})")

    n = len(x)
    seg = n // 3
    slopes = [spectral_slope(x[i * seg : (i + 1) * seg], rate) for i in range(3)]
    spread = max(slopes) - min(slopes)
    print()
    print(f"P2: spectral slope stability across 3 sub-windows")
    for i, s in enumerate(slopes):
        print(f"  window {i+1}: slope = {s:.3f}")
    print(f"  spread = {spread:.3f}  (criterion: < 0.5)")

    pass1 = H_real > thresh
    pass2 = spread < 0.5
    print()
    print("=" * 66)
    print(f"P1 (signal > null):     {'PASS' if pass1 else 'FAIL'}")
    print(f"P2 (scale stability):   {'PASS' if pass2 else 'FAIL'}")
    print(f"OVERALL RESULT:         {'PASS' if (pass1 and pass2) else 'FAIL'}")
    print("=" * 66)

if __name__ == "__main__":
    main()
