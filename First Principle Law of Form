        M2_null[i] = m2

    t1 = np.quantile(M1_null, 1.0 - ALPHA)
    t2 = np.quantile(M2_null, 1.0 - ALPHA)
    p1 = np.mean(M1_null >= M1_real)
    p2 = np.mean(M2_null >= M2_real)
    pass1 = M1_real > t1
    pass2 = M2_real > t2

    h, w = img.shape
    mh, mw = h // 2, w // 2
    quads = [img[:mh, :mw], img[:mh, mw:], img[mh:, :mw], img[mh:, mw:]]
    rads, angs = [], []
    for q in quads:
        Pq, xxq, yyq, rq = psd2d(q)
        dp = dominant_peak(Pq, xxq, yyq, rq)
        if dp is None:
            rads.append(np.nan)
            angs.append(np.nan)
        else:
