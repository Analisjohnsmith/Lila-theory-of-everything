import numpy as np

RNG_SEED = 42
NULLS = 200
ALPHA = 0.01
R_MIN = 5
SEP = 6
TOP = 5
BAND = 2
M2_THRESH = 10.0
RAD_SPREAD_MAX = 0.15
ANG_SPREAD_MAX = 15.0

def ideal_lattice(n=512):
    x = np.arange(n)
    X, Y = np.meshgrid(x, x)
    return 0.5 + 0.5 * np.cos(2 * np.pi * 8 * X / n) * np.cos(2 * np.pi * 8 * Y / n)

def psd2d(img):
    h, w = img.shape
    win = np.hanning(h)[:, None] * np.hanning(w)[None, :]
    F = np.fft.fftshift(np.fft.fft2((img - img.mean()) * win))
    P = np.abs(F) ** 2
    yy, xx = np.mgrid[-h // 2:h // 2, -w // 2:w // 2]
    r = np.sqrt(xx ** 2 + yy ** 2)
    return P, xx, yy, r

def local_max_mask(P):
    res = np.ones_like(P, dtype=bool)
    for dy in (-1, 0, 1):
        for dxn in (-1, 0, 1):
            if dy == 0 and dxn == 0:
                continue
            res &= P >= np.roll(np.roll(P, -dy, axis=0), -dxn, axis=1)
    return res

def top_peaks2d(P, xx, yy, r, rmin=R_MIN, sep=SEP, top=TOP):
    lm = local_max_mask(P)
    mask = r >= rmin
    idx = np.argwhere(lm & mask)
    if len(idx) == 0:
        return []
    vals = P[idx[:, 0], idx[:, 1]]
    order = np.argsort(-vals)
    picked = []
    for i in order:
        iy, ix = idx[i]
        v = vals[i]
        if all(np.hypot(iy - jy, ix - jx) >= sep for jy, jx, _ in picked):
            picked.append((iy, ix, float(v)))
        if len(picked) >= top:
            break
    return picked

def annulus_envelope(P, r):
    ri = r.astype(int)
    Rmax = int(r.max()) + 1
    per = np.zeros(Rmax)
    cnt = np.zeros(Rmax)
    np.add.at(per, ri, P)
    np.add.at(cnt, ri, 1)
    env_rad = np.where(cnt > 0, per / np.maximum(cnt, 1), 0.0)
    return env_rad[ri], env_rad

def grf_null(env_rad, rint, rng):
    h, w = rint.shape
    env = np.where(rint >= len(env_rad), env_rad[-1], env_rad[np.clip(rint, 0, len(env_rad) - 1)])
    E = rng.exponential(1.0, size=rint.shape)
    amp = np.sqrt(np.maximum(env * E, 0.0))
    amp[rint == 0] = 0.0
    Fs = amp * np.exp(1j * rng.uniform(0.0, 2.0 * np.pi, size=rint.shape))
    neg = np.ix_(np.mod(-np.arange(h), h), np.mod(-np.arange(w), w))
    Fh = 0.5 * (Fs + np.conj(Fs[neg]))
    return np.fft.ifft2(np.fft.ifftshift(Fh)).real

def metrics(P, xx, yy, r):
    peaks = top_peaks2d(P, xx, yy, r)
    M1 = 0.0
    M2 = 0
    for iy, ix, v in peaks:
        band_m = np.abs(r - r[iy, ix]) <= BAND
        band_m &= r >= R_MIN
        med = np.median(P[band_m])
        ratio = v / med if med > 0 else 0.0
        M1 = max(M1, ratio)
        M2 += int(ratio > M2_THRESH)
    return M1, M2

def analyze(img, rng, label, do_quads=True):
    P, xx, yy, r = psd2d(img)
    _, env_rad = annulus_envelope(P, r)
    M1, M2 = metrics(P, xx, yy, r)
    M1_null = np.zeros(NULLS)
    M2_null = np.zeros(NULLS)
    for i in range(NULLS):
        nimg = grf_null(env_rad, r.astype(int), rng)
        Pn, xxn, yyn, rn = psd2d(nimg)
        m1, m2 = metrics(Pn, xxn, yyn, rn)
        M1_null[i] = m1
        M2_null[i] = m2
    t1 = np.quantile(M1_null, 1.0 - ALPHA)
    t2 = np.quantile(M2_null, 1.0 - ALPHA)
    p1 = float(np.mean(M1_null >= M1))
    p2 = float(np.mean(M2_null >= M2))
    res = "RESONANCE" if M1 > t1 else "no resonance"
    print(f"{label:28s} M1={M1:12.1f}x null99={t1:9.1f} p={p1:.4f} "
          f"[{res:11s}] M2={M2}d vs null99={t2:.0f}")
    if do_quads:
        h, w = img.shape
        mh, mw = h // 2, w // 2
        quads = [img[:mh, :mw], img[:mh, mw:], img[mh:, :mw], img[mh:, mw:]]
        rads, angs = [], []
        for q in quads:
            Pq, xxq, yyq, rq = psd2d(q)
            pk = top_peaks2d(Pq, xxq, yyq, rq, top=1)
            if not pk:
                rads.append(np.nan); angs.append(np.nan)
            else:
                iy, ix, _ = pk[0]
                rads.append(np.hypot(iy, ix))
                angs.append(np.arctan2(iy, ix) % np.pi)
        if any(np.isnan(rads)):
            sr = sa = None
        else:
            sr = (max(rads) - min(rads)) / np.mean(rads)
            sa = np.rad2deg(max(angs) - min(angs))
        return M1, t1, p1, res, M2, sr, sa
    return M1, t1, p1, res, M2, None, None

def main():
