import re
import numpy as np

RNG_SEED = 42
SURROGATES = 200
ORDER = 3
ALPHA = 0.01
LAG = 500
CAP = 30

def load_lengths(path):
    text = open(path, encoding="utf-8", errors="replace").read().lower()
    tokens = re.findall(r"\S+", text)
    z = np.array([min(len(t), CAP) for t in tokens], dtype=np.int64) - 1
    return z

def hurst_rs(x):
    x = x - x.mean()
    n = len(x)
    lags = np.unique(np.geomspace(8, n // 2, 24).astype(int))
    rs = np.zeros(len(lags))
    for i, lag in enumerate(lags):
        chunks = x[: (n // lag) * lag].reshape(-1, lag)
        mean = chunks.mean(axis=1, keepdims=True)
        dev = np.cumsum(chunks - mean, axis=1)
        R = dev.max(axis=1) - dev.min(axis=1)
        S = chunks.std(axis=1)
        with np.errstate(divide="ignore", invalid="ignore"):
            rs[i] = np.nanmean(np.where(S > 0, R / S, np.nan))
    valid = np.isfinite(rs) & (rs > 0)
    return np.polyfit(np.log(lags[valid]), np.log(rs[valid]), 1)[0]

def mutual_information(z, d):
    n = len(z)
    a = z[: n - d]
    b = z[d:]
    H, _, _ = np.histogram2d(a, b, bins=CAP, range=[[0, CAP], [0, CAP]])
    pxy = H / H.sum()
    px = pxy.sum(axis=1, keepdims=True)
    py = pxy.sum(axis=0, keepdims=True)
    m = pxy > 0
    return float(np.sum(pxy[m] * np.log2(pxy[m] / (px @ py)[m])))

def markov_surrogate(z, rng, order=ORDER):
    n = len(z)
    keys = np.zeros(n - order, dtype=np.int64)
    for o in range(order):
        keys += z[o : n - order + o] * (CAP ** (order - 1 - o))
    counts = np.zeros((CAP ** order, CAP), dtype=np.float64)
    np.add.at(counts, (keys, z[order:]), 1.0)
    cum = np.cumsum(counts, axis=1)
    tot = cum[:, -1].copy()
    tot[tot == 0] = 1.0
    out = np.empty(n, dtype=np.int64)
    out[:order] = z[:order]
    for i in range(order, n):
        k = 0
        for o in range(order):
            k = k * CAP + out[i - order + o]
        out[i] = np.searchsorted(cum[k], rng.random() * tot[k])
    return out

def main():
    rng = np.random.default_rng(RNG_SEED)
    path = "/home/deck/Documents/Default Project/am_ki.py"
    try:
        z = load_lengths(path)
    except FileNotFoundError:
        print("DATA MISSING: am_ki.py not found")
        return

    print("=" * 66)
    print("LoF-010: Long-range coherence test on real code (am_ki.py)")
    print("=" * 66)
    print(f"tokens: {len(z):,} | surrogates: {SURROGATES} (order-{ORDER} Markov) "
          f"| alpha: {ALPHA}")
    print()

    H_real = hurst_rs(z)
    MI_real = mutual_information(z, LAG)

    H_surr = np.zeros(SURROGATES)
    MI_surr = np.zeros(SURROGATES)
    for i in range(SURROGATES):
        s = markov_surrogate(z, rng)
        H_surr[i] = hurst_rs(s)
        MI_surr[i] = mutual_information(s, LAG)

    tH = np.quantile(H_surr, 1.0 - ALPHA)
    tMI = np.quantile(MI_surr, 1.0 - ALPHA)
    p1 = np.mean(H_surr >= H_real)
    p2 = np.mean(MI_surr >= MI_real)
    pass1 = H_real > tH
    pass2 = MI_real > tMI

    print(f"REAL: H = {H_real:.4f}, MI({LAG}) = {MI_real:.6f} bits")
