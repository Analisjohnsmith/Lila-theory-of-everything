        ratio = v / med if med > 0 else 0.0
        M1 = max(M1, ratio)
        M2 += int(ratio > M2_THRESH)
    return M1, M2, peaks

def dominant_peak(P, xx, yy, r):
    peaks = top_peaks2d(P, xx, yy, r, top=1)
    if not peaks:
        return None
    iy, ix, _ = peaks[0]
    return np.hypot(iy, ix), (np.arctan2(iy, ix) % np.pi)

def run_signal(name, img, rng):
    print("-" * 66)
    print(f"SIGNAL: {name}  ({img.shape[1]}x{img.shape[0]})")
    P, xx, yy, r = psd2d(img)
    _, env_rad = annulus_envelope(P, r)
    M1_real, M2_real, peaks = metrics(P, xx, yy, r)

    M1_null = np.zeros(NULLS)
    M2_null = np.zeros(NULLS)
    for i in range(NULLS):
        nimg = grf_null(env_rad, r.astype(int), rng)
        Pn, xxn, yyn, rn = psd2d(nimg)
