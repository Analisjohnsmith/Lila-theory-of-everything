ALPHA = 0.01
FIT_BAND_HZ = (30.0, 3900.0)

def load_full(path):
    rate, data = wavfile.read(path)
    if data.ndim > 1:
        data = data[:, 0]
    data = data.astype(np.float64)
    data -= data.mean()
    return rate, data

def hurst_rs(x):
    x = x - x.mean()
    n = len(x)
    lags = np.unique(np.geomspace(8, n // 2, 24).astype(int))
    rs = np.zeros(len(lags))
    for i, lag in enumerate(lags):
        chunks = x[: (n // lag) * lag].reshape(-1, lag)
        mean = chunks.mean(axis=1, keepdims=True)
        dev = np.cumsum(chunks - mean, axis=1)
        R = dev.max(axis=1) - dev.min(axis=1)
        S = chunks.std(axis=1)
        with np.errstate(divide="ignore", invalid="ignore"):
            rs[i] = np.nanmean(np.where(S > 0, R / S, np.nan))
    valid = np.isfinite(rs) & (rs > 0)
    return np.polyfit(np.log(lags[valid]), np.log(rs[valid]), 1)[0]

def spectral_slope(x, rate):
    f, P = welch(x, fs=rate, nperseg=1024)
    mask = (f >= FIT_BAND_HZ[0]) & (f <= FIT_BAND_HZ[1])
    f, P = f[mask], P[mask]
    P = P[P > 0]
    f = f[len(f) - len(P):]
    return np.polyfit(np.log(f), np.log(P), 1)[0]

def make_surrogate(x, rng):
    F = np.fft.rfft(x)
    phase = rng.uniform(0.0, 2.0 * np.pi, size=len(F))
    Fs = np.abs(F) * np.exp(1j * phase)
    return np.fft.irfft(Fs, n=len(x))

