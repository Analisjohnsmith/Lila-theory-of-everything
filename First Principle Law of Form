import csv
import sys

TOL_REL = 1e-3
TOL_ABS = 1e-6

def num(x):
    x = str(x).strip()
    if x == "":
        return None
    try:
        return float(x)
    except ValueError:
        return None

def close(a, b):
    if a is None or b is None:
        return True
    if a == b == 0.0:
        return True
    return abs(a - b) <= max(TOL_ABS, TOL_REL * max(abs(a), abs(b)))

def load(path):
    rows = []
    with open(path, newline="", encoding="utf-8") as f:
        for r in csv.DictReader(f):
            rows.append(r)
    return rows

def main(path):
    rows = load(path)
    gates = [r for r in rows if r["test"] != "LoF-018"]
    imgs = [r for r in rows if r["test"] == "LoF-018"]

    g_match = 0
    diffs = []
    for r in gates:
        exp = r["expected_verdict"].strip()
        rep = (r.get("reported_verdict") or "").strip()
        rm = num(r.get("reported_metric"))
        rn = num(r.get("reported_null99"))
        cm = num(r["recorded_metric"])
        cn = num(r["recorded_null99"])
        ok_v = exp.upper() == rep.upper()
        ok_s = close(rm, cm) and close(rn, cn)
        ok = ok_v and ok_s
        if ok:
            g_match += 1
        else:
            diffs.append(f"  {r['test']} {r['row_id']} {r['desc']}: "
                         f"expected={exp} reported_verdict={rep or '-'} "
                         f"reported_metric={r.get('reported_metric') or '-'} "
                         f"scalar_ok={ok_s}")
    im_match = 0
    n_pass = 0
    for r in imgs:
        exp = r["expected_verdict"].strip()
        rep = (r.get("reported_verdict") or "").strip()
        if exp.upper() == rep.upper():
            im_match += 1
        if rep.upper() == "PASS":
            n_pass += 1
        if exp.upper() != rep.upper() or not close(num(r.get("reported_metric")), num(r["recorded_metric"])):
            diffs.append(f"  LoF-018 {r['row_id']} {r['desc']}: expected={exp} "
                         f"reported={rep or '-'} metric={r.get('reported_metric') or '-'}")

    ok17 = g_match == len(gates)
    ok_img = im_match >= 20
    ok_count = abs(n_pass - 11) <= 3

    print("=" * 78)
    print("LoF-023 replication scoring")
    print("=" * 78)
    print(f"17 binary gates:     {g_match}/{len(gates)} reproduced "
          f"({'PASS' if ok17 else 'FAIL'})")
    print(f"LoF-018 image verdicts: {im_match}/23 match "
          f"({'PASS' if ok_img else 'FAIL'}) | reported PASS count = {n_pass} "
          f"(recorded 11; +-3 allowed {'PASS' if ok_count else 'FAIL'})")
    if diffs:
        print("Diffs:")
        for d in diffs:
            print(d)
    verdict = "SUCCESS" if (ok17 and ok_img and ok_count) else "PARTIAL" if diffs else "SUCCESS"
    if not diffs:
        verdict = "SUCCESS"
    else:
        verdict = "SUCCESS" if (ok17 and ok_img and ok_count) else "PARTIAL/FAILED"
    print("=" * 78)
    print(f"LoF-023 verdict: {verdict}")
    print("=" * 78)
    return 0 if verdict == "SUCCESS" else 1

if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "replication_results.csv"))
