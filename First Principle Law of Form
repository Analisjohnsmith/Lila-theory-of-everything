def psd1d(x, sr=SR, fmin=FMIN, fmax=FMAX):
    f, P = welch(x, fs=sr, nperseg=NPERSEG)
    m = (f >= fmin) & (f <= fmax)
    return f[m], P[m]

def top_peaks(P, sep=SEP, top=TOP):
    cand = []
    for i in range(1, len(P) - 1):
        if P[i] > P[i - 1] and P[i] > P[i + 1]:
            cand.append((i, P[i]))
    cand.sort(key=lambda t: -t[1])
    picked = []
    for i, v in cand:
        if all(abs(i - j) >= sep for j, _ in picked):
            picked.append((i, v))
        if len(picked) >= top:
            break
    return picked

def metrics(P, f):
    peaks = top_peaks(P)
    M1 = 0.0
    for i, v in peaks:
        band = np.abs(f - f[i]) <= BAND_HZ
        med = np.median(P[band])
        ratio = v / med if med > 0 else 0.0
        M1 = max(M1, ratio)
    return M1

def smooth_env(P, win=ENV_WIN):
    return np.convolve(P, np.ones(win) / win, mode="same")

def surrogate(x, f, P, rng):
    env = smooth_env(P)
    n = len(x)
    freqs = np.fft.rfftfreq(n, d=1.0 / SR)
    idx = np.clip(np.searchsorted(f, freqs), 0, len(env) - 1)
    base = np.maximum(env[idx], 0.0)
    E = rng.exponential(1.0, size=len(freqs))
    amp = np.sqrt(base * E)
    amp[(freqs < FMIN) | (freqs > FMAX)] = 0.0
    amp[0] = 0.0
    ph = rng.uniform(0.0, 2.0 * np.pi, size=len(freqs))
    return np.fft.irfft(amp * np.exp(1j * ph), n=n)

