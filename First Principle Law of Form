def make_map(ra, dec, tr, n=N):
    x = (ra - tr["ra_min"]) / tr["ra_span"]
    y = (dec - tr["dec_min"]) / tr["dec_span"]
    H, _, _ = np.histogram2d(y, x, bins=n)
    return H

def psd2d(img):
    h, w = img.shape
    win = np.hanning(h)[:, None] * np.hanning(w)[None, :]
    F = np.fft.fftshift(np.fft.fft2((img - img.mean()) * win))
    P = np.abs(F) ** 2
    yy, xx = np.mgrid[-h // 2:h // 2, -w // 2:w // 2]
    r = np.sqrt(xx ** 2 + yy ** 2)
    return P, xx, yy, r

def annulus_profile(P, r):
    ri = r.astype(int)
    Rmax = int(r.max()) + 1
    per = np.zeros(Rmax)
    cnt = np.zeros(Rmax)
    np.add.at(per, ri, P)
    np.add.at(cnt, ri, 1)
    return per / np.maximum(cnt, 1)

def radial_slope(P, r, rmin=R_MIN, rmax=R_MAX):
    prof = annulus_profile(P, r)
    rings = np.arange(rmin, rmax + 1)
    x = np.log(rings)
    y = np.log(prof[rings])
    ok = np.isfinite(y)
    if ok.sum() < 3:
        return 0.0
    return float(np.polyfit(x[ok], y[ok], 1)[0])

