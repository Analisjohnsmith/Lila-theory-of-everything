import os
import numpy as np
from scipy.io import wavfile
from scipy.signal import welch

RNG_SEED = 42
NULLS = 200
ALPHA = 0.01
NPERSEG = 2048
F_MIN, F_MAX = 50.0, 3800.0
SEP = 4
TOP = 5
BAND_HZ = 100.0
M2_THRESH = 10.0
ENV_WIN = 30

def tone():
    sr = 8000
    t = np.arange(int(sr * 2.0)) / sr
    x = (np.sin(2 * np.pi * 440 * t) + 0.3 * np.sin(2 * np.pi * 880 * t)
         + 0.15 * np.sin(2 * np.pi * 1320 * t)) * np.exp(-t / 4.0)
    return sr, x

def load_wave(path):
    sr, data = wavfile.read(path)
    if data.ndim > 1:
        data = data[:, 0]
    return sr, data.astype(np.float64)

def psd1d(x, sr):
    f, P = welch(x, fs=sr, nperseg=NPERSEG)
    m = (f >= F_MIN) & (f <= F_MAX)
    return f[m], P[m]

def top_peaks(P, sep=SEP, top=TOP):
    cand = []
    for i in range(1, len(P) - 1):
        if P[i] > P[i - 1] and P[i] > P[i + 1]:
            cand.append((i, P[i]))
    cand.sort(key=lambda t: -t[1])
    picked = []
    for i, v in cand:
        if all(abs(i - j) >= sep for j, _ in picked):
            picked.append((i, v))
        if len(picked) >= top:
            break
    return picked

def metrics(P, f):
    peaks = top_peaks(P)
    M1 = 0.0
    M2 = 0
    for i, v in peaks:
        band = np.abs(f - f[i]) <= BAND_HZ
        med = np.median(P[band])
        ratio = v / med if med > 0 else 0.0
        M1 = max(M1, ratio)
        M2 += int(ratio > M2_THRESH)
    return M1, M2

def smooth_env(P, win=ENV_WIN):
    return np.convolve(P, np.ones(win) / win, mode="same")

def surrogate(x, f, P, sr, rng):
    env = smooth_env(P)
    n = len(x)
    freqs_full = np.fft.rfftfreq(n, d=1.0 / sr)
    idx = np.searchsorted(f, freqs_full)
    idx = np.clip(idx, 0, len(env) - 1)
    amp = np.sqrt(np.maximum(env[idx], 0.0))
    amp[freqs_full < F_MIN] = 0.0
    amp[freqs_full > F_MAX] = 0.0
    ph = rng.uniform(0.0, 2.0 * np.pi, size=len(freqs_full))
    return np.fft.irfft(amp * np.exp(1j * ph), n=n)

def run_signal(name, sr, x, rng):
    print("-" * 66)
    print(f"SIGNAL: {name}  ({len(x)/sr:.1f} s @ {sr} Hz)")
    f, P = psd1d(x, sr)
    M1_real, M2_real = metrics(P, f)
    M1_null = np.zeros(NULLS)
    M2_null = np.zeros(NULLS)
    for i in range(NULLS):
        s = surrogate(x, f, P, sr, rng)
        fs, Ps = psd1d(s, sr)
        m1, m2 = metrics(Ps, fs)
        M1_null[i] = m1
        M2_null[i] = m2
    t1 = np.quantile(M1_null, 1.0 - ALPHA)
    p1 = np.mean(M1_null >= M1_real)
    pass1 = M1_real > t1
    print(f"  P1 (decisive): M1 real={M1_real:.2f}x "
          f"null={M1_null.mean():.2f}+/-{M1_null.std():.2f} "
          f"(99th {t1:.2f}) p={p1:.4f} -> {'PASS' if pass1 else 'FAIL'}")
    ceil = int(np.quantile(M2_null, 1.0 - ALPHA))
    note = ""
    if M2_real >= ceil and M2_real >= 5:
        note = "  [M2 saturated/indeterminate per amendment]"
    print(f"  P2 (secondary): M2 real={M2_real} "
          f"null={M2_null.mean():.2f}+/-{M2_null.std():.2f} "
          f"(99th {ceil}) -> reported only{note}")
    print(f"  OVERALL (decisive P1): {'PASS' if pass1 else 'FAIL'}")
    return pass1

def main():
    rng = np.random.default_rng(RNG_SEED)
    print("=" * 66)
    print("LoF-009: 1D harmonic-resonance operator test")
    print("=" * 66)
    sr1, x1 = tone()
    ok_control = run_signal("A. POSITIVE CONTROL: tuning-fork-like tone (generated)", sr1, x1, rng)
    print(f"  >> control must PASS P1 (method validation): "
          f"{'OK' if ok_control else 'METHOD BROKEN'}")
    sr2, x2 = load_wave("akhumphi1x.wav")
    ok_real = run_signal("B. REAL: humpback whale call (akhumphi1x.wav)", sr2, x2, rng)
    print(f"  >> real whale overall: {'PASS' if ok_real else 'FAIL'}")
    print("=" * 66)

if __name__ == "__main__":
    main()
