    key.cone_angle = 60; key.exponent = 10
    fill = pv.Light(light_type="scene light", intensity=0.45, color="#7fb8ff")
    fill.position = (-8.0, -6.0, 2.0); fill.positional = True
    rim = pv.Light(light_type="scene light", intensity=0.8, color="#ffb37f")
    rim.position = (-2.0, 8.0, -4.0); rim.positional = True
    for l in (key, fill, rim):
        pl.add_light(l)

    # fractal floor (color-charge lattice)
    floor = []
    sierpinski([0, Rf * 1.0, -gen_h / 2], [-Rf * 0.95, -Rf * 0.52, -gen_h / 2],
               [Rf * 0.95, -Rf * 0.52, -gen_h / 2], 4, floor)
    for a, b in floor:
        add_tube(pl, a, b, 0.004, "#7a6bff", alpha=0.16)

    # interaction spokes
    for p in list(tet) + list(gluons):
