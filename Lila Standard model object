    for line in text.splitlines():
        result = []
        escaped = False

        for ch in line:
            if ch == "%" and not escaped:
                break

            result.append(ch)

            if ch == "\\":
                escaped = not escaped
            else:
                escaped = False

        output.append("".join(result))

    return "\n".join(output)


def extract_math(text: str) -> str:
    """
    Extract the first recognized mathematical environment.
    """

    text = remove_tex_comments(text)

    patterns = [
        r"\\begin\s*\{\s*math\s*\}(.*?)\\end\s*\{\s*math\s*\}",
        r"\\begin\s*\{\s*equation\*?\s*\}(.*?)\\end\s*\{\s*equation\*?\s*\}",
        r"\\\[(.*?)\\\]",
        r"\$\$(.*?)\$\$",
    ]

    for pattern in patterns:
        match = re.search(
            pattern,
            text,
            flags=re.DOTALL,
        )

        if match:
            return match.group(1).strip()

    return text.strip()


def normalize_source(expr: str) -> str:
    """
    Keep mathematical content but normalize irrelevant whitespace.
    """

    expr = expr.replace("\r\n", "\n")
    expr = expr.replace("\r", "\n")

    # Collapse horizontal whitespace.
    expr = re.sub(r"[ \t]+", " ", expr)

    return expr.strip()


# ============================================================
# TOP-LEVEL TERM PARSER
# ============================================================

def is_escaped(text: str, index: int) -> bool:
    """
    Determine whether character at index is escaped.
    """

    backslashes = 0
    i = index - 1

    while i >= 0 and text[i] == "\\":
        backslashes += 1
        i -= 1

    return (backslashes % 2) == 1


def split_top_level_terms(expr: str) -> list[dict]:
    """
    Split:

        A - B + C

    while protecting nested:

        {...}
        [...]
        (...)
        \frac{...}{...}
        \pm
        escaped characters

    Each result contains:
        source
        sign
        body
        start
        end
    """

    terms = []

    brace_depth = 0
    bracket_depth = 0
    paren_depth = 0

    current_start = 0
    current_sign = "+"

    i = 0

    while i < len(expr):
        ch = expr[i]

        if ch == "{" and not is_escaped(expr, i):
            brace_depth += 1

        elif ch == "}" and not is_escaped(expr, i):
            brace_depth -= 1

        elif ch == "[" and not is_escaped(expr, i):
            bracket_depth += 1

        elif ch == "]" and not is_escaped(expr, i):
            bracket_depth -= 1

        elif ch == "(" and not is_escaped(expr, i):
            paren_depth += 1

        elif ch == ")" and not is_escaped(expr, i):
            paren_depth -= 1

        elif (
            ch in "+-"
            and brace_depth == 0
            and bracket_depth == 0
            and paren_depth == 0
            and not is_escaped(expr, i)
        ):
            # Do not split \pm or similar command content.
            previous_char = expr[i - 1] if i > 0 else ""

            if previous_char == "\\":
                i += 1
                continue

            body_start = current_start

            if body_start < i:
                raw = expr[body_start:i].strip()

                if raw:
                    # The first character belongs to the term's sign.
                    if raw[0] in "+-":
                        raw_body = raw[1:].strip()
                    else:
                        raw_body = raw

                    terms.append(
                        {
                            "sign": current_sign,
                            "body": raw_body,
                            "source": current_sign + raw_body,
                            "start": current_start,
                            "end": i,
                        }
                    )

            current_sign = ch
            current_start = i + 1

        i += 1

    if current_start < len(expr):
        raw = expr[current_start:].strip()

        if raw:
            if raw[0] in "+-":
                raw_body = raw[1:].strip()
            else:
                raw_body = raw

            terms.append(
                {
                    "sign": current_sign,
                    "body": raw_body,
                    "source": current_sign + raw_body,
                    "start": current_start,
                    "end": len(expr),
                }
            )

    return terms


# ============================================================
# SOURCE ANALYSIS
# ============================================================

FIELD_PATTERNS = [
    r"\\bar\s*\{?([A-Za-z][A-Za-z0-9]*)",
    r"\\([A-Za-z][A-Za-z0-9]*)",
    r"(?<![A-Za-z\\])([A-Za-z][A-Za-z0-9]*)",
]


def extract_symbols(term: str) -> list[str]:
    """
    Extract recognizable symbolic tokens while preserving
    the original source unchanged.
    """

    symbols = set()

    for pattern in FIELD_PATTERNS:
        for match in re.finditer(pattern, term):
            token = match.group(1)

            if token not in {
                "begin",
                "end",
                "mathrm",
                "mathbf",
                "mathcal",
                "mathfrak",
                "partial",
                "nabla",
                "cdot",
                "times",
                "frac",
                "sqrt",
                "left",
                "right",
                "text",
                "operatorname",
            }:
                symbols.add(token)

    return sorted(symbols)


def extract_derivatives(term: str) -> list[str]:
    matches = re.findall(
        r"\\(?:partial|nabla)"
        r"(?:_\{([^}]*)\}|_([A-Za-z0-9]+))?"
        r"(?:\^\{([^}]*)\}|\^([A-Za-z0-9]+))?",
        term,
    )

    result = []

    for groups in matches:
        result.append(
            "".join(
                x for x in groups
                if x
            )
        )

    return result


def extract_indices(term: str) -> list[str]:
    """
    Collect subscript/superscript content.

    This is source analysis, not a claim of full tensor semantics.
    """

    values = []

    for match in re.finditer(
        r"[_^]\{([^{}]+)\}",
        term,
    ):
        values.append(match.group(1))

    return sorted(set(values))


def has_conjugation(term: str) -> bool:
    return any(
        token in term
        for token in (
            r"\bar",
            r"\dagger",
            r"^\ast",
            r"^*",
            r"\conj",
        )
    )


def classify_term(term: str) -> str:
    """
    Structural classification only.
    """

    compact = re.sub(r"\s+", "", term)

    if r"\partial" in compact:
        if (
            "g" in compact
            or "W" in compact
            or "Z" in compact
            or "A" in compact
        ):
            return "derivative_gauge"

        return "derivative"

    if "f^{" in compact or "f^{abc}" in compact:
        return "gauge_structure"

    if any(
        x in compact
        for x in (
            "g_s",
            "g_{s}",
            "e",
            "g",
        )
    ):
        if any(
            x in compact
            for x in (
                "g^a",
                "g^{a}",
                "W",
                "Z",
                "A",
            )
        ):
            return "gauge"

    if any(
        x in compact
        for x in (
            "H",
            "phi",
            "\\phi",
        )
    ):
        return "higgs_goldstone"

    if any(
        x in compact
        for x in (
            "\\bar{e}",
            "\\bar{u}",
            "\\bar{d}",
            "\\bar{nu}",
            "\\bar\\nu",
        )
    ):
        return "fermion"

    if any(
        x in compact
        for x in (
            "X^+",
            "X^-",
            "X^0",
            "Y",
        )
    ):
        return "extended_sector"

    if any(
        x in compact
        for x in (
            "ghost",
            "G^a",
            "G^{a}",
        )
    ):
        return "ghost"

    return "interaction"


# ============================================================
# INVERSION OPERATORS
# ============================================================

def invert_sign(sign: str) -> str:
    if sign == "+":
        return "-"

    if sign == "-":
        return "+"

    raise ValueError(f"Unknown sign: {sign}")


def invert_derivatives(text: str) -> str:
    """
    Explicit derivative-orientation marker.

    This does not silently claim a physical tensor operation.
    It produces a distinct mathematical source representation.
    """

    return re.sub(
        r"\\partial",
        r"\\widetilde{\\partial}",
        text,
    )


def invert_indices(text: str) -> str:
    """
    Explicit index-inversion wrapper.

    Kept reversible and source-traceable.
    """

    return (
        r"\mathop{\mathrm{IndexInvert}}\limits_{"
        + text
        + "}"
    )


def invert_field_charge(text: str) -> str:
    """
    Explicit charge-inversion wrapper.
    """

    return (
        r"\mathop{\mathrm{ChargeInvert}}\limits_{"
        + text
        + "}"
    )


def invert_conjugation(text: str) -> str:
    """
    Explicit conjugation-inversion wrapper.
    """

    return (
        r"\mathop{\mathrm{ConjugationInvert}}\limits_{"
        + text
        + "}"
    )


def invert_couplings(text: str) -> str:
    """
    Explicit coupling-inversion wrapper.

    The exact coupling map is intentionally not guessed.
    """

    return (
        r"\mathop{\mathrm{CouplingInvert}}\limits_{"
        + text
        + "}"
    )


# ============================================================
# TERM INVERSION
# ============================================================

def invert_term(
    sign: str,
    body: str,
    rules: InversionRules,
) -> dict:
    """
    Invert exactly one source term.
    """

    transformed_body = body
    actions = []

    # --------------------------------------------------------
    # INTERNAL STRUCTURE
    # --------------------------------------------------------

    if rules.preserve_internal_structure:
        actions.append(
            "preserve_internal_structure"
        )

    # --------------------------------------------------------
    # DERIVATIVES
    # --------------------------------------------------------

    if rules.invert_derivative_orientation:
        transformed_body = invert_derivatives(
            transformed_body
        )

        actions.append(
            "invert_derivative_orientation"
        )

    # --------------------------------------------------------
    # INDICES
    # --------------------------------------------------------

    if rules.invert_index_position:
        transformed_body = invert_indices(
            transformed_body
        )

        actions.append(
            "invert_index_position"
        )

    # --------------------------------------------------------
    # FIELD CHARGE
    # --------------------------------------------------------

    if rules.invert_field_charge:
        transformed_body = invert_field_charge(
            transformed_body
        )

        actions.append(
            "invert_field_charge"
        )

    # --------------------------------------------------------
    # CONJUGATION
    # --------------------------------------------------------

    if rules.invert_conjugation:
        transformed_body = invert_conjugation(
            transformed_body
        )

        actions.append(
            "invert_conjugation"
        )

    # --------------------------------------------------------
    # COUPLINGS
    # --------------------------------------------------------

    if rules.invert_couplings:
        transformed_body = invert_couplings(
            transformed_body
        )

        actions.append(
            "invert_couplings"
        )

    # --------------------------------------------------------
    # TERM SIGN
    # --------------------------------------------------------

    inverted_sign = sign

    if rules.invert_term_signs:
        inverted_sign = invert_sign(sign)

        actions.append(
            "invert_term_sign"
        )

    return {
        "original_sign": sign,
        "original_body": body,
        "original_source": sign + body,
        "inverted_sign": inverted_sign,
        "inverted_body": transformed_body,
        "inverted_source": inverted_sign + transformed_body,
        "actions": actions,
    }


# ============================================================
# BUILD COMPLETE SOURCE RECORD
# ============================================================

def build_term_records(
    expression: str,
    rules: InversionRules,
) -> list[dict]:

    raw_terms = split_top_level_terms(
        expression
    )

    records = []

    for i, raw in enumerate(
        raw_terms,
        start=1,
    ):

        sign = raw["sign"]
        body = raw["body"]

        inversion = invert_term(
            sign,
            body,
            rules,
        )

        record = {
            "term_id": f"T{i:04d}",

            # Exact source location.
            "source_span": {
                "start": raw["start"],
                "end": raw["end"],
            },

            # Exact source.
            "source": {
                "sign": sign,
                "body": body,
                "expression": sign + body,
            },

            # Source analysis.
            "analysis": {
                "classification":
                    classify_term(body),

                "symbols":
                    extract_symbols(body),

                "derivatives":
                    extract_derivatives(body),

                "indices":
                    extract_indices(body),

                "has_conjugation":
                    has_conjugation(body),
            },

            # Explicit inversion.
            "inversion": inversion,
        }

        records.append(record)

    return records


# ============================================================
# FULL OBJECT
# ============================================================

def build_inversion_object(
    source_text: str,
    expression: str,
    records: list[dict],
) -> dict:

    expression_hash = hashlib.sha256(
        expression.encode("utf-8")
    ).hexdigest()

    return {
        "object": {
            "name": "Līlā",
            "identifier": "LILA",
        },

        "source": {
            "file": str(INPUT_FILE),
            "sha256": expression_hash,
            "term_count": len(records),
            "expression": expression,
        },

        "inversion_rules": asdict(RULES),

        "terms": records,

        "closure": {
            "source_preserved": True,
            "one_to_one_term_mapping": True,
            "invented_source_terms": 0,
        },
    }


# ============================================================
# INVERTED LATEX
# ============================================================

def render_inverted_tex(records: list[dict]) -> str:

    lines = [
        r"\begin{math}"
    ]

    for record in records:

        lines.append(
            record["inversion"]["inverted_source"]
        )

    lines.append(
        r"\end{math}"
    )

    return "\n".join(lines)


# ============================================================
# SOURCE-PRESERVING CHECK
# ============================================================

def verify_term_count(
    records: list[dict],
) -> None:

    if not records:
        raise RuntimeError(
            "No Lagrangian terms were extracted."
        )

    for record in records:

        original = record[
            "inversion"
        ]["original_source"]

        if not original:
            raise RuntimeError(
                f"Empty source term: "
                f"{record['term_id']}"
            )


# ============================================================
# MAIN
# ============================================================

def main():

    if not INPUT_FILE.exists():
        raise FileNotFoundError(
            f"Missing source file: {INPUT_FILE}"
        )

    source_text = INPUT_FILE.read_text(
        encoding="utf-8"
    )

    expression = normalize_source(
        extract_math(source_text)
    )

    if not expression:
        raise RuntimeError(
            "The Lagrangian source is empty."
        )

    records = build_term_records(
        expression,
        RULES,
    )

    verify_term_count(records)

    obj = build_inversion_object(
        source_text,
        expression,
        records,
    )

    OUTPUT_JSON.write_text(
        json.dumps(
            obj,
            indent=2,
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )

    OUTPUT_TEX.write_text(
        render_inverted_tex(records),
        encoding="utf-8",
    )

    print()
    print("LĪLĀ TERM-BY-TERM INVERSION")
    print("==========================")
    print(
        f"Source terms : "
        f"{len(records)}"
    )
    print(
        f"Source SHA256: "
        f"{obj['source']['sha256']}"
    )
    print(
        f"Output JSON  : "
        f"{OUTPUT_JSON}"
    )
    print(
        f"Output TeX   : "
        f"{OUTPUT_TEX}"
    )
    print()

    for record in records:
        print(
            f"{record['term_id']} "
            f"{record['analysis']['classification']} "
            f"-> "
            f"{', '.join(record['inversion']['actions'])}"
        )


if __name__ == "__main__":
    main()
