        sub = tri.mean(axis=0)
        add_sphere(pl, sub, 0.095, "#f4f4ff", metallic=0.3, roughness=0.3,
                   emissive=0.1)
        add_sphere(pl, sub, 0.14, "#ffffff", metallic=0.0, roughness=0.5,
                   emissive=0.12, alpha=0.35)
        m01 = (tri[0] + tri[1]) / 2; m12 = (tri[1] + tri[2]) / 2; m20 = (tri[2] + tri[0]) / 2
        for m in (m01, m12, m20):
            add_sphere(pl, m, 0.03, c, metallic=0.5, roughness=0.3, emissive=0.2)

    # camera
