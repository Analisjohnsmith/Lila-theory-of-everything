    # tetrahedron edges
    for i in range(4):
        for j in range(i + 1, 4):
            add_tube(pl, tet[i], tet[j], 0.009, "#ffcf6a", alpha=0.35)

    # generation triangles: perimeter + sierpinski
    for g in range(3):
        tri = generations[g]
        c = gen_colors[g]
        # perimeter
        for k in range(3):
            add_tube(pl, tri[k], tri[(k + 1) % 3], 0.012, c, alpha=0.95)
        # fractal recursion
        lines = []
        sierpinski(tri[0], tri[1], tri[2], 2, lines)
        for a, b in lines[:48]:
            add_tube(pl, a, b, 0.004, "#dce6ff", alpha=0.30)

    # particles
    add_sphere(pl, (0, 0, 0), 0.24, "#ffc94d", metallic=0.9, roughness=0.15,
               emissive=0.45, specular=1.0, specular_power=120)          # Higgs
    add_sphere(pl, (0, 0, 0), 0.34, "#fff3c4", metallic=0.0, roughness=0.4,
               emissive=0.25, alpha=0.35)                                # Higgs halo

    for c, p in zip(gluon_colors, gluons):                               # 8 gluons
        add_sphere(pl, p, 0.075, c, metallic=0.6, roughness=0.25, specular=0.95)

    for c, p, nm in zip(ew_colors, tet, ew_names):                       # W/Z/gamma
