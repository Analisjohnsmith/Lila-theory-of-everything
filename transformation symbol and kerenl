\section*{Layer 13: Phase Space Partition}

% Define full phase space


\[
\mathcal{P} = \{(r,\theta) \mid r \ge 0,\ \theta \in [0,2\pi)\},
\]



% Partition into two invariant regions


\[
\mathcal{P}_1 = \{(r,\theta) \mid \theta \in [0,\pi)\},
\qquad
\mathcal{P}_2 = \{(r,\theta) \mid \theta \in [\pi,2\pi)\}.
\]



% Boundary between lobes


\[
\partial\mathcal{P}_1 = \partial\mathcal{P}_2 = \{\theta = 0,\pi\}.
\]



\section*{Layer 14: Measure and Probability}

% Define probability density over the symbol


\[
\int_{\mathcal{P}} \rho(r,\theta)\, r\, dr\, d\theta = 1,
\]



% Each lobe carries equal measure


\[
\int_{\mathcal{P}_1} \rho(r,\theta)\, r\, dr\, d\theta
=
\int_{\mathcal{P}_2} \rho(r,\theta)\, r\, dr\, d\theta
= \frac{1}{2}.
\]



