const PHI: f64 = 1.618033988749895;

/// Generate a spiral of `n` points in Cartesian coordinates.
pub fn spiral_points(n: usize, r0: f64, theta0: f64) -> Vec<(f64, f64)> {
    (0..n)
        .scan((r0, theta0), |state, _| {
            let (r, theta) = *state;
            let x = r * theta.cos();
            let y = r * theta.sin();
            state.0 *= PHI;
            state.1 += PHI;
            Some((x, y))
        })
        .collect()
