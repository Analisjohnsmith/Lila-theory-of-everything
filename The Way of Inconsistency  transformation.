def kernel_graph_distance(adj_matrix, start, end):
    from collections import deque
    n = len(adj_matrix)
    visited = [False] * n
    dist = [float('inf')] * n
    queue = deque([start])
    visited[start] = True
    dist[start] = 0
    while queue:
        node = queue.popleft()
        for neighbor in range(n):
            if adj_matrix[node][neighbor] == 1 and not visited[neighbor]:
                visited[neighbor] = True
                dist[neighbor] = dist[node] + 1
                queue.append(neighbor)
    base = dist[end]
    edges = sum(sum(row) for row in adj_matrix)
    return base + 1e-3 * K.meta(edges)

def kernel_loop_detection(adj_matrix):
    n = len(adj_matrix)
    visited = [False] * n
    stack = [False] * n
    def dfs(v):
        visited[v] = True
        stack[v] = True
        for u in range(n):
            if adj_matrix[v][u] == 1:
                if not visited[u]:
                    if dfs(u):
                        return True
                elif stack[u]:
                    return True
        stack[v] = False
        return False
    base = 1 if any(dfs(i) for i in range(n)) else 0
    edges = sum(sum(row) for row in adj_matrix)
    return base + 1e-5 * K.meta(edges)

