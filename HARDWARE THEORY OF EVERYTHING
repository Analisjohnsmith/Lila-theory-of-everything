# RUN DEMO
# ------------------------------------------------------------

if __name__ == "__main__":
    obj = UnifiedHardwareObject()

    # All five projections
    obj.plot_topological()
    obj.plot_dynamical()
    obj.plot_algebraic()
    obj.plot_physical()
    obj.plot_unified()

    # Run a full hardware cycle
    print(f"Initial collapse: {obj.collapse_total:.4f}")
    for i in range(5):
        obj.full_cycle_step()
        print(f"Cycle {i+1} collapse: {obj.collapse_total:.4f}")
