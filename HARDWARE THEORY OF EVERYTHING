## Complete UnifiedHardwareObject — Upgraded Operad Kernel (Zero Loss)

```python
import numpy as np
import networkx as nx
import matplotlib.pyplot as plt


class UnifiedHardwareObject:
    """
    Complete hardware object — upgraded operad kernel.
    No loss. Everything integrated.
    """

    def __init__(self, shells=(1.0, 2.0, 3.5, 5.0), density=(6, 12, 24, 48)):
        self.shells = shells
        self.density = density

        self.G = nx.Graph()
        self.positions = {}
        self.layers = {}

        # Build everything in sequence
        self._build_shells()
        self.build_operad_kernel()
        self.initialize_state()
        self.initialize_energy()
        self.compute_action()
        self.compute_collapse_field()
        self.global_collapse()

    # ------------------------------------------------------------
    # 1. SUBSTRATE MANIFOLD (CW-complex)
    # ------------------------------------------------------------

    def _build_shells(self):
        node_id = 0

        for layer_idx, (radius, count) in enumerate(zip(self.shells, self.density)):
            angles = np.linspace(0, 2*np.pi, count, endpoint=False)
            layer_nodes = []

            for a in angles:
                x = radius * np.cos(a)
                y = radius * np.sin(a)

                self.G.add_node(node_id)
                self.positions[node_id] = (x, y)
                self.layers[node_id] = layer_idx
                layer_nodes.append(node_id)

                node_id += 1

            # Geodesic adjacency within shell (ring)
            for i, u in enumerate(layer_nodes):
                v = layer_nodes[(i + 1) % len(layer_nodes)]
                self.G.add_edge(u, v)

            # Geodesic adjacency to previous shell
            if layer_idx > 0:
                prev_nodes = [n for n in self.G.nodes() if self.layers[n] == layer_idx - 1]

                for u in layer_nodes:
                    px, py = self.positions[u]
                    nearest = min(
                        prev_nodes,
                        key=lambda p: (self.positions[p][0] - px)**2 +
                                      (self.positions[p][1] - py)**2
                    )
                    self.G.add_edge(u, nearest)

    # ------------------------------------------------------------
    # 2. OPERAD KERNEL ALGEBRA (UPGRADED)
    # ------------------------------------------------------------

    def build_operad_kernel(self):
        """
        Upgraded operad kernel:
        - Each node gets a 3D operator vector O(n) = [layer, degree, curvature]
        - Curvature derived from neighbor layer differences
        """
        kernel = {}

        for n in self.G.nodes():
            layer = self.layers[n]
            degree = self.G.degree[n]
            neighbors = list(self.G.neighbors(n))

            # Local curvature: mean absolute layer difference to neighbors
            if neighbors:
                curv = np.mean([abs(self.layers[u] - layer) for u in neighbors])
            else:
                curv = 0.0

            # Operator vector: [layer+1, degree, curvature]
            kernel[n] = np.array([layer + 1.0, degree, curv], dtype=float)

        self.kernel = kernel

    def compose_kernel(self, u, v):
        """
        Operad composition: O(u) ∘ O(v)
        = elementwise product + cross term (dot product)
        """
        Ou = self.kernel[u]
        Ov = self.kernel[v]
        return Ou * Ov + np.dot(Ou, Ov)

    def kernel_magnitude(self, n):
        """Magnitude of local operator (Euclidean norm)"""
        return np.linalg.norm(self.kernel[n])

    # ------------------------------------------------------------
    # 3. UNIFIED KERNEL DYNAMICS
    # ------------------------------------------------------------

    def initialize_state(self):
        """Initialize node state field"""
        self.state = {}
        for n in self.G.nodes():
            self.state[n] = 1.0 / (1 + self.layers[n])

    def kernel_update(self, n):
        """
        Local update rule:
        S'(n) = S(n) + 0.1 * sum(composed kernel magnitudes over neighbors)
        """
        neighbors = list(self.G.neighbors(n))
        base = self.state[n]

        influence = 0.0
        for u in neighbors:
            O_comp = self.compose_kernel(n, u)
            influence += np.linalg.norm(O_comp)

        return base + 0.1 * influence

    def step(self):
        """Global synchronous dynamics step"""
        new_state = {}
        for n in self.G.nodes():
            new_state[n] = self.kernel_update(n)
        self.state = new_state

    # ------------------------------------------------------------
    # 4. ACTION FUNCTIONAL PHYSICS
    # ------------------------------------------------------------

    def initialize_energy(self):
        """
        Local energy density E(n):
        = kernel_magnitude(n) + (layer+1)^2
        """
        self.energy = {}
        for n in self.G.nodes():
            self.energy[n] = self.kernel_magnitude(n) + (self.layers[n] + 1)**2

    def edge_curvature(self, u, v):
        """
        Curvature cost between nodes:
        C(u,v) = |E(u) - E(v)| + geodesic distance
        """
        x1, y1 = self.positions[u]
        x2, y2 = self.positions[v]

        geo = np.sqrt((x1 - x2)**2 + (y1 - y2)**2)
        diff = abs(self.energy[u] - self.energy[v])

        return diff + geo

    def compute_action(self):
        """Global action functional: sum of edge curvatures"""
        total = 0.0
        for u, v in self.G.edges():
            total += self.edge_curvature(u, v)
        self.action = total
        return total

    def physical_step(self):
        """
        Physical update:
        E(n) += 0.05 * sum(curvature to neighbors)
        """
        new_energy = {}
        for n in self.G.nodes():
            neighbors = list(self.G.neighbors(n))
            accum = sum(self.edge_curvature(n, u) for u in neighbors)
            new_energy[n] = self.energy[n] + 0.05 * accum
        self.energy = new_energy

    # ------------------------------------------------------------
    # 5. UNIFIED COLLAPSE OPERATOR
    # ------------------------------------------------------------

    def compute_collapse_field(self):
        """
        Unified collapse field:
        C(n) = 1.0*state(n) + 0.5*energy(n) + 0.25*kernel_magnitude(n)
        """
        collapse = {}
        alpha, beta, gamma = 1.0, 0.5, 0.25

        for n in self.G.nodes():
            collapse[n] = alpha * self.state[n] + beta * self.energy[n] + gamma * self.kernel_magnitude(n)

        self.collapse = collapse
        return collapse

    def global_collapse(self):
        """Global collapse scalar: sum(C(n)) + action"""
        total = sum(self.collapse.values()) + self.action
        self.collapse_total = total
        return total

    def collapse_step(self):
        """
        Collapse-driven update:
        state(n) ← state(n) / (1 + collapse(n))
        energy(n) ← energy(n) + 0.01 * collapse(n)
        """
        new_state = {}
        new_energy = {}

        for n in self.G.nodes():
            c = self.collapse[n]
            new_state[n] = self.state[n] / (1 + c)
            new_energy[n] = self.energy[n] + 0.01 * c

        self.state = new_state
        self.energy = new_energy

    # ------------------------------------------------------------
    # 6. FULL HARDWARE CYCLE
    # ------------------------------------------------------------

    def full_cycle_step(self):
        """Complete hardware evolution cycle"""
        self.step()
        self.physical_step()
        self.compute_collapse_field()
        self.collapse_step()
        self.compute_action()

    # ------------------------------------------------------------
    # 7. PROJECTIONS (all 5, now using upgraded kernel)
    # ------------------------------------------------------------

    def _radial_positions(self, radius_step=1.0):
        """Recompute positions radially (for visualization)"""
        layers_map = {}
        for n, layer in self.layers.items():
            layers_map.setdefault(layer, []).append(n)

        pos = {}
        for layer, nodes in layers_map.items():
            r = layer * radius_step
            if layer == 0:
                pos[nodes[0]] = (0.0, 0.0)
            else:
                k = len(nodes)
                angles = np.linspace(0, 2 * np.pi, k, endpoint=False)
                for n, a in zip(nodes, angles):
                    pos[n] = (r * np.cos(a), r * np.sin(a))
        return pos

    def plot_topological(self):
        """Projection 1: Topological structure"""
        pos = self._radial_positions()
        node_sizes = [220 - 20 * self.layers[n] for n in self.G.nodes()]
        edge_widths = []
        for u, v in self.G.edges():
            lu, lv = self.layers[u], self.layers[v]
            edge_widths.append(2.5 if min(lu, lv) <= 1 else 1.0)

        fig, ax = plt.subplots()
        nx.draw_networkx_nodes(self.G, pos, node_size=node_sizes, node_color="black", ax=ax)
        nx.draw_networkx_edges(self.G, pos, width=edge_widths, edge_color="black", ax=ax)
        ax.set_axis_off()
        plt.tight_layout()
        plt.show()

    def plot_dynamical(self, steps=5):
        """Projection 2: Dynamical flow"""
        pos = self._radial_positions()
        fig, ax = plt.subplots()

        nx.draw_networkx_nodes(self.G, pos, node_size=80, node_color="black", ax=ax)

        center = 0
        paths = []
        for n in self.G.nodes():
            if n == center:
                continue
            try:
                p = nx.shortest_path(self.G, center, n)
                paths.append(p)
            except nx.NetworkXNoPath:
                pass

        for i, p in enumerate(paths[:steps * 10]):
            xs = [pos[n][0] for n in p]
            ys = [pos[n][1] for n in p]
            alpha = 0.15 + 0.7 * (i / (steps * 10))
            ax.plot(xs, ys, color="black", linewidth=0.8, alpha=alpha)

        edge_widths = []
        for u, v in self.G.edges():
            lu, lv = self.layers[u], self.layers[v]
            edge_widths.append(0.5 if max(lu, lv) > 1 else 1.5)

        nx.draw_networkx_edges(self.G, pos, width=edge_widths, edge_color="black", ax=ax)
        ax.set_axis_off()
        plt.tight_layout()
        plt.show()

    def plot_algebraic(self):
        """Projection 3: Algebraic / Operad (kernel magnitudes)"""
        pos = self._radial_positions()
        kernel_vals = np.array([self.kernel_magnitude(n) for n in self.G.nodes()], dtype=float)
        k_min, k_max = kernel_vals.min(), kernel_vals.max()
        node_sizes = 80 + 220 * (kernel_vals - k_min) / (k_max - k_min + 1e-9)

        fig, ax = plt.subplots()
        nx.draw_networkx_nodes(self.G, pos, node_size=node_sizes, node_color="black", ax=ax)
        nx.draw_networkx_edges(self.G, pos, width=1.0, edge_color="black", ax=ax)
        ax.set_axis_off()
        plt.tight_layout()
        plt.show()

    def plot_physical(self):
        """Projection 4: Physical / Action (energy)"""
        pos = self._radial_positions()
        energy_vals = np.array(list(self.energy.values()), dtype=float)
        e_min, e_max = energy_vals.min(), energy_vals.max()
        edge_widths = 0.5 + 3.0 * (energy_vals - e_min) / (e_max - e_min + 1e-9)

        fig, ax = plt.subplots()
        nx.draw_networkx_nodes(self.G, pos, node_size=60, node_color="black", ax=ax)

        for (u, v), w in zip(self.energy.keys(), edge_widths):
            ax.plot([pos[u][0], pos[v][0]], [pos[u][1], pos[v][1]],
                    color="black", linewidth=w, alpha=0.9)

        ax.set_axis_off()
        plt.tight_layout()
        plt.show()

    def plot_unified(self):
        """Projection 5: Unified / Global"""
        pos = self._radial_positions()
        degrees = dict(self.G.degree)

        node_sizes = []
        for n in self.G.nodes():
            node_sizes.append(80 + 30 * self.layers[n] + 10 * degrees[n])

        edge_widths = []
        for u, v in self.G.edges():
            edge_widths.append(1.0 + 0.7 * (self.layers[u] + self.layers[v]))

        fig, ax = plt.subplots()
        nx.draw_networkx_nodes(self.G, pos, node_size=node_sizes, node_color="black", ax=ax)
        nx.draw_networkx_edges(self.G, pos, width=edge_widths, edge_color="black", ax=ax)
        ax.set_axis_off()
        plt.tight_layout()
        plt.show()


