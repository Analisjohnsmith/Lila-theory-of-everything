\section{Universal Constructions}

\subsection{Initial and Terminal Substrates}

\begin{definition}[Terminal substrate]
A substrate $\mathcal{S}_{\mathrm{term}}$ is \emph{terminal} if for every substrate
$\mathcal{S}$ there exists a unique substrate morphism


\[
! : \mathcal{S} \to \mathcal{S}_{\mathrm{term}}.
\]


\end{definition}

\begin{proposition}[Existence of terminal substrate]
The terminal substrate is given by:
\begin{itemize}
  \item a single node $V = \{*\}$,
  \item trivial adjacency $E = \emptyset$,
  \item trivial state spaces $\mathcal{H}_{\mathrm{phys}} = \mathcal{H}_{\mathrm{sem}} = \mathcal{H}_{\mathrm{agent}} = \{0\}$,
  \item all update operators equal to the identity.
\end{itemize}
\end{proposition}

\begin{definition}[Initial substrate]
A substrate $\mathcal{S}_{\mathrm{init}}$ is \emph{initial} if for every substrate
$\mathcal{S}$ there exists a unique substrate morphism


\[
i : \mathcal{S}_{\mathrm{init}} \to \mathcal{S}.
\]


\end{definition}

\begin{proposition}[Existence of initial substrate]
The initial substrate is given by:
\begin{itemize}
  \item empty node set $V = \emptyset$,
  \item empty state spaces,
  \item empty update operators.
\end{itemize}
\end{proposition}

\subsection{Free Substrate on Generators}

\begin{definition}[Generators]
Let $G$ be a set of generators consisting of:


\[
G = \{\Lambda,\Phi,\Xi,d\Omega,\mathrm{VOID}\}.
\]


\end{definition}

\begin{definition}[Free substrate]
The \emph{free substrate} on $G$ is the initial $\mathcal{P}_\infty$-algebra


\[
\mathcal{F}(G)
\]


equipped with a map $G \to \mathcal{F}(G)$.
\end{definition}

\begin{theorem}[Universal property of the free substrate]
For any substrate $\mathcal{S}$ and any map of generators


\[
G \to \mathcal{S},
\]


there exists a unique substrate morphism


\[
\mathcal{F}(G) \to \mathcal{S}
\]


extending it.
\end{theorem}

\subsection{Cofree Substrate}

\begin{definition}[Cofree substrate]
A substrate $\mathcal{C}$ is \emph{cofree} if for every substrate $\mathcal{S}$,
every morphism of underlying graphs


\[
(V,E) \to (V_{\mathcal{C}},E_{\mathcal{C}})
\]


extends uniquely to a substrate morphism


\[
\mathcal{S} \to \mathcal{C}.
\]


\end{definition}

\begin{theorem}[Existence of cofree substrate]
The cofree substrate exists and is given by the product of:
\begin{itemize}
  \item the cofree coalgebra on the physical state space,
  \item the cofree coalgebra on the semantic state space,
  \item the cofree coalgebra on the agent state space.
\end{itemize}
\end{theorem}

\subsection{Adjunctions}

\begin{theorem}[Free–forgetful adjunction]
There is an adjunction


\[
\mathcal{F} : \mathbf{Set}^G \rightleftarrows \mathbf{Sub} : U
\]


where:
\begin{itemize}
  \item $U$ forgets the substrate structure,
  \item $\mathcal{F}$ freely generates a substrate from generators.
\end{itemize}
\end{theorem}

\begin{theorem}[Cofree–coforgetful adjunction]
There is an adjunction


\[
U : \mathbf{Sub} \rightleftarrows \mathbf{Coalg} : \mathcal{C}
\]


where:
\begin{itemize}
  \item $U$ forgets the coalgebra structure,
  \item $\mathcal{C}$ freely co-generates a cofree substrate.
\end{itemize}
\end{theorem}

\subsection{Universal Dynamics}

\begin{definition}[Universal update]
The universal update operator is the morphism


\[
U_{\mathrm{univ}} : \mathcal{F}(G) \to \mathcal{F}(G)
