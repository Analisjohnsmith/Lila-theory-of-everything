\section{Algebraic and Homotopical Invariants of the Substrate}

\subsection{Homology of the Underlying Graph}

\begin{definition}[Chain complex of the substrate]
Let $(V,E)$ be the underlying graph.  
Define the chain complex:


\[
C_1 = \mathbb{Z}^E,\qquad
C_0 = \mathbb{Z}^V,
\]


with boundary map


\[
\partial(e_{ij}) = v_j - v_i.
\]


\end{definition}

\begin{definition}[Graph homology]
The homology groups of the substrate graph are


\[
H_k(V,E) = H_k(C_\bullet).
\]


\end{definition}

\begin{theorem}[Homology classification]
Two substrates with the same graph homology are homotopy equivalent as 1‑dimensional CW complexes.
\end{theorem}

\subsection{Cohomology of Field Sheaves}

\begin{definition}[Sheaf cohomology]
For a field sheaf $\mathscr{F}$ on the substrate site $\mathcal{C}$, define


\[
H^k(V;\mathscr{F}) = R^k\Gamma(\mathscr{F}),
\]


the right-derived functors of global sections.
\end{definition}

\begin{theorem}[Cohomological invariants]
The cohomology groups


\[
H^k(V;\mathscr{F}_{\mathrm{phys}}),\quad
H^k(V;\mathscr{F}_{\mathrm{sem}}),\quad
H^k(V;\mathscr{F}_{\mathrm{agent}})
\]


are invariants of substrate equivalence.
\end{theorem}

\subsection{Characteristic Classes}

\begin{definition}[Field bundle]
Each field sheaf $\mathscr{F}$ determines a bundle over $V$:


\[
\pi : E_{\mathscr{F}} \to V.
\]


\end{definition}

\begin{definition}[Characteristic classes]
The characteristic classes of $\mathscr{F}$ are elements of


\[
H^\bullet(V;\mathbb{Z})
\]


associated to $E_{\mathscr{F}}$.
\end{definition}

\begin{theorem}[Classification by characteristic classes]
Two field bundles are isomorphic iff their characteristic classes agree.
\end{theorem}

\subsection{Spectral Sequences}

\begin{definition}[Substrate spectral sequence]
The substrate carries a natural spectral sequence


\[
E_2^{p,q} = H^p(V; \mathcal{H}^q(\mathscr{F}))
\quad\Longrightarrow\quad
H^{p+q}(V;\mathscr{F}),
\]


where $\mathcal{H}^q$ denotes the cohomology sheaves.
\end{definition}

\begin{theorem}[Convergence]
The substrate spectral sequence converges strongly for all field sheaves.
\end{theorem}

\subsection{Obstruction Theory}

\begin{definition}[Obstruction class]
Given a partial extension of a field configuration, the obstruction to extending it further lies in


\[
H^{k+1}(V;\pi_k(\mathscr{F})).
\]


\end{definition}

\begin{theorem}[Obstruction vanishing]
A field configuration extends globally iff all obstruction classes vanish.
\end{theorem}

\subsection{Postnikov Towers}

\begin{definition}[Postnikov tower]
Each field sheaf $\mathscr{F}$ admits a Postnikov decomposition


\[
\mathscr{F} \to \cdots \to P_n(\mathscr{F}) \to P_{n-1}(\mathscr{F}) \to \cdots \to P_0(\mathscr{F}),
\]


where $P_n$ is the $n$‑truncation.
\end{definition}

\begin{theorem}[Classification by Postnikov invariants]
Two field sheaves are equivalent iff their Postnikov invariants agree.
\end{theorem}

\subsection{Algebraic K‑Theory}

\begin{definition}[Substrate category]
Let $\mathbf{Sub}$ be the category of substrates and substrate morphisms.
\end{definition}

\begin{definition}[Algebraic K‑theory]
The algebraic K‑theory of the substrate category is


\[
K(\mathbf{Sub}).
\]


\end{definition}

\begin{theorem}[K‑theoretic invariants]
The groups


\[
K_0(\mathbf{Sub}),\quad K_1(\mathbf{Sub}),\quad K_2(\mathbf{Sub}),\dots
\]


are invariants of substrate equivalence.
\end{theorem}

\subsection{Factorization Homology as a Homotopical Invariant}

\begin{theorem}[Factorization homology is homotopy invariant]
If two substrates are homotopy equivalent as graphs, then


\[
\int_V \mathcal{F}_{\mathcal{S}}
\;\simeq\;
\int_{V'} \mathcal{F}_{\mathcal{S}'}.
\]


\end{theorem}
