\section{Metatheory of the Substrate Type Theory}

\subsection{Consistency}

\begin{definition}[Consistency]
The substrate type theory is \emph{consistent} if there is no term $t$
such that both $t : A$ and $t : \bot$ are derivable.
\end{definition}

\begin{theorem}[Consistency]
The substrate type theory is consistent.
\end{theorem}

\begin{proof}[Sketch]
The internal language of a cohesive $\infty$-topos is consistent.
The substrate type theory is interpreted in $\mathbf{H}$.
Thus, if a contradiction were derivable, $\mathbf{H}$ would collapse,
contradicting the existence of nontrivial objects.
\end{proof}

\subsection{Completeness}

\begin{definition}[Semantic entailment]
A judgment $\Gamma \vDash A$ holds if every interpretation of $\Gamma$
in $\mathbf{H}$ satisfies the interpretation of $A$.
\end{definition}

\begin{definition}[Syntactic entailment]
A judgment $\Gamma \vdash A$ holds if $A$ is derivable from $\Gamma$
in the substrate type theory.
\end{definition}

\begin{theorem}[Completeness]
If $\Gamma \vDash A$, then $\Gamma \vdash A$.
\end{theorem}

\begin{proof}[Sketch]
The internal language of an $\infty$-topos is complete with respect to
its categorical semantics.  
The substrate type theory is a fragment of this language.
\end{proof}

\subsection{Conservativity}

\begin{definition}[Conservative extension]
A theory $T'$ is a conservative extension of $T$ if every theorem of $T'$
expressible in the language of $T$ is already a theorem of $T$.
\end{definition}

\begin{theorem}[Conservativity of modalities]
Adding the modalities


\[
\flat,\ \sharp,\ \Pi,\ \Re,\ \Im,\ \mathrm{Et}
\]


is a conservative extension of the underlying dependent type theory.
\end{theorem}

\begin{proof}[Sketch]
Modalities are interpreted as adjoint functors in $\mathbf{H}$.
Adjoints preserve logical validity.
\end{proof}

\subsection{Expressiveness}

\begin{theorem}[Expressiveness]
The substrate type theory can express:
\begin{itemize}
  \item all update operators,
  \item all field configurations,
  \item all modal decompositions,
  \item all BV--BRST structures,
  \item all factorization algebra constructions,
  \item all dynamical evolutions $O \mapsto U(O)$.
\end{itemize}
\end{theorem}

\subsection{Decidability}

\begin{theorem}[Undecidability]
The substrate type theory is undecidable.
