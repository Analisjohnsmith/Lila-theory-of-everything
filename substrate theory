\subsection{Internal Logic}

\begin{definition}[Internal language]
The cohesive $\infty$-topos $\mathbf{H}$ carries an internal higher-order
intuitionistic type theory with:
\begin{itemize}
  \item dependent types,
  \item identity types,
  \item $\Pi$-types and $\Sigma$-types,
  \item modalities $\flat, \sharp, \Pi, \Re, \Im, \mathrm{Et}$.
\end{itemize}
We call this the \emph{substrate type theory}.
\end{definition}

\begin{definition}[Interpretation of fields]
Each field sheaf is interpreted as a type:


\[
\mathscr{F}_{\mathrm{phys}} : \mathrm{Type},\quad
\mathscr{F}_{\mathrm{sem}} : \mathrm{Type},\quad
\mathscr{F}_{\mathrm{agent}} : \mathrm{Type}.
\]


\end{definition}

\begin{definition}[Interpretation of configurations]
A configuration is interpreted as a dependent product:


\[
O :\equiv 
\mathscr{F}_{\mathrm{phys}} \times 
\mathscr{F}_{\mathrm{sem}} \times 
\mathscr{F}_{\mathrm{agent}}.
\]


\end{definition}

\subsection{Modal Semantics}

\begin{definition}[Modal interpretation]
Each modality acts on types:


\[
\flat A,\quad \sharp A,\quad \Pi A,\quad \Re A,\quad \Im A,\quad \mathrm{Et}(A).
\]


\end{definition}

\begin{proposition}[Field decomposition]
Every field type decomposes as


\[
A \simeq \flat A \times_{\Gamma(A)} \sharp A.
\]


\end{proposition}

\subsection{Operational Semantics}

\begin{definition}[Operational semantics]
The global update operator


\[
U = \mathrm{VOID} \circ d\Omega \circ \Xi \circ \Phi \circ \Lambda
\]


is interpreted as a term


\[
U : O \to O
\]


in the internal language.
\end{definition}

\begin{definition}[Reduction rule]
The operational semantics is given by the reduction


\[
O \longmapsto U(O).
\]


\end{definition}

\begin{theorem}[Determinism]
The operational semantics is deterministic:


\[
O \longmapsto O_1 \quad\text{and}\quad O \longmapsto O_2
\quad\Rightarrow\quad O_1 = O_2.
\]


\end{theorem}

\subsection{Denotational Semantics}

\begin{definition}[Denotational semantics]
The denotation of a configuration is its interpretation in $\mathbf{H}$:


\[
\llbracket O \rrbracket \in \mathbf{H}.
\]


\end{definition}

\begin{definition}[Denotation of the update]
The denotation of the global update is the morphism


\[
\llbracket U \rrbracket : \llbracket O \rrbracket \to \llbracket O \rrbracket.
\]


\end{definition}

\begin{theorem}[Soundness]
If $O \longmapsto O'$, then


\[
\llbracket O \rrbracket \to \llbracket O' \rrbracket
\]


in $\mathbf{H}$.
\end{theorem}

\begin{theorem}[Adequacy]
If


\[
\llbracket O \rrbracket = \llbracket O' \rrbracket,
\]


then $O$ and $O'$ are observationally equivalent.
\end{theorem}

\subsection{Computational Interpretation}

\begin{definition}[Substrate calculus]
The substrate induces a typed computational calculus with:
\begin{itemize}
  \item terms for fields,
  \item terms for update operators,
  \item a reduction rule $O \to U(O)$,
  \item modal operators corresponding to $\flat, \sharp, \Pi, \Re, \Im$.
\end{itemize}
\end{definition}

\begin{theorem}[Normalization]
Every term in the substrate calculus reduces to a normal form.
\end{theorem}

\begin{theorem}[Confluence]
If a term reduces in two ways:


\[
t \to t_1,\quad t \to t_2,
\]


then there exists $t'$ such that


\[
t_1 \to t',\quad t_2 \to t'.
\]


\end{theorem}

\begin{theorem}[Computational adequacy]
Operational and denotational semantics coincide:


\[
O \longmapsto O' \quad\Longleftrightarrow\quad
\llbracket O \rrbracket \to \llbracket O' \rrbracket.
\]


\end{theorem}
