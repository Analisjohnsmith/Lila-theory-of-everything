\section{Operadic and Factorization Structures}

\subsection{The Substrate as an Operad Algebra}

\begin{definition}[Substrate operad]
Let $\mathcal{P}$ be the colored operad whose colors are


\[
\{\mathrm{phys},\ \mathrm{sem},\ \mathrm{agent}\},
\]


and whose $n$-ary operations are formal composites of


\[
\Lambda,\ \Phi,\ \Xi,\ d\Omega,\ \mathrm{VOID}.
\]


Composition in $\mathcal{P}$ is given by substitution of operators.
\end{definition}

\begin{definition}[Substrate as a $\mathcal{P}$-algebra]
The substrate configuration space $\mathcal{O}$ is a $\mathcal{P}$-algebra via


\[
\mathcal{P}(n) \times \mathcal{O}^n \to \mathcal{O},
\]


where each generator acts by its corresponding update rule.
\end{definition}

\subsection{The Substrate as an $\infty$-Operad Algebra}

\begin{definition}[$\infty$-operad of substrate transformations]
Let $\mathcal{P}_\infty$ be the $\infty$-operad obtained by freely adjoining
higher homotopies between composites of


\[
\Lambda,\ \Phi,\ \Xi,\ d\Omega,\ \mathrm{VOID}.
\]


\end{definition}

\begin{definition}[Substrate as a $\mathcal{P}_\infty$-algebra]
The $\infty$-category $\mathbf{Sub}_\infty$ carries a canonical
$\mathcal{P}_\infty$-algebra structure, where


\[
\mathcal{P}_\infty(n) \to \mathrm{Map}_{\mathbf{Sub}_\infty}(O^{\times n},O)
\]


assigns to each higher operation a coherent family of update morphisms.
\end{definition}

\subsection{Factorization Algebra of Local Observables}

\begin{definition}[Open sets]
For the underlying graph $(V,E)$, let $\mathrm{Open}(V)$ denote the poset of
subsets $U \subseteq V$ ordered by inclusion.
\end{definition}

\begin{definition}[Factorization algebra]
A \emph{factorization algebra} on $V$ is a functor


\[
\mathcal{F} : \mathrm{Open}(V) \to \mathbf{Ch}
\]


such that for disjoint opens $U_1,\dots,U_n$,


\[
\mathcal{F}(U_1 \sqcup \cdots \sqcup U_n)
\simeq
\mathcal{F}(U_1) \otimes \cdots \otimes \mathcal{F}(U_n).
\]


\end{definition}

\begin{definition}[Substrate factorization algebra]
Define $\mathcal{F}_{\mathcal{S}}$ by


\[
\mathcal{F}_{\mathcal{S}}(U)
=
\mathrm{Obs}(U)
=
\mathrm{Functions}\big(\mathscr{F}_{\mathrm{phys}}(U)
\times \mathscr{F}_{\mathrm{sem}}(U)
\times \mathscr{F}_{\mathrm{agent}}(U)\big),
\]


the chain complex of local observables on $U$.
\end{definition}

\subsection{Factorization Homology}

\begin{definition}[Factorization homology]
For a factorization algebra $\mathcal{F}$ on $V$, define its factorization homology


\[
\int_V \mathcal{F}
\]


as the colimit of $\mathcal{F}$ over $\mathrm{Open}(V)$.
\end{definition}

\begin{proposition}[Global observables]
The global observable algebra of the substrate is


\[
\mathcal{O}_{\mathrm{global}}
\simeq
\int_V \mathcal{F}_{\mathcal{S}}.
\]


\end{proposition}

\begin{remark}
Factorization homology provides the local-to-global principle for the substrate:
local physics, semantics, and agency determine global behavior.
\end{remark}
