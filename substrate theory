  \]


\end{itemize}
\end{definition}

\subsection{Axioms}

\begin{definition}[Axiom 1: Locality]
Each operator acts locally with respect to the graph $(V,E)$:


\[
(\Lambda O)_i = F_\Lambda(O_j : j \sim i),
\]


and similarly for $\Phi,\Xi,d\Omega,\mathrm{VOID}$.
\end{definition}

\begin{definition}[Axiom 2: Functoriality]
The operators assemble into endomorphisms of the substrate category:


\[
\Lambda,\Phi,\Xi,d\Omega,\mathrm{VOID} : \mathbf{Sub} \to \mathbf{Sub}.
\]


Composition is strictly associative.
\end{definition}

\begin{definition}[Axiom 3: Higher Coherence]
There exist coherent higher homotopies making the operators into
morphisms of an $\infty$-operad algebra:


\[
\mathcal{P}_\infty \to \mathrm{End}_{\mathbf{Sub}_\infty}(\mathcal{O}).
\]


\end{definition}

\begin{definition}[Axiom 4: Cohesion]
The substrate $\infty$-topos $\mathbf{H}$ is cohesive:


\[
\Pi \dashv \mathrm{Disc} \dashv \Gamma \dashv \mathrm{Codisc}.
\]


\end{definition}

\begin{definition}[Axiom 5: Differential Cohesion]
The substrate is differentially cohesive:


\[
\Re \dashv \Im \dashv \mathrm{Et}.
\]


Infinitesimal objects exist and satisfy the Kock--Lawvere axiom.
\end{definition}

\begin{definition}[Axiom 6: Factorization]
Local observables form a factorization algebra


\[
\mathcal{F}_{\mathcal{S}} : \mathrm{Open}(V) \to \mathbf{Ch},
\]


and global observables are given by factorization homology:


\[
\mathcal{O}_{\mathrm{global}} \simeq \int_V \mathcal{F}_{\mathcal{S}}.
\]


\end{definition}

\begin{definition}[Axiom 7: BV--BRST Structure]
There exists a graded sheaf of fields $\mathcal{F}$ and a BV bracket


\[
\{-,-\}_{BV} : \mathcal{F} \otimes \mathcal{F} \to \mathcal{F}[1]
\]


with a master action $S_{BV}$ satisfying


\[
\{S_{BV},S_{BV}\}_{BV} = 0.
\]


\end{definition}

\begin{definition}[Axiom 8: Global Update]
The global evolution operator is


\[
U := \mathrm{VOID} \circ d\Omega \circ \Xi \circ \Phi \circ \Lambda,
\]


and the substrate evolves by


\[
O(t+1) = U(O(t)).
\]


\end{definition}

\subsection{Consequences}

\begin{theorem}[Existence of fixed points]
Under Axioms 1--8, the fixed points of the substrate are solutions of


\[
U(O^\*) = O^\*.
