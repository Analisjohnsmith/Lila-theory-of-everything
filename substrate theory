The global update $U$ is differentiable in the sense of synthetic differential geometry, and its differential is


\[
dU = T\mathrm{VOID} \circ Td\Omega \circ T\Xi \circ T\Phi \circ T\Lambda.
\]


\end{theorem}

\begin{theorem}[Local-to-global principle]
Global observables are determined by local ones:


\[
\mathcal{O}_{\mathrm{global}} \simeq \int_V \mathcal{F}_{\mathcal{S}}.
\]


\end{theorem}
