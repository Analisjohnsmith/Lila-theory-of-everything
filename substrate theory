\section{Main Theorems of the Substrate Theory}

\subsection{Existence and Uniqueness of Evolution}

\begin{theorem}[Existence of evolution]
Under Axioms 1--8, the global update operator


\[
U = \mathrm{VOID} \circ d\Omega \circ \Xi \circ \Phi \circ \Lambda
\]


is a well-defined endomorphism of the configuration space $\mathcal{O}$.
Hence for every initial configuration $O_0 \in \mathcal{O}$, the sequence


\[
O(t+1) = U(O(t))
\]


exists for all $t \in \mathbb{N}$.
\end{theorem}

\begin{proof}
Each operator is total and maps $\mathcal{O}$ to itself.  
Composition of total maps is total.  
Thus $U$ is total.  
Induction on $t$ gives existence.
\end{proof}

\begin{theorem}[Uniqueness of evolution]
For any initial configuration $O_0$, the evolution


\[
O(t) = U^t(O_0)
\]


is unique.
\end{theorem}

\begin{proof}
$U$ is a function, hence deterministic.
\end{proof}

\subsection{Fixed Points and Invariants}

\begin{theorem}[Fixed point equation]
A configuration $O^\*$ is a fixed point of the substrate if and only if


\[
U(O^\*) = O^\*.
\]


\end{theorem}

\begin{theorem}[Physical fixed points]
If the physical Hamiltonian is $H = \alpha L + V$, then


\[
\psi^\* \text{ is a fixed point } \iff H \psi^\* = 0.
\]


\end{theorem}

\begin{theorem}[Semantic fixed points]
If $\eta - 2\gamma \neq 0$, then


\[
\mu^\* \text{ is a fixed point } \iff L \mu^\* = 0.
\]


If $\eta - 2\gamma = 0$, every $\mu$ is a fixed point.
\end{theorem}

\begin{theorem}[Agent fixed points]
Let $a' = w_a a + w_p p$.  
If $|w_a| < 1$, then for any fixed perception value $p^\*$, the unique fixed point is


\[
a^\* = \frac{w_p}{1 - w_a} p^\*.
\]


\end{theorem}

\subsection{Stability Theory}

\begin{theorem}[Linearization]
The differential of the global update is


\[
dU = T\mathrm{VOID} \circ Td\Omega \circ T\Xi \circ T\Phi \circ T\Lambda.
\]


\end{theorem}

\begin{definition}[Stability criterion]
A fixed point $O^\*$ is:
\begin{itemize}
  \item \emph{stable} if all eigenvalues of $dU_{O^\*}$ satisfy $|\lambda| < 1$,
  \item \emph{unstable} if some eigenvalue satisfies $|\lambda| > 1$,
  \item \emph{neutrally stable} if all eigenvalues satisfy $|\lambda| \le 1$ and at least one satisfies $|\lambda| = 1$.
\end{itemize}
\end{definition}

\begin{theorem}[Stability decomposition]
The stability of a fixed point decomposes into contributions from:


\[
dU = dU_{\mathrm{phys}} \oplus dU_{\mathrm{sem}} \oplus dU_{\mathrm{agent}}
\]


together with cross-coupling terms.
\end{theorem}

\begin{theorem}[Spectral structure of the finite model]
For the 3-node substrate with $H = L$, the eigenvalues of the physical block are


\[
1 - i\Delta t \lambda_k, \qquad \lambda_k \in \{0,1,3\}.
\]


Thus the physical subsystem is weakly unstable.
\end{theorem}

\subsection{Local-to-Global Structure}

\begin{theorem}[Factorization homology recovers global observables]
Let $\mathcal{F}_{\mathcal{S}}$ be the substrate factorization algebra.  
Then


\[
\mathcal{O}_{\mathrm{global}} \simeq \int_V \mathcal{F}_{\mathcal{S}}.
\]


\end{theorem}

\begin{theorem}[Cohesive decomposition]
Every field sheaf decomposes as


\[
\mathscr{F} \simeq \flat \mathscr{F} \times_{\Gamma(\mathscr{F})} \sharp \mathscr{F},
\]


expressing discrete, global, and cohesive components.
\end{theorem}

\subsection{BV--BRST and Quantization}

\begin{theorem}[Master equation]
The BV master action satisfies


\[
\{S_{BV}, S_{BV}\}_{BV} = 0.
\]


\end{theorem}

\begin{theorem}[Gauge invariance]
The cohomology of the BV differential $Q = \{S_{BV}, -\}_{BV}$  
classifies gauge-invariant observables of the substrate.
\end{theorem}
