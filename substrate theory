\section{Computational Complexity of the Substrate}

\subsection{Time and Space Complexity}

\begin{definition}[Time complexity]
For a substrate $\mathcal{S}$ with global update operator $U$, the
\emph{time complexity} of computing $U(O)$ is


\[
T_{\mathcal{S}}(n) = \text{time required to compute one update on a substrate of size } n = |V|.
\]


\end{definition}

\begin{proposition}[Locality bound]
If all update operators are local (Axiom 1), then


\[
T_{\mathcal{S}}(n) = O(n).
\]


\end{proposition}

\begin{definition}[Space complexity]
The \emph{space complexity} of a substrate is


\[
S_{\mathcal{S}}(n) = \dim(\mathcal{H}_{\mathrm{phys}}) +
                     \dim(\mathcal{H}_{\mathrm{sem}}) +
                     \dim(\mathcal{H}_{\mathrm{agent}}).
\]


\end{definition}

\begin{proposition}[Linear space]
For finite-dimensional state spaces,


\[
S_{\mathcal{S}}(n) = O(n).
\]


\end{proposition}

\subsection{Computational Universality}

\begin{definition}[Encoding of computation]
A substrate $\mathcal{S}$ \emph{encodes a computation} if there exists an
injective map


\[
\mathrm{enc} : \{0,1\}^\ast \to \mathcal{O}
\]


and a decoding map


\[
\mathrm{dec} : \mathcal{O} \to \{0,1\}^\ast
\]


such that


\[
\mathrm{dec}(U^t(\mathrm{enc}(x))) = M(x)
\]


for some Turing machine $M$.
\end{definition}

\begin{theorem}[Turing completeness]
Every nontrivial substrate with:
\begin{itemize}
  \item at least two nodes,
  \item nonconstant agent update,
  \item nonconstant semantic update,
\end{itemize}
is Turing complete.
\end{theorem}

\begin{proof}[Sketch]
The agent update can simulate a register machine.
The semantic field can store tape contents.
The physical field can store head position.
Locality ensures correct propagation.
Thus the substrate simulates a universal Turing machine.
\end{proof}

\subsection{Complexity Classes Realized by Substrates}

\begin{definition}[Substrate complexity class]
For a substrate $\mathcal{S}$, define


\[
\mathrm{TIME}_{\mathcal{S}}(t) = 
\{ f : \{0,1\}^\ast \to \{0,1\}^\ast \mid
f(x) = \mathrm{dec}(U^t(\mathrm{enc}(x))) \}.
\]


\end{definition}

\begin{theorem}[Substrate complexity hierarchy]
There exist substrates realizing:


\[
\mathrm{P},\quad \mathrm{NP},\quad \mathrm{PSPACE},\quad \mathrm{EXP}.
\]


\end{theorem}

\begin{proof}[Sketch]
By adjusting:
\begin{itemize}
  \item the size of the semantic field,
  \item the branching factor of the graph,
  \item the agent update rule,
\end{itemize}
one obtains substrates simulating machines in each class.
\end{proof}

\subsection{Parallel Complexity}

\begin{definition}[Parallel update]
A substrate supports parallel update if all nodes update simultaneously.
\end{definition}

\begin{theorem}[NC simulation]
Parallel substrates simulate $\mathrm{NC}$ circuits.
\end{theorem}

\begin{proof}[Sketch]
Each layer of a circuit corresponds to one global update.
Locality ensures bounded fan-in.
\end{proof}

\subsection{Lower Bounds}

\begin{theorem}[Linear-time lower bound]
Any substrate with nontrivial locality must satisfy


\[
T_{\mathcal{S}}(n) \ge O(n).
\]


\end{theorem}

\begin{proof}[Sketch]
Information cannot propagate faster than one edge per update.
\end{proof}

\subsection{Upper Bounds}

\begin{theorem}[Polynomial-time upper bound]
For fixed local update rules,


\[
T_{\mathcal{S}}(n) = O(n^k)
\]


for some constant $k$ depending on operator complexity.
\end{theorem}

\subsection{Complexity of Fixed Points}

\begin{definition}[Fixed point problem]
Given a substrate $\mathcal{S}$, the fixed point problem is:


\[
\text{Find } O^\* \text{ such that } U(O^\*) = O^\*.
\]


\end{definition}

\begin{theorem}[Fixed point complexity]
The fixed point problem is:


\[
\mathrm{P}\text{-complete for deterministic substrates},
\]




\[
\mathrm{NP}\text{-complete for nondeterministic substrates}.
\]


\end{theorem}

\subsection{Complexity of Stability}

\begin{definition}[Stability decision problem]
Given $O^\*$, decide whether all eigenvalues of $dU_{O^\*}$ satisfy $|\lambda| < 1$.
\end{definition}

\begin{theorem}[Stability is coNP-hard]
The stability decision problem is coNP-hard.
\end{theorem}

\begin{proof}[Sketch]
Reduction from matrix spectral radius problems.
\end{proof}
