\section{Applications and Examples}

\subsection{Finite Substrate Examples}

\begin{example}[Two-node substrate]
Let $V = \{1,2\}$ with adjacency matrix


\[
A = \begin{pmatrix}
0 & 1 \\
1 & 0
\end{pmatrix}.
\]


The Laplacian is


\[
L = \begin{pmatrix}
1 & -1 \\
-1 & 1
\end{pmatrix}.
\]


The physical update is


\[
\psi' = \psi - i\Delta t\, H\psi,
\]


with $H = \alpha L + V$.
The semantic update is


\[
\mu' = \mu + (\eta - 2\gamma)L\mu.
\]


The agent update is


\[
a' = w_a a + w_p P(\psi,\mu).
\]


This substrate is fully solvable in closed form.
\end{example}

\begin{example}[Three-node chain]
Let $V = \{1,2,3\}$ with edges $1\sim2\sim3$.
The Laplacian is


\[
L = \begin{pmatrix}
1 & -1 & 0 \\
-1 & 2 & -1 \\
0 & -1 & 1
\end{pmatrix}.
\]


The physical fixed points satisfy $L\psi^\* = 0$, hence


\[
\psi^\* \propto (1,1,1).
\]


The semantic fixed points satisfy the same equation.
The agent fixed point is


\[
a^\* = \frac{w_p}{1-w_a} p^\*.
\]


\end{example}

\subsection{Explicit Evolution}

\begin{example}[One-step evolution]
Let


\[
\psi = (1,0,0),\quad
\mu = (0,1,0),\quad
a = 0.
\]


Then


\[
\psi' = \psi - i\Delta t\, H\psi,
\]




\[
\mu' = \mu + (\eta - 2\gamma)L\mu,
\]




\[
a' = w_p P(\psi,\mu).
\]


This gives a fully explicit numerical update.
\end{example}

\subsection{Stability Computation}

\begin{example}[Jacobian of the 3-node substrate]
Let $x = (\Re\psi,\Im\psi,\mu,a)$.
The Jacobian of $U$ at a fixed point $x^\*$ is


\[
J = \left.\frac{\partial U}{\partial x}\right|_{x=x^\*}.
\]


The eigenvalues of the physical block are


\[
1 - i\Delta t\,\lambda_k,\qquad \lambda_k \in \{0,1,3\}.
\]


Thus the physical subsystem is weakly unstable.
\end{example}

\subsection{Homological Computations}

\begin{example}[Graph homology]
For the 3-node chain:


\[
H_0 \cong \mathbb{Z},\qquad
H_1 \cong 0.
\]


For the 3-cycle:


\[
H_0 \cong \mathbb{Z},\qquad
H_1 \cong \mathbb{Z}.
\]


Thus the cycle substrate has a nontrivial 1-dimensional invariant.
\end{example}

\subsection{Cohomology of Field Sheaves}

\begin{example}[Constant field sheaf]
If $\mathscr{F}$ is constant, then


\[
H^k(V;\mathscr{F}) \cong H^k(V;\mathbb{Z}) \otimes \mathscr{F}.
\]


\end{example}

\subsection{Characteristic Classes}

\begin{example}[Trivial bundle]
If $\mathscr{F}$ is trivial, all characteristic classes vanish:


\[
c_i(\mathscr{F}) = 0.
\]


\end{example}

\subsection{Spectral Sequence Example}

\begin{example}[Two-stage spectral sequence]
For a field sheaf with only two nonzero cohomology sheaves,


\[
E_2^{p,q} = H^p(V;\mathcal{H}^q(\mathscr{F})),
\]


the spectral sequence collapses at $E_2$.
\end{example}

\subsection{Obstruction Theory Example}

\begin{example}[Obstruction to extension]
Let $\mathscr{F}$ be a field sheaf with $\pi_1(\mathscr{F}) \neq 0$.
A partial configuration on $\{1,2\}$ extends to $\{1,2,3\}$ iff


\[
\mathrm{Obs} \in H^2(V;\pi_1(\mathscr{F})) = 0.
\]


\end{example}

\subsection{Postnikov Tower Example}

\begin{example}[Two-stage Postnikov tower]
If $\mathscr{F}$ has only $\pi_0$ and $\pi_1$ nonzero, then


\[
\mathscr{F} \simeq P_1(\mathscr{F})
\]


and the only invariant is the $k$-invariant


\[
k \in H^2(V;\pi_1(\mathscr{F})).
\]


\end{example}

\subsection{K-Theory Example}

\begin{example}[K-theory of a finite substrate]
For a finite substrate category,


\[
K_0(\mathbf{Sub}) \cong \mathbb{Z}^r,
\]


where $r$ is the number of connected components of the moduli stack.
\end{example}

\subsection{Factorization Homology Example}

\begin{example}[Global observables of a chain]
For the 3-node chain,


\[
\int_V \mathcal{F}_{\mathcal{S}}
\simeq
\mathcal{F}_{\mathcal{S}}(1) \otimes
\mathcal{F}_{\mathcal{S}}(2) \otimes
\mathcal{F}_{\mathcal{S}}(3).
\]


\end{example}
