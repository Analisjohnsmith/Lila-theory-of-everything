\section{Classification of Substrates}

\subsection{Equivalence of Substrates}

\begin{definition}[Substrate morphism]
A \emph{morphism of substrates}


\[
F : \mathcal{S} \to \mathcal{S}'
\]


consists of:
\begin{itemize}
  \item a graph morphism $f : (V,E) \to (V',E')$,
  \item linear maps on state spaces
  

\[
  F_{\mathrm{phys}} : \mathcal{H}_{\mathrm{phys}} \to \mathcal{H}'_{\mathrm{phys}},\quad
  F_{\mathrm{sem}} : \mathcal{H}_{\mathrm{sem}} \to \mathcal{H}'_{\mathrm{sem}},\quad
  F_{\mathrm{agent}} : \mathcal{H}_{\mathrm{agent}} \to \mathcal{H}'_{\mathrm{agent}},
  \]


  \item compatibility with update operators:
  

\[
  F \circ \Lambda = \Lambda' \circ F,\quad
  F \circ \Phi = \Phi' \circ F,\quad
  F \circ \Xi = \Xi' \circ F,\quad
  F \circ d\Omega = d\Omega' \circ F,\quad
  F \circ \mathrm{VOID} = \mathrm{VOID}' \circ F.
  \]


\end{itemize}
\end{definition}

\begin{definition}[Equivalence of substrates]
Two substrates $\mathcal{S}$ and $\mathcal{S}'$ are \emph{equivalent} if there exists an invertible substrate morphism


\[
F : \mathcal{S} \to \mathcal{S}'.
\]


\end{definition}

\subsection{Classification by Invariants}

\begin{definition}[Primary invariants]
The following are invariants of substrate equivalence:
\begin{itemize}
  \item the homotopy type $\Pi(\mathscr{F})$ of each field sheaf,
  \item the spectrum of the physical Hamiltonian $H$,
  \item the kernel of the Laplacian $L$,
  \item the operadic structure of update operators,
  \item the BV--BRST cohomology $H^\bullet_{BV}$,
  \item the factorization homology $\displaystyle \int_V \mathcal{F}_{\mathcal{S}}$.
\end{itemize}
\end{definition}

\begin{theorem}[Classification by invariants]
Two substrates $\mathcal{S}$ and $\mathcal{S}'$ are equivalent if and only if all primary invariants agree.
\end{theorem}

\begin{proof}[Sketch]
Each invariant is functorial under substrate morphisms.  
Conversely, equality of invariants determines a unique equivalence class of update operators and field sheaves.  
Thus the invariants classify substrates up to equivalence.
\end{proof}

\subsection{Moduli Space of Substrates}

\begin{definition}[Moduli stack of substrates]
Let $\mathfrak{M}$ be the derived stack whose points are substrates
and whose morphisms are substrate equivalences.  
Formally,


\[
\mathfrak{M} := [\mathrm{Substrates} / \mathrm{Equivalences}].
\]


\end{definition}

\begin{theorem}[Derived structure]
The moduli stack $\mathfrak{M}$ carries a natural derived enhancement


\[
\mathfrak{M}_{\mathrm{der}} \in D(\mathbf{H}),
\]


encoding infinitesimal deformations of substrates.
\end{theorem}

\begin{theorem}[Tangent complex]
The tangent complex of the moduli stack at a substrate $\mathcal{S}$ is


\[
T_{\mathcal{S}}\mathfrak{M}
\simeq
\mathrm{Def}(\Lambda,\Phi,\Xi,d\Omega,\mathrm{VOID}),
\]


the deformation complex of the update operators.
\end{theorem}

\subsection{Dynamical Classification}

\begin{definition}[Dynamical equivalence]
Two substrates are \emph{dynamically equivalent} if their global updates
$U$ and $U'$ are conjugate:


\[
F \circ U = U' \circ F.
\]


\end{definition}

\begin{theorem}[Spectral classification]
Dynamical equivalence classes are classified by:
\begin{itemize}
  \item the spectrum of $dU$,
  \item the Jordan form of $dU$,
  \item the decomposition of $dU$ into physical, semantic, and agent blocks,
  \item cross-coupling terms.
\end{itemize}
