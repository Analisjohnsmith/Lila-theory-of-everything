\end{definition}

\begin{theorem}[Every substrate is a quotient of the universal one]
For any substrate $\mathcal{S}$, there exists a unique morphism


\[
\mathcal{F}(G) \to \mathcal{S}
\]


making $\mathcal{S}$ a quotient of the universal substrate.
\end{theorem}
