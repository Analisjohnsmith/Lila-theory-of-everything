\section{Model Theory of the Substrate}

\subsection{Language of Substrates}

\begin{definition}[Substrate language]
The \emph{language of substrates} $\mathcal{L}_{\mathcal{S}}$ consists of:
\begin{itemize}
  \item sorts for $\mathscr{F}_{\mathrm{phys}}, \mathscr{F}_{\mathrm{sem}}, \mathscr{F}_{\mathrm{agent}}$,
  \item function symbols for $\Lambda, \Phi, \Xi, d\Omega, \mathrm{VOID}$,
  \item relation symbols for adjacency $E(i,j)$,
  \item constants for nodes $i \in V$.
\end{itemize}
\end{definition}

\begin{definition}[Substrate structure]
A substrate $\mathcal{S}$ is an $\mathcal{L}_{\mathcal{S}}$-structure interpreting:


\[
\mathscr{F}_{\mathrm{phys}},\ \mathscr{F}_{\mathrm{sem}},\ \mathscr{F}_{\mathrm{agent}},\ 
\Lambda,\Phi,\Xi,d\Omega,\mathrm{VOID},\ E.
\]


\end{definition}

\subsection{The Substrate Theory}

\begin{definition}[Substrate theory]
The \emph{substrate theory} $T_{\mathcal{S}}$ is the set of all $\mathcal{L}_{\mathcal{S}}$-sentences
true in every substrate satisfying Axioms 1--8.
\end{definition}

\begin{theorem}[Completeness of $T_{\mathcal{S}}$]
The theory $T_{\mathcal{S}}$ is complete.
\end{theorem}

\begin{proof}[Sketch]
$T_{\mathcal{S}}$ is interpreted in a cohesive $\infty$-topos, whose internal logic is complete.
\end{proof}

\subsection{Definability}

\begin{definition}[Definable set]
A subset $X \subseteq \mathcal{O}$ is \emph{definable} if there exists a formula
$\varphi(x)$ such that


\[
X = \{ O \in \mathcal{O} \mid \mathcal{S} \models \varphi(O) \}.
\]


\end{definition}

\begin{theorem}[Definability of fixed points]
The set of fixed points


\[
\mathrm{Fix}(U) = \{ O \mid U(O) = O \}
\]


is definable in $\mathcal{L}_{\mathcal{S}}$.
\end{theorem}

\begin{theorem}[Definability of stability]
The set of stable configurations


\[
\mathrm{Stab}(U) = \{ O^\* \mid \forall \lambda \in \mathrm{Spec}(dU_{O^\*}),\ |\lambda| < 1 \}
\]


is definable.
\end{theorem}

\subsection{Compactness}

\begin{theorem}[Compactness]
If every finite subset of a set of substrate constraints is satisfiable,
then the whole set is satisfiable.
\end{theorem}

\begin{proof}[Sketch]
Follows from compactness of the internal logic of $\mathbf{H}$.
\end{proof}

\subsection{Ultraproducts of Substrates}

\begin{definition}[Ultraproduct]
Given substrates $\{\mathcal{S}_i\}_{i \in I}$ and an ultrafilter $\mathcal{U}$,
the ultraproduct is


\[
\prod_{\mathcal{U}} \mathcal{S}_i.
\]


\end{definition}

\begin{theorem}[Łoś's theorem for substrates]
For any formula $\varphi$,


\[
\prod_{\mathcal{U}} \mathcal{S}_i \models \varphi
\quad\Longleftrightarrow\quad
\{ i \in I \mid \mathcal{S}_i \models \varphi \} \in \mathcal{U}.
\]


\end{theorem}

\subsection{Saturation and Homogeneity}

\begin{definition}[Saturated substrate]
A substrate $\mathcal{S}$ is $\kappa$-saturated if every type over a set
of parameters of size $<\kappa$ is realized in $\mathcal{S}$.
\end{definition}

\begin{theorem}[Existence of saturated substrates]
For every cardinal $\kappa$, there exists a $\kappa$-saturated substrate
elementarily equivalent to any given substrate.
\end{theorem}

\begin{definition}[Homogeneous substrate]
A substrate is \emph{homogeneous} if any partial automorphism between
finite substructures extends to a full automorphism.
\end{definition}

\begin{theorem}[Saturated implies homogeneous]
Every saturated substrate is homogeneous.
\end{theorem}

\subsection{Elementary Embeddings}

\begin{definition}[Elementary embedding]
A morphism $f : \mathcal{S} \to \mathcal{S}'$ is \emph{elementary} if


\[
\mathcal{S} \models \varphi(a_1,\dots,a_n)
\quad\Longleftrightarrow\quad
\mathcal{S}' \models \varphi(f(a_1),\dots,f(a_n))
\]


for all formulas $\varphi$.
\end{definition}

\begin{theorem}[Characterization]
A substrate morphism is elementary iff it preserves:
\begin{itemize}
  \item update operators,
  \item adjacency,
  \item modal structure,
  \item BV--BRST cohomology,
  \item factorization homology.
\end{itemize}
\end{theorem}

\subsection{Classification by Stability Rank}

\begin{definition}[Stability rank]
The \emph{stability rank} of a substrate is the Morley rank of the definable
set of stable configurations.
\end{definition}

\begin{theorem}[Stability rank classification]
Substrates fall into exactly three model-theoretic classes:
\begin{itemize}
  \item \textbf{Stable}: Morley rank finite,
  \item \textbf{Simple}: Morley rank infinite but bounded,
  \item \textbf{Unstable}: Morley rank unbounded.
\end{itemize}
\end{theorem}
