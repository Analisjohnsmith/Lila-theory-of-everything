\[
D(\mathbf{H}) := \mathbf{Ch}(\mathbf{H})[\text{quasi-isos}^{-1}].
\]


\end{definition}

\begin{definition}[BV--BRST complex]
Let $\mathcal{F}$ denote the graded sheaf of fields, antifields, ghosts, and antighosts.
The BV bracket is a degree $+1$ Poisson bracket


\[
\{-,-\}_{BV} : \mathcal{F} \otimes \mathcal{F} \to \mathcal{F}[1].
