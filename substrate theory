\section{The Substrate}

\begin{definition}[Substrate]
A \emph{substrate} is a tuple


\[
\mathcal{S} = (V,E,\mathcal{H}_{\text{phys}},\mathcal{H}_{\text{sem}},\mathcal{H}_{\text{agent}})
\]


where
\begin{itemize}
  \item $V$ is a finite set of nodes, $|V| = N$,
  \item $E \subseteq V \times V$ is a set of edges,
  \item $\mathcal{H}_{\text{phys}} \cong \mathbb{C}^N$ is the physical state space,
  \item $\mathcal{H}_{\text{sem}} \cong \mathbb{R}^{kN}$ is the semantic state space,
  \item $\mathcal{H}_{\text{agent}} \cong \mathbb{R}^m$ is the agent state space.
\end{itemize}
A \emph{configuration} of the substrate is a triple


\[
O = (\psi,\mu,a) \in \mathcal{H}_{\text{phys}} \times \mathcal{H}_{\text{sem}} \times \mathcal{H}_{\text{agent}}.
\]


\end{definition}

\section{Update Operators}

\begin{definition}[Elementary operators]
Let $\mathcal{O}$ denote the configuration space. An \emph{elementary operator} is a map


\[
\Lambda, \Phi, \Xi, d\Omega, \mathrm{VOID} : \mathcal{O} \to \mathcal{O}.
\]


We define the \emph{global update} $U : \mathcal{O} \to \mathcal{O}$ by


\[
U := \mathrm{VOID} \circ d\Omega \circ \Xi \circ \Phi \circ \Lambda.
\]


The discrete-time evolution of the substrate is then


\[
O(t+1) = U(O(t)).
\]


\end{definition}

\subsection{Concrete finite model}

Fix $V = \{1,2,3\}$ and adjacency matrix


\[
A =
\begin{pmatrix}
0 & 1 & 0\\
1 & 0 & 1\\
0 & 1 & 0
\end{pmatrix}, \qquad
L = D - A =
\begin{pmatrix}
1 & -1 & 0\\
-1 & 2 & -1\\
0 & -1 & 1
\end{pmatrix}.
\]



\begin{definition}[Physical update $\Lambda_{\text{phys}}$]
Let $\psi \in \mathbb{C}^3$, $\Delta t > 0$, $\alpha \in \mathbb{R}$, and $V = \mathrm{diag}(V_1,V_2,V_3)$.
Define the Hamiltonian


\[
H := \alpha L + V,
\]


and the physical update


\[
\psi' = \psi - i \Delta t\, H \psi.
\]


\end{definition}

\begin{definition}[Semantic update $\Lambda_{\text{sem}}$]
Let $\mu \in \mathbb{R}^3$, and $\eta,\gamma \in \mathbb{R}$. Define


\[
\mu' = \mu + (\eta - 2\gamma) L \mu.
\]


\end{definition}

\begin{definition}[Agent update $\Lambda_{\text{agent}}$]
Let $a \in \mathbb{R}$, and define a perception map $p = P(\psi,\mu)$ (linear in $(\psi,\mu)$).
Given $w_a,w_p \in \mathbb{R}$ and $b \in \mathbb{R}$, set


\[
a' = w_a a + w_p p + b.
\]


\end{definition}

\begin{definition}[Combined $\Lambda$]
Define


\[
\Lambda(\psi,\mu,a) = (\psi',\mu',a')
\]


by applying the three updates above componentwise.
\end{definition}

\subsection{Cross-domain coupling $\Xi$}

\begin{definition}[Cross-domain coupling]
Let $g_i,h_i : \mathbb{R} \to \mathbb{R}$ be given. Define


\[
V_i' = V_i + g_i(a), \qquad F_i' = F_i + h_i(a),
\]


and let these updated quantities enter the next physical and semantic updates.
We denote the resulting map on configurations by $\Xi : \mathcal{O} \to \mathcal{O}$.
\end{definition}

\subsection{Continuity and pruning}

\begin{definition}[Continuity operator $d\Omega$]
Define $d\Omega : \mathcal{O} \to \mathcal{O}$ by


\[
\psi \leftarrow \frac{\psi}{\|\psi\|}, \qquad
\mu_i \leftarrow \mu_i + \lambda \sum_j A_{ij}(\mu_j - \mu_i),
\]


with $\lambda \in \mathbb{R}$.
\end{definition}

\begin{definition}[Pruning operator $\mathrm{VOID}$]
Given thresholds $\epsilon,\delta > 0$, define


\[
\psi_i \leftarrow 0 \ \text{if } |\psi_i| < \epsilon, \qquad
\mu_i \leftarrow 0 \ \text{if } |\mu_i| < \delta,
\]


and apply a clipping map to $a$.
\end{definition}

\section{Fixed Points and Stability}

\begin{definition}[Fixed point]
A configuration $O^\* \in \mathcal{O}$ is a \emph{fixed point} of the substrate if


\[
U(O^\*) = O^\*.
\]


\end{definition}

\begin{proposition}[Physical fixed points]
In the 3-node model with $H = L$, the physical fixed points satisfy


\[
H \psi^\* = 0.
\]


Hence


\[
\psi^\* \propto (1,1,1)^\top.
\]


\end{proposition}

\begin{proposition}[Semantic fixed points]
In the case $\eta - 2\gamma = 0$, the semantic update is the identity, and every $\mu$ is a fixed point. In the general case, fixed points satisfy


\[
L \mu^\* = 0,
\]


so $\mu^\* \propto (1,1,1)^\top.
\]


\end{proposition}

\begin{proposition}[Agent fixed point]
Let $a' = w_a a + w_p p$, with $|w_a| < 1$. For a fixed perception value $p^\*$, the unique fixed point is


\[
a^\* = \frac{w_p}{1 - w_a} p^\*.
\]


\end{proposition}

\begin{definition}[Jacobian]
Let $x \in \mathbb{R}^{10}$ be the real state vector corresponding to $(\psi,\mu,a)$.
The Jacobian of $U$ at a fixed point $x^\*$ is


\[
J = \left.\frac{\partial U}{\partial x}\right|_{x = x^\*}.
\]


\end{definition}

\begin{definition}[Stability]
A fixed point $x^\*$ is
\begin{itemize}
  \item \emph{linearly stable} if all eigenvalues of $J$ satisfy $|\lambda| < 1$,
  \item \emph{unstable} if some eigenvalue satisfies $|\lambda| > 1$,
  \item \emph{neutrally stable} if all eigenvalues satisfy $|\lambda| \le 1$ and at least one has $|\lambda| = 1$.
\end{itemize}
\end{definition}

