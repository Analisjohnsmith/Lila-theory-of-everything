\section{Synthetic Differential Geometry of the Substrate}

\subsection{Infinitesimal Objects}

\begin{definition}[Infinitesimal interval]
Let $D$ be the infinitesimal object satisfying


\[
D = \{ \varepsilon \in \mathbb{R} \mid \varepsilon^2 = 0 \}.
\]


\end{definition}

\begin{definition}[Infinitesimal extension]
For any object $X \in \mathbf{H}$, define its infinitesimal extension


\[
X^D := X^D = \mathrm{Map}(D,X).
\]


\end{definition}

\subsection{Synthetic Derivatives}

\begin{definition}[Synthetic derivative]
Let $f : X \to Y$ be a morphism in $\mathbf{H}$.
The \emph{synthetic derivative} of $f$ at $x \in X$ is the map


\[
df_x : T_x X \to T_{f(x)} Y
\]


induced by the naturality square


\[
\begin{tikzcd}
X^D \arrow{r}{f^D} \arrow{d} & Y^D \arrow{d} \\
X \arrow{r}{f} & Y.
\end{tikzcd}
\]


\end{definition}

\begin{definition}[Tangent bundle]
The tangent bundle of $X$ is


\[
TX := X^D.
\]


\end{definition}

