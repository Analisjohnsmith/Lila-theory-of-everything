$\mu_1>0,\ \mu_2>0,\ \mu_3>0$. Let $A$ be its global attractor. Then


\[
A = \bigcup_{i=1}^N \Gamma_i,
\]


where each $\Gamma_i$ is a closed orbit with CHE envelope, and $N$ is
finite.
\end{theorem}

\begin{proof}[Sketch]
Compactness of $X$ ensures existence of a global attractor $A$. The
oscillatory feedback $h$ enforces periodic structure; the destabilizing
feedback $k$ splits cycles, producing multiple distinct periodic orbits;
the stabilizing feedback $g$ prevents infinite proliferation, forcing
finiteness of the number of stable cycles. By the CHE Uniqueness
Theorem, each periodic orbit has a CHE envelope. Thus $A$ decomposes
into a finite union of CHE-shaped closed orbits.
\end{proof}

\section{The UCSO Monad}

\subsection*{Category of Closed Systems}

Let \textbf{ClosedSys} be the category whose objects are closed systems
$(X,F)$ and whose morphisms $\phi : (X,F) \to (Y,G)$ satisfy


\[
\phi \circ \Phi_F^t = \Phi_G^t \circ \phi
\]


for all $t$.

\subsection*{UCSO Functor and Monad}

\begin{definition}[UCSO Functor]
Define an endofunctor $U : \mathbf{ClosedSys} \to \mathbf{ClosedSys}$ by


\[
U(X,F) = (X, f + \mu_1 g + \mu_2 h + \mu_3 k),
\]


with $U(\phi) = \phi$ on morphisms.
\end{definition}

\begin{theorem}[UCSO Monad]
The functor $U$ admits a monad structure $(U,\eta,\mu)$ where:
\begin{itemize}
  \item $\eta_{(X,F)} : (X,F) \to U(X,F)$ is the identity on $X$,
  \item $\mu_{(X,F)} : U(U(X,F)) \to U(X,F)$ is the identity, since
        $U^2 = U$.
\end{itemize}
Thus $U$ is an idempotent monad on $\mathbf{ClosedSys}$.
\end{theorem}

\begin{proof}
The unit and multiplication satisfy the monad laws trivially because
both are identity maps at the level of objects and morphisms.
Idempotence follows from $U(U(X,F)) = U(X,F)$ by construction.
\end{proof}
\chapter{The Grand Unified Closed-System Theorem}

We now assemble the results of the previous chapters into a single,
unified statement that characterizes the long-term behavior of all
closed systems under the UCSO framework.

\begin{theorem}[Grand Unified Closed-System Theorem]
Let $(X,F)$ be a closed dynamical system on a compact state space $X$,
and let


\[
U(X,F) = (X, f + \mu_1 g + \mu_2 h + \mu_3 k)
\]


be its UCSO image, where $f,g,h,k$ are $C^1$ vector fields and
$\mu_i \ge 0$. Then:
\begin{enumerate}
  \item \textbf{Identity-pattern necessity.}
        For every $x\in X$, the omega-limit set $\omega(x)$ is nonempty,
        compact, and invariant.
  \item \textbf{CHE envelope uniqueness.}
        Any oscillatory envelope satisfying the closed-system constraints
        belongs to the CHE envelope class $\mathcal{E}_{CHE}$.
  \item \textbf{Mode exhaustion.}
        The long-term behavior of $U(X,F)$ falls into exactly one of the
        four canonical modes: equilibrium, resonance (CHE limit cycle),
        chaos, or multi-cycle.
  \item \textbf{Multi-cycle decomposition.}
        In the multi-cycle regime ($\mu_1>0,\ \mu_2>0,\ \mu_3>0$), the
        global attractor decomposes as a finite union of CHE-shaped
        closed orbits:
        

\[
        A = \bigcup_{i=1}^N \Gamma_i.
        \]


  \item \textbf{UCSO monad closure.}
        The UCSO defines an idempotent monad on $\mathbf{ClosedSys}$:
        

\[
        U(U(X,F)) = U(X,F),
        \]


        whose fixed points correspond exactly to the four canonical modes.
\end{enumerate}
\end{theorem}

\begin{proof}
Items (1)--(4) follow from the theorems established in Chapters 2 and 3.
Item (5) follows from the UCSO Monad Theorem and the mode exhaustion
result: the fixed points of the idempotent monad $U$ are precisely the
systems already in one of the four canonical modes.
\end{proof}

