class TOEFieldGenerator:
    def __init__(self, width=64, height=64):
        self.w, self.h = width, height

    def _sector_seed(self, sector_name, layer_id, params):
        vals = [layer_id]
        for v in params.values():
            if isinstance(v, (int, float)):
                vals.append(float(v))
            elif isinstance(v, (list, tuple)):
                vals.extend([float(x) for x in v[:3] if isinstance(x, (int, float))])
        mean_val = float(np.mean(vals)) if vals else 1.0
        std_val = float(np.std(vals)) + 1e-9
        return mean_val, std_val

    def _generate_symmetry_field(self, layer_id, params, rng):
        dim = params.get('dim', 3)
        group_order = params.get('group_order', 12)
        generator_norm = params.get('generator_norm', 1.0)
        w, h = self.w, self.h
        field = np.zeros((h, w))
        n_modes = dim + layer_id
        for mode in range(n_modes):
            kx = rng.rand() * (layer_id * 0.5) + 0.5
            ky = rng.rand() * (layer_id * 0.5) + 0.5
            phase = rng.rand() * 2 * np.pi
            yy, xx = np.ogrid[:h, :w]
            yy = yy / h; xx = xx / w
            weight = generator_norm * (group_order / 12.0) / (mode + 1)
            field += np.sin(xx * kx * 2 * np.pi + yy * ky * 2 * np.pi + phase) * weight
        field = (field - field.min()) / (field.max() - field.min() + 1e-9)
        return field

    def _generate_curvature_field(self, layer_id, params, rng):
        dim = params.get('dim', 4)
        ricci_scalar = params.get('ricci_scalar', 0.0)
        curvature_scale = params.get('curvature_scale', 0.5)
        w, h = self.w, self.h
        field = np.zeros((h, w))
        n_modes = dim + layer_id - 1
        for mode in range(n_modes):
            r = rng.rand()
            theta = rng.rand() * 2 * np.pi
            k = curvature_scale * (layer_id * 0.3) + 0.3
            yy, xx = np.ogrid[:h, :w]
            yy = yy / h; xx = xx / w
            dist = np.sqrt((xx - 0.5 + rng.rand()*0.2)**2 + (yy - 0.5 + rng.rand()*0.2)**2)
            phase = rng.rand() * 2 * np.pi
            weight = (1.0 + abs(ricci_scalar)) / (mode + 1)
            field += np.sin(k * dist * 10 + phase) * np.exp(-dist * 2) * weight
        field = (field - field.min()) / (field.max() - field.min() + 1e-9)
        return field

    def _generate_entropy_field(self, layer_id, params, rng):
        entropy_bits = params.get('entropy_bits', 4.5)
        w, h = self.w, self.h
        field = np.zeros((h, w))
        n_modes = layer_id + 2
        for mode in range(n_modes):
            cx, cy = rng.rand(2)
            sigma = 0.1 + 0.3 * rng.rand()
            yy, xx = np.ogrid[:h, :w]
            yy = yy / h; xx = xx / w
            gauss = np.exp(-((xx - cx)**2 + (yy - cy)**2) / (2 * sigma**2))
            weight = (entropy_bits / 4.5) / (mode + 1)
            field += gauss * weight
        noise = rng.randn(h, w) * 0.05 * (entropy_bits / 4.5)
        field += noise
        field = (field - field.min()) / (field.max() - field.min() + 1e-9)
        return field

    def _generate_interference_field(self, layer_id, params, rng):
        dim = params.get('dim', 3)
        w, h = self.w, self.h
        field = np.zeros((h, w))
        n_waves = min(3 + layer_id // 2, 30)
        for wave in range(n_waves):
            kx = rng.rand() * 4 + 1
            ky = rng.rand() * 4 + 1
            phase = rng.rand() * 2 * np.pi
            yy, xx = np.ogrid[:h, :w]
            yy = yy / h; xx = xx / w
            weight = (dim / 3.0) / (wave + 1) * (1.0 + 0.1 * layer_id)
            wave_interference = np.sin(xx * kx * 8 + yy * ky * 6 + phase)
            for sub in range(min(3, layer_id // 5)):
                sub_phase = rng.rand() * 2 * np.pi
                sub_kx = kx * (0.5 + rng.rand())
                sub_ky = ky * (0.5 + rng.rand())
                wave_interference += 0.3 * np.sin(xx * sub_kx * 8 + yy * sub_ky * 6 + sub_phase)
            field += wave_interference * weight
        field = (field - field.min()) / (field.max() - field.min() + 1e-9)
        return field

    def _topology_modulation(self, topology='sphere'):
        w, h = self.w, self.h
        yy, xx = np.ogrid[:h, :w]
        yy_n = yy / h; xx_n = xx / w

        if topology == 'sphere':
            r2 = (xx_n - 0.5)**2 + (yy_n - 0.5)**2
            mod = np.exp(-r2 * 6)
            mod = (mod - mod.min()) / (mod.max() - mod.min() + 1e-9)
        elif topology == 'torus':
            mod = (np.sin(xx_n * 2 * np.pi) * np.sin(yy_n * 2 * np.pi) + 1) / 2
        elif topology == 'cube':
            mod = 1.0 - 0.3 * np.abs(xx_n - 0.5) * np.abs(yy_n - 0.5) * 4
            mod = (mod - mod.min()) / (mod.max() - mod.min() + 1e-9)
        elif topology == 'cylinder':
            mod = (np.sin(xx_n * 2 * np.pi) + 1) / 2
            mod = mod * (1.0 - 0.2 * np.abs(yy_n - 0.5) * 2)
            mod = (mod - mod.min()) / (mod.max() - mod.min() + 1e-9)
        elif topology == 'hyperbolic':
            r = np.sqrt((xx_n - 0.5)**2 + (yy_n - 0.5)**2)
            mod = np.sinh(r * 3) / np.sinh(1.5)
            mod = np.clip(mod, 0, 1)
            mod = (mod - mod.min()) / (mod.max() - mod.min() + 1e-9)
        elif topology == 'mesh':
            mod = np.ones((h, w))
        else:
            mod = np.ones((h, w))
        return mod

    def generate(self, sector, layer_id, params=None, topology='sphere', rng=None):
        if rng is None:
            mean_val, std_val = self._sector_seed(sector, layer_id, params or {})
            rng = np.random.RandomState(int(abs(mean_val * 1000 + layer_id)) % 10000)

        if sector == 'SYMMETRY':
            field = self._generate_symmetry_field(layer_id, params or {}, rng)
        elif sector == 'CURVATURE':
            field = self._generate_curvature_field(layer_id, params or {}, rng)
        elif sector == 'ENTROPY':
            field = self._generate_entropy_field(layer_id, params or {}, rng)
        elif sector == 'INTERFERENCE':
            field = self._generate_interference_field(layer_id, params or {}, rng)
        else:
            field = rng.rand(self.h, self.w)

        mod = self._topology_modulation(topology)
        field = field * mod
        fn = field - field.min()
        denom = field.max() - field.min() + 1e-9
        field = fn / denom
        return field

    def fourier(self, field):
        F = np.fft.fftshift(np.fft.fft2(field))
        Fm = np.abs(F)
        logF = np.log(Fm + 1e-9)
        return (logF - logF.min()) / (logF.max() - logF.min() + 1e-9), Fm

    def invariants(self, field, thr=0.1):
        h, w = field.shape
        cy, cx = h // 2, w // 2
        y, x = np.ogrid[:h, :w]
        r = np.sqrt((x - cx)**2 + (y - cy)**2)
        rad = [float(field[(r >= rad) & (r < rad + 1)].mean())
               for rad in range(min(cy, cx)) if (r >= rad).any()]
        rad = np.array(rad)
        fft_r = np.abs(np.fft.fft(rad))
        peaks = np.where(fft_r > thr * fft_r.max())[0]
        return {'radial': rad, 'fft': fft_r, 'symmetry': len(peaks), 'peaks': peaks.tolist()}

