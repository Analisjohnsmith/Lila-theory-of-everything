    g11 = metric_field[..., 1, 1]
    g22 = metric_field[..., 2, 2]
    g33 = metric_field[..., 3, 3]

    if not (np.all(g00 < 0) and np.all(g11 > 0) and np.all(g22 > 0) and np.all(g33 > 0)):
