@dataclass
class SDGEvent:
    event_type: str
    data: Dict[str, Any]


@dataclass
class SDGNode:
    unified: UnifiedField
    codex: Dict[str, Any]
    events: List[SDGEvent]


class StructuralDynamicsGraph:
    def __init__(self):
        self.nodes: List[SDGNode] = []
        self.edges: List[List[int]] = []

    def add(self, unified: UnifiedField, codex: Dict[str, Any]) -> int:
        node = SDGNode(unified=unified, codex=codex, events=[])
        self.nodes.append(node)
        self.edges.append([])
        return len(self.nodes) - 1

    def connect(self, a: int, b: int):
        self.edges[a].append(b)
        self.edges[b].append(a)

    def apply_event(self, idx: int, event: SDGEvent):
        self.nodes[idx].events.append(event)

    def summary(self) -> Dict[str, Any]:
        return {
            "nodes": len(self.nodes),
            "edges": sum(len(e) for e in self.edges),
            "events": sum(len(n.events) for n in self.nodes)
        }


