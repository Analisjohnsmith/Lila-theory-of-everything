}

pub fn ricci_flow_step(m: &Vec<Vec<Vec<Vec<f64>>>>, dx: f64, dy: f64, dt: f64)
    -> Vec<Vec<Vec<Vec<f64>>>> {
    let g = compute_christoffel(m,dx,dy); let r = compute_riemann(m,&g,dx,dy);
    let ric = compute_ricci_tensor(&r);
