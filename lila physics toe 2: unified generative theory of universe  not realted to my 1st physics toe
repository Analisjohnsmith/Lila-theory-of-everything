}

pub fn structural_problem_dispatch(class: ProblemClass, metric: &Array4<f64>, curvature: &Array2<f64>, field: &Array2<f64>, causal: &Array2<f64>, modes: &Vec<Array2<f64>>) -> serde_json::Value {
    match class {
