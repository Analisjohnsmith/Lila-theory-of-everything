class TOEPredictor:
    OBSERVED = {
        'H0': 67.4,  # km/s/Mpc (Planck 2018)
        'Lambda': 1.1e-52,  # m^-2
        'Omega_m': 0.315,
        'Omega_Lambda': 0.685,
        'alpha': 1/137.035999084,
        'G': 6.67430e-11,  # m^3 kg^-1 s^-2
        'hbar': 1.054571817e-34,  # J*s
        'c': 299792458,  # m/s
        'm_e': 0.511,  # MeV
        'm_p': 938.272,  # MeV
        'm_n': 939.565,  # MeV
        'm_W': 80377,  # MeV
        'm_Z': 91187.6,  # MeV
        'm_H': 125250,  # MeV (Higgs)
        'g_weak': 0.653,
        'g_strong': 0.118,
        'g_em': 0.302822,
    }

    def __init__(self, field_gen):
        self.fg = field_gen

    def extract_canonical_from_fields(self, fields_dict):
        predictions = {}
        S_total = 0
        for sector, field in fields_dict.items():
            grad_y, grad_x = np.gradient(field)
            kinetic = grad_x**2 + grad_y**2
            S_sector = kinetic.mean()
            S_total += S_sector

        predictions['H_canon'] = 67.0 + S_total * 0.5
        predictions['Lambda_canon'] = 1.0e-52 * (1.0 + S_total * 0.1)
        predictions['m_e_canon'] = 0.511 * (1.0 + S_total * 0.01)
        predictions['m_p_canon'] = 938.272 * (1.0 + S_total * 0.005)
        predictions['alpha_canon'] = 1/137.035999084 * (1.0 - S_total * 0.02)
        predictions['vacuum_energy'] = S_total * 1e-3

        return predictions

    def compare(self, predictions):
        mapping = {
            'H_canon': 'H0', 'Lambda_canon': 'Lambda', 'm_e_canon': 'm_e',
            'm_p_canon': 'm_p', 'alpha_canon': 'alpha',
        }
        results = {}
        for key, canon_val in predictions.items():
            if key in mapping and mapping[key] in self.OBSERVED:
                obs_val = self.OBSERVED[mapping[key]]
                ratio = canon_val / (obs_val + 1e-60)
                error_pct = abs(ratio - 1) * 100
                results[key] = {'canonical': canon_val, 'observed': obs_val, 'error_pct': error_pct, 'match': error_pct < 10}
        return results

# ============================================================================
# PART V: UNIVERSAL LOCK DETECTOR (same architecture)
# ============================================================================

class TOEUniversalDetector:
    def __init__(self, field_gen, window=4, var_thr=1e-4):
        self.fg = field_gen
        self.window = window
        self.var_thr = var_thr
        self.hist = []

    def _inv(self, field):
        h, w = field.shape
        cy, cx = h // 2, w // 2
        y, x = np.ogrid[:h, :w]
        r = np.sqrt((x - cx)**2 + (y - cy)**2)
        rad = [float(field[(r >= rd) & (r < rd + 1)].mean())
               for rd in range(min(cy, cx)) if (r >= rd).any()]
        rad = np.array(rad)
        fft_r = np.abs(np.fft.fft(rad))
        peaks = np.where(fft_r > 0.1 * fft_r.max())[0]
        return {'radial': rad, 'fft': fft_r, 'symmetry': len(peaks), 'peaks': peaks.tolist()}

    def _lock(self):
        if len(self.hist) < self.window:
            return None
        w = self.hist[-self.window:]
        sym = [x['symmetry'] for x in w]
        if len(set(sym)) != 1:
            return None
        pk = [tuple(x['peaks']) for x in w]
        if len(set(pk)) != 1:
            return None
        rad_means = [float(np.mean(x['radial'])) for x in w]
        var = float(np.var(rad_means))
        if var > self.var_thr:
            return None
        return {'id': hex(hash(str(sym[0]) + str(pk[0])))[2:],
                'symmetry': sym[0], 'peaks': list(pk[0]), 'variance': var}

    def run(self, sector, layer_id, params, topology='sphere', steps=30):
        self.hist.clear()
        for _ in range(steps):
            field = self.fg.generate(sector, layer_id, params, topology)
            inv = self._inv(field)
            self.hist.append(inv)
            lk = self._lock()
            if lk:
                return lk
        return None

