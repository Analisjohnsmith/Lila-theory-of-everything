        return {"has_curvature": False}
    R = uf.curvature
    return {
        "has_curvature": True,
        "min_R": float(R.min()),
        "max_R": float(R.max()),
        "bounded": bool((np.abs(R) < 1e6).all())
    }


def rule_causal_consistency(uf: UnifiedField) -> Dict[str, Any]:
    if uf.causal is None:
        return {"has_causal": False}
    cones = uf.causal.cones
    return {
        "has_causal": True,
        "cone_angle_range": (float(cones[..., 0].min()), float(cones[..., 0].max())),
        "ctc_admissible": uf.causal.metadata.get("ctc_admissible", False)
    }


class CodexEngine:
    def __init__(self):
        self.codex = StructuralCodex()
        self.codex.add_rule(CodexRule("metric_signature", rule_metric_signature))
        self.codex.add_rule(CodexRule("curvature_bounds", rule_curvature_bounds))
        self.codex.add_rule(CodexRule("causal_consistency", rule_causal_consistency))

    def evaluate(self, uf: UnifiedField) -> Dict[str, Any]:
        return self.codex.evaluate(uf)


# -----------------------------
# 15. Problem Language (PLang)
# -----------------------------

@dataclass
class PLangSpec:
    problem_class: ProblemClass
    params: Dict[str, Any]
    raw_text: str


class PLangParser:
    def parse(self, text: str) -> PLangSpec:
        t = text.lower()
        if "metric" in t or "geometry" in t or "space" in t:
            pc = ProblemClass.GEOMETRIC_STRUCTURE
        elif "curvature" in t or "gravity" in t:
            pc = ProblemClass.CURVATURE_DISTRIBUTION
        elif "mode" in t or "field" in t:
            pc = ProblemClass.FIELD_CONFIGURATION
        elif "causal" in t or "cone" in t or "time" in t:
            pc = ProblemClass.CAUSAL_STRUCTURE
        elif "interference" in t or "interaction" in t:
            pc = ProblemClass.INTERFERENCE_PATTERN
        elif "eigen" in t or "spectrum" in t:
            pc = ProblemClass.MODE_FAMILY
        elif "evolve" in t or "pde" in t or "dynamic" in t:
            pc = ProblemClass.PDE_EVOLUTION
        else:
            pc = ProblemClass.GEOMETRIC_STRUCTURE

        params: Dict[str, Any] = {}
        for w in t.split():
            if w.startswith("freq="):
                params["freq"] = float(w.split("=")[1])
            elif w.startswith("steps="):
                params["steps"] = int(w.split("=")[1])
            elif w.startswith("dt="):
                params["dt"] = float(w.split("=")[1])
            elif w.startswith("k="):
                params["k"] = int(w.split("=")[1])

        return PLangSpec(problem_class=pc, params=params, raw_text=text)


