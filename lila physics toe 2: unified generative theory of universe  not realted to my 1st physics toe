    solution: Optional[Dict[str, Any]] = None


class PersonaKernel:
    def __init__(self,
                 api: SpacetimeAPI,
                 pg: ProblemGraph,
                 sdg: StructuralDynamicsGraph):
        self.api = api
        self.pg = pg
        self.sdg = sdg
        self.state = PersonaState()
        self.unifier = UnificationEngine()
        self.codex_engine = CodexEngine()
        self.see = SolutionExtractionEngine()

    def build_structural_state(self,
                               spec: PLangSpec,
                               **kwargs) -> StructuralState:
        merged = {**kwargs, **spec.params}
        grid_x = merged.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = merged.get("grid_y", np.linspace(-1, 1, 128))

        metric = self.api.metric(grid_x=grid_x, grid_y=grid_y)

        curvature = None
        modes = None
        causal = None
        pde_history = None

        if spec.problem_class == ProblemClass.CURVATURE_DISTRIBUTION:
            curvature = self.api.curvature(grid_x=grid_x, grid_y=grid_y)
        if spec.problem_class == ProblemClass.MODE_FAMILY:
            modes = self.api.modes(grid_x=grid_x, grid_y=grid_y,
                                   k=merged.get("k", 6))
        if spec.problem_class == ProblemClass.CAUSAL_STRUCTURE:
            causal = self.api.causal(grid_x=grid_x, grid_y=grid_y)
        if spec.problem_class == ProblemClass.PDE_EVOLUTION:
            pde_history = self.api.evolve(grid_x=grid_x,
                                          grid_y=grid_y,
                                          steps=merged.get("steps", 10),
                                          dt=merged.get("dt", 0.05),
                                          freq=merged.get("freq", 1.0))

        return StructuralState(
            metric=metric,
            curvature=curvature,
            modes=modes,
            causal=causal,
            pde_history=pde_history,
            metadata={"problem_class": spec.problem_class.value}
        )

    def process(self, text: str, **kwargs) -> Dict[str, Any]:
        parser = PLangParser()
        spec = parser.parse(text)

        structural = self.build_structural_state(spec, **kwargs)
        unified = self.unifier.unify(structural)
        codex_results = self.codex_engine.evaluate(unified)

        pg_id = self.pg.add(spec, unified, codex_results)
        sdg_id = self.sdg.add(unified, codex_results)
        self.sdg.apply_event(sdg_id, SDGEvent("create", {"spec": spec.raw_text}))

        sol = self.see.extract(sdg_id, self.sdg)

        self.state.spec = spec
        self.state.structural = structural
        self.state.unified = unified
        self.state.solution = sol.summary

        return {
            "pg_id": pg_id,
            "sdg_id": sdg_id,
            "solution": sol.summary,
            "stable": sol.stable,
            "codex": codex_results
        }


