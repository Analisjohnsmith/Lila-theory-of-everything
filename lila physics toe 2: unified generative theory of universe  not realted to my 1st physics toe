def run_sweep(topos=None, batch_size=15, window=4, var_thr=1e-4, width=64, height=64):
    if topos is None:
        topos = ['sphere', 'torus', 'cube', 'cylinder', 'hyperbolic', 'mesh']

    fg = TOEFieldGenerator(width, height)
    det = TOEUniversalDetector(fg, window=window, var_thr=var_thr)
    layers = TOESectors.get_all()
    layer_keys = list(layers.keys())
    results = []

    for bi in range(0, len(layer_keys), batch_size):
        batch_keys = layer_keys[bi:bi + batch_size]
        t0 = time.time()
        for key in batch_keys:
            entry = layers[key]
            sector = entry['sector']
            lid = entry['layer']
            params = entry['params']
            for topo in topos:
                det.hist.clear()
                u = det.run(sector, lid, params, topology=topo, steps=30)
                if u:
                    u['layer_key'] = key
                    u['sector'] = sector
                    u['layer'] = lid
                    u['topo'] = topo
                    u['name'] = entry['name']
                    results.append(u)

        by_sig = {}
        for r in results:
            sig = (r['symmetry'], tuple(r['peaks']))
            by_sig.setdefault(sig, []).append(r)

        t = time.time() - t0
        batch_num = bi // batch_size + 1
        sys_processed = bi + len(batch_keys)
        print(f"[{t:.0f}s] batch {batch_num}: {len(results)} total, {len(by_sig)} distinct after {sys_processed} layer-domains")
        sys.stdout.flush()

    print(f"\n=== FINAL: {len(results)} universals, {len(by_sig)} distinct ===")
    for (sym, peaks), entries in sorted(by_sig.items(), key=lambda x: -len(x[1])):
        ex = [f"{e['name'][:25]}/{e['topo'][:4]}" for e in entries[:4]]
        pk = list(peaks)[:6]
        print(f"  sym={sym:2d} peaks={pk} n={len(entries):3d}: {', '.join(ex)}")

    return results, by_sig


def run_prediction():
    fg = TOEFieldGenerator(64, 64)
    predictor = TOEPredictor(fg)
    renorm = VacuumRenormalization(fg)
    sectors_done = {}
    for sector in ['SYMMETRY', 'CURVATURE', 'ENTROPY', 'INTERFERENCE']:
        combined = np.zeros((64, 64))
        sec = getattr(TOESectors, sector)
        for lid, entry in sec.items():
            field = fg.generate(sector, lid, entry['params'])
            combined += field / len(sec)
        sectors_done[sector] = combined / (combined.max() - combined.min() + 1e-9)

    predictions = predictor.extract_canonical_from_fields(sectors_done)
    Lambda_base = predictions['Lambda_canon']
    Lambda_renorm, Delta_E = renorm.renormalized_lambda(Lambda_base)
    predictions['Lambda_canon'] = Lambda_renorm

    comparison = predictor.compare(predictions)

    print("\n=== TOE PREDICTIONS vs OBSERVED (with vacuum renormalization) ===")
    print(f"  Delta_E_vac           = {Delta_E:.4f}  (from interference+entropy high-freq)")
    print(f"  Lambda before renorm  = {Lambda_base:.6e}")
    print(f"  Lambda after  renorm  = {Lambda_renorm:.6e}")
    print(f"  Lambda observed       = {predictor.OBSERVED['Lambda']:.6e}")
    for key, res in sorted(comparison.items()):
        status = "MATCH" if res['match'] else "MISMATCH"
        print(f"  {key:20s}: canon={res['canonical']:.6e}  obs={res['observed']:.6e}  error={res['error_pct']:.2f}%  [{status}]")

    overall_match = all(r['match'] for r in comparison.values())
    print(f"\n  OVERALL: {'VIABLE' if overall_match else 'PARTIAL'} ({sum(1 for r in comparison.values() if r['match'])}/{
          len(comparison)} predictions match)")
    return comparison


