pub fn general_metric_tensor(x: f64, y: f64, t: f64) -> Array2<f64> {
    let mut g = Array2::<f64>::zeros((4, 4));
    g[(0, 0)] = -1.0 - 0.1 * t;
    g[(1, 1)] = 1.0 + 0.1 * x;
    g[(2, 2)] = 1.0 - 0.05 * y;
    g[(3, 3)] = 1.0 + 0.02 * t;
    g[(0, 1)] = 0.01 * x * t;
