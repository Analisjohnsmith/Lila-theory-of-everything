@dataclass
class SDGEvent:
    event_type: str
    data: Dict[str, Any]

@dataclass
class SDGNode:
    unified: UnifiedField
    codex: Dict[str, Any]
    events: List[SDGEvent]

class StructuralDynamicsGraph:
    def __init__(self):
        self.nodes: List[SDGNode] = []
        self.edges: List[List[int]] = []
    
    def add(self, unified: UnifiedField, codex: Dict[str, Any]) -> int:
        node = SDGNode(unified=unified, codex=codex, events=[])
        self.nodes.append(node)
        self.edges.append([])
        return len(self.nodes) - 1
    
    def connect(self, a: int, b: int):
        self.edges[a].append(b)
        self.edges[b].append(a)
    
    def apply_event(self, idx: int, event: SDGEvent):
        self.nodes[idx].events.append(event)
    
    def summary(self) -> Dict[str, Any]:
        return {
            "nodes": len(self.nodes),
            "edges": sum(len(e) for e in self.edges),
            "events": sum(len(n.events) for n in self.nodes)
        }

# ============================================
# 17. SOLUTION EXTRACTION ENGINE
# ============================================

@dataclass
class Solution:
    node_id: int
    invariants: Dict[str, Any]
    stable: bool
    summary: Dict[str, Any]

class SolutionExtractionEngine:
    def extract_invariants(self, unified: UnifiedField, codex: Dict[str, Any]) -> Dict[str, Any]:
        inv = {}
        ms = codex.get("metric_signature", {})
        inv["lorentzian"] = ms.get("valid_lorentzian", False)
        cb = codex.get("curvature_bounds", {})
        inv["curvature_bounded"] = cb.get("bounded", True)
        cc = codex.get("causal_consistency", {})
        inv["ctc_free"] = not cc.get("ctc_admissible", False)
        gp = codex.get("gauge_presence", {})
        inv["has_gauge"] = gp.get("has_gauge", False)
        return inv
    
    def is_stable(self, invariants: Dict[str, Any]) -> bool:
        return all(invariants.values())
    
    def summarize(self, unified: UnifiedField, invariants: Dict[str, Any]) -> Dict[str, Any]:
        return {"metric_shape": unified.metric.shape, "invariants": invariants}
    
    def extract(self, idx: int, sdg: StructuralDynamicsGraph) -> Solution:
        node = sdg.nodes[idx]
        inv = self.extract_invariants(node.unified, node.codex)
        stable = self.is_stable(inv)
        return Solution(node_id=idx, invariants=inv, stable=stable, summary=self.summarize(node.unified, inv))

# ============================================
# 18. PERSONA KERNEL
# ============================================

@dataclass
class PersonaState:
    spec: Optional[PLangSpec] = None
    structural: Optional[StructuralState] = None
    unified: Optional[UnifiedField] = None
    solution: Optional[Dict[str, Any]] = None

class PersonaKernel:
    def __init__(self, api: 'SpacetimeAPI', pg: ProblemGraph, sdg: StructuralDynamicsGraph):
        self.api = api
        self.pg = pg
        self.sdg = sdg
        self.state = PersonaState()
        self.see = SolutionExtractionEngine()
    
    def process(self, text: str, **kwargs) -> Dict[str, Any]:
        parser = PLangParser()
        spec = parser.parse(text)
        
        # Solve structural problem
        structural = self.api.engine.solve_structural_problem(spec.problem_class, **kwargs, **spec.params)
        
        # Build unified state
        builder = StructuralStateBuilder()
        state = builder.build(
            metric=self.api.metric(**kwargs),
            curvature=structural if isinstance(structural, CurvatureField) else None,
            modes=structural if isinstance(structural, list) and all(isinstance(m, FieldMode) for m in structural) else None,
            causal=structural if isinstance(structural, CausalStructure) else None,
            interaction=structural if isinstance(structural, InteractionField) else None,
            pde_history=structural if isinstance(structural, list) and all(isinstance(m, np.ndarray) for m in structural) else None
        )
        
        # Handle gauge if requested
        gauge = None
        if "gauge" in text.lower() or "u1" in text.lower() or "su" in text.lower():
            group = "U1"
            if "su2" in text.lower(): group = "SU2"
            if "su3" in text.lower(): group = "SU3"
            metric_field = self.api.metric(**kwargs)
            gauge = self.api.gauge(metric_field=metric_field, group=group)
        
        # Unify
        ue = UnificationEngine()
        unified = ue.unify(state, gauge=gauge)
        
        # Codex evaluation
        codex = self.api.codex()
        codex_results = codex.evaluate(unified)
        
        # Add to graphs
        pg_id = self.pg.add(spec, unified, codex_results)
        sdg_id = self.sdg.add(unified, codex_results)
        self.sdg.apply_event(sdg_id, SDGEvent("create", {"spec": spec.raw_text}))
        
        # Extract solution
        sol = self.see.extract(sdg_id, self.sdg)
        
        # Update persona state
        self.state.spec = spec
        self.state.structural = state
        self.state.unified = unified
        self.state.solution = sol.summary
        
        return {
            "pg_id": pg_id,
            "sdg_id": sdg_id,
            "solution": sol.summary,
            "stable": sol.stable,
            "codex": codex_results
        }

