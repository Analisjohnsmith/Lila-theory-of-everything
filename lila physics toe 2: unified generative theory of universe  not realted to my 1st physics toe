    let mut nm = m.clone();
    for j in 1..ny.saturating_sub(1) { for i in 1..nx.saturating_sub(1) {
        for mu in 0..4 { for nu in 0..4 { nm[j][i][mu][nu] = m[j][i][mu][nu] - 2.0*dt*ric[j][i][mu][nu]; }}
