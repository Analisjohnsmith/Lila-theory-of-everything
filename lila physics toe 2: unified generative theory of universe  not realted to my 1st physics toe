# 19. SPACETIME API
# ============================================

class SpacetimeAPI:
    def __init__(self, engine: SpacetimeEngine):
        self.engine = engine
    
    def metric(self, **kwargs) -> np.ndarray:
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        t = kwargs.get("t", 0.0)
        return self.engine.generate_metric_field(grid_x, grid_y, t)
    
    def field(self, **kwargs):
        metric = self.metric(**kwargs)
        freq = kwargs.get("freq", 1.0)
        return self.engine.generate_field_mode(metric, freq)
    
    def curvature(self, **kwargs):
        metric = self.metric(**kwargs)
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        return self.engine.compute_scalar_curvature(metric, grid_x, grid_y)
    
    def causal(self, **kwargs):
        metric = self.metric(**kwargs)
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        return self.engine.solve_structural_problem(ProblemClass.CAUSAL_STRUCTURE, grid_x=grid_x, grid_y=grid_y)
    
    def modes(self, **kwargs):
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        k = kwargs.get("k", 6)
        return self.engine.generate_eigenmodes(grid_x, grid_y, k=k)
    
    def evolve(self, **kwargs):
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        steps = kwargs.get("steps", 10)
        dt = kwargs.get("dt", 0.05)
        freq = kwargs.get("freq", 1.0)
        metric = self.metric(grid_x=grid_x, grid_y=grid_y)
        initial = self.engine.generate_field_mode(metric, freq).amplitude.real
        return self.engine.evolve_wave_equation(initial, grid_x, grid_y, steps, dt)
    
    def interference(self, **kwargs):
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        freq = kwargs.get("freq", 1.0)
        metric = self.metric(grid_x=grid_x, grid_y=grid_y)
        mode1 = self.engine.generate_field_mode(metric, freq)
        mode2 = self.engine.generate_field_mode(metric, freq * 1.5)
        return InteractionField(amplitude=mode1.amplitude + mode2.amplitude, metric=metric)
    
    def gauge(self, **kwargs):
        metric_field = kwargs.get("metric_field", self.metric(**kwargs))
        group = kwargs.get("group", "U1")
        strength = kwargs.get("strength", 0.1)
        if group.upper() == "U1":
            return generate_u1_field(metric_field, strength)
        if group.upper() == "SU2":
            return generate_su2_field(metric_field, strength)
        if group.upper() == "SU3":
            return generate_su3_field(metric_field, strength)
        raise ValueError(f"Unknown gauge group: {group}")
    
    def renormalize(self, state: StructuralState, **kwargs):
        steps = kwargs.get("steps", 5)
        step_factor = kwargs.get("step_factor", 1.1)
        renorm = Renormalizer(step_factor=step_factor)
        return renorm.run(state, steps=steps)
    
    def collapse(self, obj: Any, **kwargs):
        mode = kwargs.get("mode", "stabilize")
        op = CollapseOperator(mode=mode)
        return op.collapse(obj)
    
    def codex(self) -> StructuralCodex:
        codex = StructuralCodex()
        codex.add_rule(CodexRule("metric_signature", rule_metric_signature))
        codex.add_rule(CodexRule("curvature_bounds", rule_curvature_bounds))
        codex.add_rule(CodexRule("causal_consistency", rule_causal_consistency))
        codex.add_rule(CodexRule("gauge_presence", rule_gauge_presence))
        return codex
    
    def evaluate(self, unified: UnifiedField) -> Dict[str, Any]:
        return self.codex().evaluate(unified)

