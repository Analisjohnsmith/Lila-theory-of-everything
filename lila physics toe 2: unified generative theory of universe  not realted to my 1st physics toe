# PART III: TOE EVOLUTION ENGINE — du/dt = F(u) = delta_A/delta_u
# ============================================================================

class TOEEvolution:
    def __init__(self, field_gen, seed=1337):
        self.fg = field_gen
        self.rng = np.random.default_rng(seed)
        self.state = None
        self.history = []

    def _lagrangian_density(self, field, sector):
        grad_y, grad_x = np.gradient(field)
        kinetic = grad_x**2 + grad_y**2
        if sector == 'SYMMETRY':
            potential = 0.5 * field**2
        elif sector == 'CURVATURE':
            laplacian = np.gradient(grad_x, axis=1)[0] + np.gradient(grad_y, axis=0)[0]
            potential = 0.5 * laplacian**2
        elif sector == 'ENTROPY':
            p = field / (field.sum() + 1e-9)
            potential = -np.sum(p * np.log(p + 1e-9), axis=0)
        elif sector == 'INTERFERENCE':
            potential = 0.25 * (field**2 - 1)**2
        else:
            potential = 0.5 * field**2
        return (kinetic.mean() + potential.mean()) / 2.0

    def _generative_engine(self, field, sector):
        delta_A_delta_u = np.gradient(np.gradient(field, axis=0), axis=0) + \
                          np.gradient(np.gradient(field, axis=1), axis=1)
        if sector == 'INTERFERENCE':
            delta_A_delta_u -= field * (field**2 - 1)
        elif sector == 'CURVATURE':
            delta_A_delta_u -= field
        else:
            delta_A_delta_u -= field
        return delta_A_delta_u

    def evolve(self, field, sector, dt=0.01, steps=100):
        traj = [field.copy()]
        for _ in range(steps):
            du = self._generative_engine(field, sector)
            field = field + du * dt
            field = np.nan_to_num(field, 0.0)
            fn = field - field.min()
            denom = field.max() - field.min() + 1e-9
            field = fn / denom
            traj.append(field.copy())
        return np.array(traj)

    def unified_action(self, field, sector):
        L = self._lagrangian_density(field, sector)
        return L * self.fg.w * self.fg.h

    def simulate(self, sector, layer_id, params, topology='sphere', steps=100):
        field = self.fg.generate(sector, layer_id, params, topology)
        traj = self.evolve(field, sector, dt=0.01, steps=steps)
        final = traj[-1]
        S = self.unified_action(final, sector)
        return {'trajectory': traj, 'final_field': final, 'action': S}

