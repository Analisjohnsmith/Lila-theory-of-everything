@dataclass
class CurvatureAtom:
    """Diagonal metric generator."""
    params: Dict[str, float]
    
    def generate(self, x: np.ndarray, y: np.ndarray, t: float = 0.0) -> np.ndarray:
        kappa = self.params.get("kappa", 0.1)
        lamb = self.params.get("lambda", -0.05)
        sigma = self.params.get("sigma", 0.02)
        
        X, Y = np.meshgrid(x, y, indexing='ij')
        r2 = X**2 + Y**2
        
        g00 = -1.0 + kappa * r2
        g11 = 1.0 + lamb * np.exp(-r2 / (2*sigma**2))
        g22 = 1.0 + lamb * np.exp(-r2 / (2*sigma**2))
        g33 = 1.0 + lamb * np.exp(-r2 / (2*sigma**2))
        
        metric = np.zeros((*X.shape, 4, 4))
        metric[..., 0, 0] = g00
        metric[..., 1, 1] = g11
        metric[..., 2, 2] = g22
        metric[..., 3, 3] = g33
        return metric

