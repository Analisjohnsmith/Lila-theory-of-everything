class VacuumRenormalization:
    """
    Renormalizes vacuum energy E_0 using high-frequency content from
    interference (layers 25-50) and entropy (layers 7-12) sectors.
    Does NOT touch particle mass, fine-structure, or Hubble sectors.
    """
    def __init__(self, field_gen):
        self.fg = field_gen

    def compute_delta_vac(self):
        w, h = self.fg.w, self.fg.h
        hi_int = TOESectors.INTERFERENCE
        hi_ent = TOESectors.ENTROPY

        int_energy = 0.0
        for lid in range(25, 51):
            entry = hi_int[lid]
            field = self.fg.generate('INTERFERENCE', lid, entry['params'])
            F = np.fft.fftshift(np.fft.fft2(field))
            Fm = np.abs(F)
            Fm = Fm / (Fm.max() + 1e-9)
            hi_freq = Fm[h//4:3*h//4, w//4:3*w//4].mean()
            int_energy += hi_freq * (lid / 50.0)
        int_energy /= max(1, 51 - 25)

        ent_energy = 0.0
        for lid in range(7, 13):
            entry = hi_ent[lid]
            field = self.fg.generate('ENTROPY', lid, entry['params'])
            grad_y, grad_x = np.gradient(field)
            grad_norm = np.sqrt(grad_x**2 + grad_y**2).mean()
            ent_energy += grad_norm * (lid / 12.0)
        ent_energy /= max(1, 13 - 7)

        Delta_E_vac = (int_energy * 0.3 + ent_energy * 0.7)
        return Delta_E_vac

    def renormalized_lambda(self, Lambda_base):
        Delta_E = self.compute_delta_vac()
        renorm_strength = 4.0 / (1.0 + 10.0 * Delta_E)
        Lambda_renorm = Lambda_base * (1.0 + renorm_strength * Delta_E)
        return Lambda_renorm, Delta_E

