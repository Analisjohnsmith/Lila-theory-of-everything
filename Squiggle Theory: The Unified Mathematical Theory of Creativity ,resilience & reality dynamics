\section{The Sovereign Law (Core Resilience Law)}
\begin{law}[Resilience Fractal Law]
\label{law:resilience}
For any system undergoing an infinite sequence of collapse–repair cycles, the following condition must hold for persistence or growth:
\[
\boxed{\prod_{k=1}^{\infty} \frac{R_k}{C_k} \ge 1}
\]
where $C_k$ is the magnitude of collapse at cycle $k$ and $R_k$ the magnitude of repair.
\end{law}

\subsection*{Alternative Forms}
\begin{align}
\text{Log form:}&\quad \lim_{n\to\infty}\sum_{k=1}^n \ln\!\left(\frac{R_k}{C_k}\right) \ge 0 \\
\text{Time-averaged:}&\quad \lim_{T\to\infty}\frac{1}{T}\int_0^T \ln\!\left(\frac{R(t)}{C(t)}\right)dt \ge 0 \\
\text{Operator form:}&\quad \lim_{n\to\infty}\langle \hat{\rho}^n \rangle \ge 1,\qquad \hat{\rho} = \hat{R}\circ\hat{C}^{-1}
\end{align}

