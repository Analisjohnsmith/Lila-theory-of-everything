% Spectral Functoriality Theorem
% Admissible operators act functorially on canonical and dual bases.

\textbf{Theorem (Spectral Functoriality Theorem).}
\quad
\text{Let }
\mathfrak{A}
\text{ be the admissible operator algebra acting on }
\mathscr{S}_{\mathrm{adm}},
\text{and let }
\mathcal{C}_k,\mathcal{C}^\ast_k
\text{ be the canonical and dual bases.}
\]





\[
\text{Define the spectral functor }
\mathcal{F} : \mathfrak{A} \to \mathrm{End}(\mathcal{A})
\qquad
\text{by}
\qquad
\mathcal{F}(A)(\mathcal{C}_k)
=
A(\mathcal{C}_k),
\]





\[
\text{where }
\mathcal{A}
=
\operatorname{span}\{\mathcal{C}_1,\mathcal{C}_3,\mathcal{C}_5,\mathcal{C}_{5'},\mathcal{C}_7\}.
\]





\[
\text{Then }
\mathcal{F}
\text{ is a functor:}
\qquad
\mathcal{F}(I) = I,
\qquad
\mathcal{F}(A_1 A_2) = \mathcal{F}(A_1)\mathcal{F}(A_2),
\qquad
\mathcal{F}(A^\dagger) = \mathcal{F}(A)^\dagger.
\]





\[
\text{Thus admissible operators preserve the canonical algebraic structure functorially.}
\]



% Proof

\textbf{Proof.}
\quad
\text{Let }
A_1,A_2 \in \mathfrak{A}.
\text{ By the Canonical Algebra Theorem,}
\quad
A_i(\mathcal{C}_k)
\in
\mathcal{A}.
\]





\[
\text{Thus }
\mathcal{F}(A_i)
\text{ is well-defined as an endomorphism of }
\mathcal{A}.
\]





\[
\text{Functoriality of identity:}
\qquad
\mathcal{F}(I)(\mathcal{C}_k)
=
I(\mathcal{C}_k)
=
\mathcal{C}_k.
\]





\[
\text{Functoriality of composition:}
\qquad
\mathcal{F}(A_1 A_2)(\mathcal{C}_k)
=
A_1(A_2(\mathcal{C}_k))
=
\mathcal{F}(A_1)\mathcal{F}(A_2)(\mathcal{C}_k).
\]





\[
\text{Functoriality of adjoint:}
\qquad
\langle \mathcal{F}(A)(\mathcal{C}_k), \mathcal{C}^\ast_j \rangle_{\mathrm{spec}}
=
a_{jk},
\]





\[
\langle \mathcal{C}_k , \mathcal{F}(A^\dagger)(\mathcal{C}^\ast_j) \rangle_{\mathrm{spec}}
=
a_{jk},
\]





\[
\text{so }
\mathcal{F}(A^\dagger)
=
\mathcal{F}(A)^\dagger.
\]





\[
\Box
\]



% Corollary: Admissible operators form a functorial category over the canonical algebra

\textbf{Corollary (Functorial Category).}
\quad
\text{The admissible operator algebra }
\mathfrak{A}
\text{ forms a functorial category whose objects are canonical components and whose morphisms are admissible operators.}
