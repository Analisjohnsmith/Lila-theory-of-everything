\sum_{m}
a_{mk}\,
\langle \mathcal{C}_m , \mathcal{C}^\ast_j \rangle_{\mathrm{spec}}
=
a_{jk}.
\]





\[
\text{By definition of the adjoint,}
\qquad
\langle \mathcal{C}_k , A^\dagger(\mathcal{C}^\ast_j) \rangle_{\mathrm{spec}}
=
a_{jk}.
\]





\[
\text{Expand }
A^\dagger(\mathcal{C}^\ast_j)
=
\sum_{m}
b_{jm}\,\mathcal{C}^\ast_m.
\]





\[
\text{Then}
\qquad
\langle \mathcal{C}_k , A^\dagger(\mathcal{C}^\ast_j) \rangle_{\mathrm{spec}}
=
\sum_{m}
b_{jm}\,
\langle \mathcal{C}_k , \mathcal{C}^\ast_m \rangle_{\mathrm{spec}}
=
b_{jk}.
\]





\[
\text{Thus}
\qquad
b_{jk}
=
a_{jk},
\quad
\text{and by conjugate symmetry of the inner product,}
\quad
b_{jk}
=
\overline{a_{kj}}.
\]





\[
\text{Hence }
A^\dagger
\text{ is represented by the conjugate transpose of } (a_{jk}).
\]





\[
\Box
\]



% Corollary: Canonical and dual bases diagonalize self-adjoint operators

\textbf{Corollary (Self-Adjoint Diagonalization).}
\quad
\text{If }
A = A^\dagger,
\text{ then }
A
\text{ is diagonalizable in the canonical basis,}
\text{and the dual basis provides the corresponding eigenfunctionals.}
