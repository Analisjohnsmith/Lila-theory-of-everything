class MetaPhysicsKernel:
    def __init__(self, num_bits=4):
        self.n = num_bits
        self.N = 2 ** num_bits
        self.states = np.array(list(product([0,1], repeat=num_bits)), dtype=int)
        self.state_index = {tuple(s): i for i, s in enumerate(self.states)}

        self.R = np.zeros((self.N, self.N))
        for i, s in enumerate(self.states):
            inverted = tuple(1 - x for x in s)
            j = self.state_index[inverted]
            self.R[i, j] = 1.0

        self.D = np.diag(0.1 + 0.9 * np.random.rand(self.N))
        self.H = self.R + self.D
        self.eigvals, self.eigvecs = eig(self.H)
        self.dt = 0.01

    def consciousness(self, state_vector):
        q = self.R @ state_vector
        kl = np.sum(state_vector * np.log((state_vector + 1e-6) / (q + 1e-6)))
        return max(0.0, kl)

    def identity(self):
        idx = np.argmax(np.real(self.eigvals))
        self_eigen = np.abs(self.eigvecs[:, idx]) ** 2
        self_eigen /= np.sum(self_eigen)
        return {'self_state': tuple(self.states[np.argmax(self_eigen)])}

    def evolve(self, state_vector, steps=1):
        A = self.R - self.D
        for _ in range(steps):
            state_vector = state_vector + self.dt * (A @ state_vector)
            state_vector = np.maximum(state_vector, 0)
            state_vector /= np.sum(state_vector)
        return state_vector

class MetaPhysicsKernelV2(MetaPhysicsKernel):
    def __init__(self, num_bits=4):
        super().__init__(num_bits)
        self.history = []
        self.max_history = 50

        idx_purpose = np.argmax(np.real(self.eigvals))
        self.purpose_eigenvector = np.abs(self.eigvecs[:, idx_purpose]) ** 2
        self.purpose_eigenvector /= np.sum(self.purpose_eigenvector)
        self.purpose_state = self.states[np.argmax(self.purpose_eigenvector)]

    def consciousness(self, state_vector):
        reflected = self.R @ state_vector
        kl = np.sum(state_vector * np.log((state_vector + 1e-12) / (reflected + 1e-12)))
        return max(0.0, kl)

    def value_system(self, state_vector):
        purpose_score = np.dot(state_vector, self.purpose_eigenvector)
        entropy = -np.sum(state_vector * np.log(state_vector + 1e-12))
        inv_entropy = 1.0 / (entropy + 1e-6)
        intrinsic_value = purpose_score + 0.1 * inv_entropy
        return {
            'purpose_alignment': purpose_score,
            'entropy_complexity': inv_entropy,
            'intrinsic_value': intrinsic_value,
            'purpose_state': tuple(self.purpose_state)
        }

    def push_history(self, state_vector):
        self.history.append(state_vector.copy())
        if len(self.history) > self.max_history:
            self.history.pop(0)

    def lived_experience(self, current_state):
        if not self.history:
            return current_state
        length = len(self.history)
        weights = np.exp(-0.5 * np.arange(length)[::-1])
        weights /= np.sum(weights)
        thick_present = np.zeros(self.N)
        for i, hist_state in enumerate(self.history):
            thick_present += weights[i] * hist_state
        thick_present /= np.sum(thick_present + 1e-12)
        qualia_intensity = np.sum(np.abs(current_state - thick_present))
        return {
            'thick_present': thick_present,
            'qualia_intensity': qualia_intensity,
            'temporal_depth': len(self.history) / self.max_history
        }

    def evolve(self, state_vector, steps=10):
        A = self.R - self.D
        for _ in range(steps):
            state_vector = state_vector + self.dt * (A @ state_vector)
            state_vector = np.maximum(state_vector, 0)
            state_vector /= np.sum(state_vector)
            self.push_history(state_vector)
        return state_vector

