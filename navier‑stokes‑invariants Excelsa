def append_run_to_yaml(filename, run_entry):
    Path(filename).parent.mkdir(parents=True, exist_ok=True)
    if Path(filename).exists():
        with open(filename) as f:
            reg = yaml.safe_load(f) or {}
    else:
        reg = {"NS_Campaign_registry": {"runs": []}}
    root = reg.setdefault("NS_Campaign_registry", {})
    root.setdefault("runs", []).append(run_entry)
    with open(filename, "w") as f:
        yaml.safe_dump(reg, f, sort_keys=False)


def _scope_present(filename, scope):
    if not (filename and Path(filename).exists()):
        return False
    with open(filename) as f:
        reg = yaml.safe_load(f) or {}
    for run in reg.get("NS_Campaign_registry", {}).get("runs", []):
        if run.get("scope") == scope:
            return True
    return False


