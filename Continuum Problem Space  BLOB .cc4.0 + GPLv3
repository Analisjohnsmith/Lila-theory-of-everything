class HELLA:
    """Minimal embedded HELLA package manager for packaging all code."""
    
    def __init__(self, registry_path: str = "./hella_registry"):
        self.registry_path = Path(registry_path)
        self.packages_path = self.registry_path / "packages"
        self.metadata_path = self.registry_path / "metadata"
        self.packages_path.mkdir(parents=True, exist_ok=True)
        self.metadata_path.mkdir(parents=True, exist_ok=True)
        self.registry: Dict[str, Dict[str, Any]] = {}
        self._load_registry()
    
    def _load_registry(self):
        registry_file = self.registry_path / "registry.json"
        if registry_file.exists():
            try:
                with open(registry_file) as f:
                    self.registry = json.load(f)
            except:
                self.registry = {}
    
    def _save_registry(self):
        with open(self.registry_path / "registry.json", "w") as f:
            json.dump(self.registry, f, indent=2)
    
    def create_package(self, name: str, version: str, author: str, description: str,
                       files: List[str], dependencies: List[str] = None,
                       license: str = "CC BY-NC 4.0") -> bool:
        """Create a package from files."""
        
        # Create tarball
        temp_dir = Path(tempfile.mkdtemp())
        package_files = []
        
        for file_path in files:
            src = Path(file_path)
            if src.exists():
                if src.is_file():
                    dest = temp_dir / src.name
                    shutil.copy2(src, dest)
                    package_files.append(src.name)
                elif src.is_dir():
                    for f in src.rglob("*"):
                        if f.is_file():
                            rel_path = f.relative_to(src)
                            dest = temp_dir / rel_path
                            dest.parent.mkdir(parents=True, exist_ok=True)
                            shutil.copy2(f, dest)
                            package_files.append(str(rel_path))
        
        # Create tar
        tar_path = self.packages_path / f"{name}-{version}.tar"
        with tarfile.open(tar_path, "w") as tar:
            tar.add(temp_dir, arcname=".")
        
        # Compress
        with open(tar_path, "rb") as f:
            tar_data = f.read()
        compressed = gzip.compress(tar_data, compresslevel=9)
        
        with open(self.packages_path / f"{name}-{version}.tar.gz", "wb") as f:
            f.write(compressed)
        
        tar_path.unlink()
        shutil.rmtree(temp_dir)
        
        # Save metadata
        metadata = {
            "name": name, "version": version, "author": author,
            "description": description, "dependencies": dependencies or [],
            "files": package_files, "license": license,
            "hash": hashlib.sha256(compressed).hexdigest(),
            "size": len(compressed),
        }
        
        with open(self.metadata_path / f"{name}-{version}.json", "w") as f:
            json.dump(metadata, f, indent=2)
        
        # Update registry
        if name not in self.registry:
            self.registry[name] = {}
        self.registry[name][version] = metadata
        self._save_registry()
        
        print(f"✅ Packaged: {name}-{version} ({len(package_files)} files)")
        return True

