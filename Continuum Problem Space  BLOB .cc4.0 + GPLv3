                    if j > 0: adj[idx, idx-W] = 1
                    if j < H-1: adj[idx, idx+W] = 1
                    if i > 0: adj[idx, idx-1] = 1
                    if i < W-1: adj[idx, idx+1] = 1
            result["adjacency"] = adj
        elif problem_class == ProblemClass.MODE_FAMILY:
