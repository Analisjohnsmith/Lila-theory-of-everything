def numerical_derivative(field: np.ndarray, axis: int, dx: float) -> np.ndarray:
    der = np.zeros_like(field)
    if axis == 0:
        der[1:-1, :] = (field[2:, :] - field[:-2, :]) / (2 * dx)
    else:
        der[:, 1:-1] = (field[:, 2:] - field[:, :-2]) / (2 * dx)
    return der

def scalar_curvature(metric: np.ndarray, dx: float, dy: float) -> np.ndarray:
    H, W, _, _ = metric.shape
    curv = np.zeros((H, W))
    for j in range(1, H-1):
        for i in range(1, W-1):
            g11 = metric[j, i, 1, 1]
            g22 = metric[j, i, 2, 2]
            if g11 == 0 or g22 == 0:
                continue
            d2g11 = (metric[j, i+1, 1, 1] - 2*g11 + metric[j, i-1, 1, 1]) / (dx*dx)
            d2g22 = (metric[j+1, i, 2, 2] - 2*g22 + metric[j-1, i, 2, 2]) / (dy*dy)
            curv[j, i] = d2g11/g11 + d2g22/g22
    return curv

class UniversalSolver:
    def __init__(self, atom: Optional[CurvatureAtom] = None):
        self.atom = atom or CurvatureAtom()
    
    def solve(self, problem_class: ProblemClass, grid_x: np.ndarray, grid_y: np.ndarray,
              **kwargs) -> Dict[str, Any]:
        t = kwargs.get("t", 0.0)
        freq = kwargs.get("freq", 1.0)
