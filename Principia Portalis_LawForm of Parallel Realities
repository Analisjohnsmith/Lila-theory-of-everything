    """
    def __init__(self, points, curvature=None, entropy=None):
        """
        points : numpy.ndarray of shape (N, dim)  – sampled points on boundary.
        curvature : float or None – if None, estimated from points.
        entropy : float or None – if None, computed from point cloud.
        """
