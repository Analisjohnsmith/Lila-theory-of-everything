    def _estimate_curvature(self):
        """Estimate mean curvature via local covariance (crude but illustrative)."""
        # Use k‑nearest neighbours to compute local tangent space
        k = min(10, self.N-1)
        tree = cKDTree(self.points)
        curvatures = []
        for i, p in enumerate(self.points):
            idx = tree.query(p, k=k+1)[1][1:]  # exclude self
            neighbors = self.points[idx]
            cov = np.cov(neighbors.T)
            eigvals = np.linalg.eigvalsh(cov)
            # approximate curvature by spread ratio (largest / smallest)
            ratio = eigvals[-1] / (eigvals[0] + EPS)
            curvatures.append(ratio)
        return float(np.mean(curvatures))

    def _compute_entropy(self):
        """Entropy = -log(mean nearest‑neighbour distance)."""
        tree = cKDTree(self.points)
        dists, _ = tree.query(self.points, k=2)  # nearest neighbour distance
        mean_dist = np.mean(dists[:, 1])  # exclude self
        return -np.log(mean_dist + EPS)

    def __repr__(self):
        return f"Boundary(N={self.N}, dim={self.dim}, curvature={self.curvature:.3f}, entropy={self.entropy:.3f})"


